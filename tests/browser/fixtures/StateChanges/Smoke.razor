@using BlazorBlueprint.Primitives.SignaturePad
@using BlazorBlueprint.Primitives.Gantt
@using BlazorBlueprint.Primitives.Pivot
<h1>Component state regression fixture</h1>
<DateRangeState />
<section id="list">
<input aria-label="Before list" />
<BbListBox TValue="string" Label="Probe list" Options="options" />
<button id="after-list">After list</button>
</section>
<section id="signature">
<BbSignature @ref="signature" Value="typed" ValueChanged="value => signatureKind = value?.Kind.ToString()" />
<button @onclick="Restore">Restore strokes</button>
<button @onclick="ReadStrokes">Read strokes</button>
<p id="stroke-count">@strokeCount</p><p id="restore-count">@restoreCount</p>
<p id="signature-kind">@signatureKind</p>
</section>
<section id="invalid-gantt">
<button @onclick="() => invalid = !invalid">Toggle invalid data</button>
<BbGantt TItem="Job" Data="@(invalid ? badJobs : jobs)" IdSelector="j => j.Id" TextSelector="j => j.Id"
 StartSelector="j => j.Start" EndSelector="j => j.End" ShowToolbar="false" />
</section>
<section id="working-gantt">
<button @onclick="() => nonWorking = [DayOfWeek.Monday]">Change nonworking days</button>
<BbGantt @ref="gantt" TItem="Job" Data="jobs" IdSelector="j => j.Id" TextSelector="j => j.Id"
 StartSelector="j => j.Start" EndSelector="j => j.End" ShowToolbar="false" NonWorkingDays="nonWorking" Zoom="GanttZoom.Day" />
</section>
<section id="pivot">
<button @onclick="ChangeRegion">Change pivot parent</button>
<BbPivotDataGrid TItem="Sale" Data="sales" Totals="PivotTotals.None">
<Rows><BbPivotField TItem="Sale" Title="Region" Value="_ => region" /><BbPivotField TItem="Sale" Title="City" Value="s => s.City" /></Rows>
<Values><BbPivotValue TItem="Sale" Title="Amount" Value="s => s.Amount" /></Values>
</BbPivotDataGrid>
</section>
<section id="keyboard-controls">
<BbCheckbox aria-label="Probe checkbox" />
<BbSlider />
<button id="after-controls">After controls</button>
</section>
<section id="chart-callback">
<button @onclick="() => listen = true">Enable chart handler</button>
<button @onclick="() => listen = false">Disable chart handler</button>
<button @onclick="() => useAlternate = !useAlternate">Replace chart handler</button>
<p id="chart-listening">@listen</p><p id="chart-alternate">@useAlternate</p><p id="chart-clicks">@chartClicks</p>
<BbMapChart Data="mapRows" Height="300px" OnDataPointClick="@(listen ? EventCallback.Factory.Create<ChartClickEventArgs>(this, useAlternate ? CountAlternateClick : CountChartClick) : default)">
<BbMap CountryKey="Country" DataKey="Visitors" />
</BbMapChart>
</section>
<section id="upload">
<BbFileUpload @bind-Files="files" />
<button @onclick="() => files = null">Reset files to null</button>
<button @onclick="() => files = []">Reset files to empty</button>
<p id="file-count">@(files is null ? "null" : files.Count.ToString())</p>
</section>
<section id="uncontrolled-upload">
<BbFileUpload />
<button @onclick="() => unrelatedRenders++">Unrelated render</button>
<p id="unrelated-renders">@unrelatedRenders</p>
</section>
<section id="multiselect-dialog">
<button @onclick="() => pickerDialogOpen = true">Open picker dialog</button>
<p id="picker-dialog-open">@pickerDialogOpen</p><p id="picker-values">@string.Join(",", pickerValues ?? [])</p>
<BbDialog @bind-Open="pickerDialogOpen">
<BbDialogContent>
<BbDialogHeader><BbDialogTitle>Picker dialog</BbDialogTitle></BbDialogHeader>
<BbMultiSelect TValue="string" AriaLabel="Picker" Options="options" @bind-Values="pickerValues" />
</BbDialogContent>
</BbDialog>
</section>
<section id="trigger-labels">
<label for="snack-trigger">Snack</label>
<BbCombobox TValue="string" Options="options" @bind-Value="snack" TriggerId="snack-trigger" TriggerAttributes="snackAttributes" IsInvalid="true" />
<label for="snacks-trigger">Snacks</label>
<BbMultiSelect TValue="string" Options="options" @bind-Values="snacks" TriggerId="snacks-trigger" />
</section>
<section id="overlays">
<BbPopover>
<BbPopoverTrigger><BbButton>Open popover</BbButton></BbPopoverTrigger>
<BbPopoverContent><p>Popover body</p></BbPopoverContent>
</BbPopover>
<BbSelect TValue="string" AriaLabel="Fruit" Options="fruits" @bind-Value="fruit" Placeholder="Pick a fruit" />
<BbDropdownMenu>
<BbDropdownMenuTrigger AsChild="false">Open menu</BbDropdownMenuTrigger>
<BbDropdownMenuContent><BbDropdownMenuItem>Profile</BbDropdownMenuItem></BbDropdownMenuContent>
</BbDropdownMenu>
</section>
<BbPortalHost />
@code {
    private string? fruit;
    private readonly SelectOption<string>[] fruits = [new("apple", "Apple"), new("pear", "Pear")];
    private bool pickerDialogOpen;
    private IEnumerable<string>? pickerValues;
    private string? snack;
    private IEnumerable<string>? snacks;
    private readonly Dictionary<string, object> snackAttributes = new() { ["data-testid"] = "snack" };
    private int unrelatedRenders;
    private IReadOnlyList<FileUploadItem>? files;
    private bool listen;
    private int chartClicks;
    private bool useAlternate;
    private void CountAlternateClick(ChartClickEventArgs e) => chartClicks += 10;
    private void CountChartClick(ChartClickEventArgs e) => chartClicks++;
    private readonly object[] mapRows = [new { Country = "US", Visitors = 5 }];
    private readonly SelectOption<string>[] options = [new("a", "Alpha"), new("b", "Beta"), new("c", "Charlie")];
    private BbSignature? signature;
    private readonly SignatureValue typed = new() { Kind = SignatureKind.Typed, Text = "Saved name" };
    private int strokeCount = -1;
    private int restoreCount;
    private string? signatureKind;
    private async Task Restore()
    {
        strokeCount = -1;
        await signature!.SetStrokesAsync([new SignatureStroke([new(10, 10, 0), new(80, 50, 20)])]);
        restoreCount++;
    }
    private async Task ReadStrokes() { strokeCount = (await signature!.GetStrokesAsync()).Count; }
    private BbGantt<Job>? gantt;
    private IReadOnlyCollection<DayOfWeek> nonWorking = [DayOfWeek.Saturday, DayOfWeek.Sunday];
    private readonly Job[] jobs = [new("Task", new(2026, 9, 21, 0, 0, 0, TimeSpan.Zero), new(2026, 9, 28, 0, 0, 0, TimeSpan.Zero))];
    private bool invalid = true;
    private Job[] badJobs => [jobs[0], jobs[0]];
    private string region = "North";
    private void ChangeRegion() => region = region == "North" ? "South" : "North";
    private readonly Sale[] sales = [new("City", 10)];
    public record Job(string Id, DateTimeOffset Start, DateTimeOffset End);
    public record Sale(string City, decimal Amount);
}
