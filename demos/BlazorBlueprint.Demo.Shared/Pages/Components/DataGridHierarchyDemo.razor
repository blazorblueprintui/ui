@page "/components/datagrid-hierarchy"
@using BlazorBlueprint.Primitives.Utilities

<PageTitle>Hierarchical DataGrid - Blazor Blueprint</PageTitle>

<div class="space-y-8 max-w-7xl">
    <div class="space-y-4">
        <h1 class="text-4xl font-bold tracking-tight">Hierarchical DataGrid</h1>
        <p class="text-xl text-muted-foreground">
            Display hierarchical tree data within the DataGrid using a flat-row rendering approach,
            with expand/collapse, depth-based indentation, per-level sorting, and child pagination.
        </p>
    </div>

    <!-- ── Nested Data (Continents → Countries) ───────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Nested Data</h2>
            <p class="text-sm text-muted-foreground">
                Uses <code class="bg-muted px-1 py-0.5 rounded">ChildrenSelector</code> to display
                continent → country hierarchy with sorting and child pagination.
                Click a column header to sort, or <kbd class="bg-muted px-1 py-0.5 rounded text-xs">Ctrl</kbd>+click to multi-sort.
            </p>
        </div>
        <BbDataGrid TData="MedalEntry" Items="@continents"
                    ChildrenSelector="@(c => c.Children)"
                    ItemValueSelector="@(c => c.Name)"
                    ChildPageSize="5">
            <Columns>
                <BbDataGridHierarchyColumn TData="MedalEntry" TProp="string" Property="@(c => c.Name)" Title="Name" Sortable />
                <BbDataGridPropertyColumn TData="MedalEntry" TProp="int" Property="@(c => c.Gold)" Title="Gold" Sortable />
                <BbDataGridPropertyColumn TData="MedalEntry" TProp="int" Property="@(c => c.Silver)" Title="Silver" Sortable />
                <BbDataGridPropertyColumn TData="MedalEntry" TProp="int" Property="@(c => c.Bronze)" Title="Bronze" Sortable />
                <BbDataGridPropertyColumn TData="MedalEntry" TProp="int" Property="@(c => c.Total)" Title="Total" Sortable />
            </Columns>
        </BbDataGrid>
        <CodeBlock Source="Components/DataGridHierarchy/nested.txt" />
    </div>

    <!-- ── Self-Referencing Data (Org Chart) ──────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Self-Referencing Data (Org Chart)</h2>
            <p class="text-sm text-muted-foreground">
                Uses <code class="bg-muted px-1 py-0.5 rounded">ParentValueSelector</code> with
                <code class="bg-muted px-1 py-0.5 rounded">DefaultExpandDepth="1"</code> to show an
                org chart from flat data with parent ID references. Combined with a
                <code class="bg-muted px-1 py-0.5 rounded">BbFilterBuilder</code> for advanced filtering.
                Columns are <code class="bg-muted px-1 py-0.5 rounded">Reorderable</code> — drag column headers to rearrange.
            </p>
        </div>
        <div class="flex items-center gap-4">
            <BbFilterBuilder @bind-Filter="orgFilter"
                             Fields="@orgFields"
                             OnFilterChanged="HandleOrgFilterChanged"
                             MaxDepth="2"
                             Compact="true"
                             Class="flex-1" />
            <div class="flex items-center gap-2 shrink-0">
                <label class="text-sm text-muted-foreground whitespace-nowrap">Filter mode:</label>
                <BbSelect TValue="HierarchyFilterMode"
                          Value="@orgFilterMode"
                          ValueChanged="@(v => { orgFilterMode = v; })"
                          Options="@hierarchyFilterModeOptions"
                          Class="w-52" />
            </div>
        </div>
        <BbDataGrid TData="Employee" Items="@employees"
                    ParentValueSelector="@(e => e.ReportsToId)"
                    ItemValueSelector="@(e => e.Id)"
                    ItemFilter="@orgFilterPredicate"
                    HierarchyFilterMode="@orgFilterMode"
                    DefaultExpandDepth="1"
                    ChildPageSize="5"
                    ShowExpandAll="true"
                    Reorderable="true">
            <Columns>
                <BbDataGridHierarchyColumn TData="Employee" TProp="string" Property="@(e => e.Name)" Title="Name" Sortable>
                    <CellTemplate>
                        <div class="flex items-center gap-2">
                            <BbAvatar Size="AvatarSize.Small">
                                @if (context.Item.AvatarUrl != null)
                                {
                                    <BbAvatarImage Source="@context.Item.AvatarUrl" Alt="@context.Item.Name" />
                                }
                                <BbAvatarFallback>@GetInitials(context.Item.Name)</BbAvatarFallback>
                            </BbAvatar>
                            <span class="truncate">@context.Value</span>
                        </div>
                    </CellTemplate>
                </BbDataGridHierarchyColumn>
                <BbDataGridPropertyColumn TData="Employee" TProp="string" Property="@(e => e.JobTitle)" Title="Job Title" />
                <BbDataGridPropertyColumn TData="Employee" TProp="string" Property="@(e => e.Department)" Title="Department" Sortable />
                <BbDataGridPropertyColumn TData="Employee" TProp="string" Property="@(e => e.Location)" Title="Location" />
            </Columns>
        </BbDataGrid>
        <CodeBlock Source="Components/DataGridHierarchy/self-referencing.txt" />
    </div>

    <!-- ── Self-Referencing Data with Column Filters ─────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Self-Referencing Data with Column Filters</h2>
            <p class="text-sm text-muted-foreground">
                The same org chart data using per-column <code class="bg-muted px-1 py-0.5 rounded">Filterable</code>
                filters instead of the <code class="bg-muted px-1 py-0.5 rounded">BbFilterBuilder</code>.
                Hover a column header to reveal its filter icon, then click to open a filter popover.
                Department and Location use <code class="bg-muted px-1 py-0.5 rounded">FilterType="FilterFieldType.Enum"</code>
                with predefined options.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <label class="text-sm text-muted-foreground whitespace-nowrap">Filter mode:</label>
            <BbSelect TValue="HierarchyFilterMode"
                      Value="@columnFilterMode"
                      ValueChanged="@(v => { columnFilterMode = v; })"
                      Options="@hierarchyFilterModeOptions"
                      Class="w-52" />
        </div>
        <BbDataGrid TData="Employee" Items="@employees"
                    ParentValueSelector="@(e => e.ReportsToId)"
                    ItemValueSelector="@(e => e.Id)"
                    HierarchyFilterMode="@columnFilterMode"
                    DefaultExpandDepth="1"
                    ChildPageSize="5"
                    ShowExpandAll="true"
                    Reorderable="true">
            <Columns>
                <BbDataGridHierarchyColumn TData="Employee" TProp="string" Property="@(e => e.Name)" Title="Name" Sortable Filterable>
                    <CellTemplate>
                        <div class="flex items-center gap-2">
                            <BbAvatar Size="AvatarSize.Small">
                                @if (context.Item.AvatarUrl != null)
                                {
                                    <BbAvatarImage Source="@context.Item.AvatarUrl" Alt="@context.Item.Name" />
                                }
                                <BbAvatarFallback>@GetInitials(context.Item.Name)</BbAvatarFallback>
                            </BbAvatar>
                            <span class="truncate">@context.Value</span>
                        </div>
                    </CellTemplate>
                </BbDataGridHierarchyColumn>
                <BbDataGridPropertyColumn TData="Employee" TProp="string" Property="@(e => e.JobTitle)" Title="Job Title" Sortable Filterable />
                <BbDataGridPropertyColumn TData="Employee" TProp="string" Property="@(e => e.Department)" Title="Department" Sortable Filterable
                    FilterType="FilterFieldType.Enum"
                    FilterOptions="@(departments.Select(d => new SelectOption<string>(d, d)))" />
                <BbDataGridPropertyColumn TData="Employee" TProp="string" Property="@(e => e.Location)" Title="Location" Sortable Filterable
                    FilterType="FilterFieldType.Enum"
                    FilterOptions="@(locations.Order().Select(l => new SelectOption<string>(l, l)))" />
            </Columns>
        </BbDataGrid>
        <CodeBlock Source="Components/DataGridHierarchy/self-referencing-column-filters.txt" />
    </div>

    <!-- ── Lazy Loading ───────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Lazy Loading</h2>
            <p class="text-sm text-muted-foreground">
                Uses <code class="bg-muted px-1 py-0.5 rounded">LoadChildren</code> to fetch children
                on demand. Expand a department to trigger a simulated async load.
            </p>
        </div>
        <BbDataGrid TData="Department" Items="@rootDepartments"
                    ChildrenSelector="@(_ => null)"
                    ItemValueSelector="@(d => d.Id)"
                    HasChildrenPredicate="@(d => d.HasSubDepartments)"
                    LoadChildren="@LoadDepartmentChildrenAsync">
            <Columns>
                <BbDataGridHierarchyColumn TData="Department" TProp="string" Property="@(d => d.Name)" Title="Department" Sortable />
                <BbDataGridPropertyColumn TData="Department" TProp="int" Property="@(d => d.EmployeeCount)" Title="Employees" />
                <BbDataGridPropertyColumn TData="Department" TProp="string" Property="@(d => d.Head)" Title="Head" />
            </Columns>
        </BbDataGrid>
        <CodeBlock Source="Components/DataGridHierarchy/lazy-loading.txt" />
    </div>

    <!-- ── File Explorer ────────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">File Explorer</h2>
            <p class="text-sm text-muted-foreground">
                A file-explorer-style tree with icons, file sizes, and dates.
                Uses <code class="bg-muted px-1 py-0.5 rounded">HierarchySelectionMode.Cascade</code>
                to cascade selection to children — selecting a folder selects all its contents.
                Parents show an indeterminate state when partially selected.
                All columns are sortable, <code class="bg-muted px-1 py-0.5 rounded">Reorderable</code>, and <code class="bg-muted px-1 py-0.5 rounded">Resizable</code>.
            </p>
        </div>
        <BbDataGrid TData="FileEntry" Items="@fileTree"
                    ChildrenSelector="@(f => f.Children)"
                    ItemValueSelector="@(f => f.Id)"
                    SelectionMode="DataTableSelectionMode.Multiple"
                    HierarchySelectionMode="HierarchySelectionMode.Cascade"
                    SelectedItemsChanged="@((IReadOnlyCollection<FileEntry> items) => { selectedFiles = items; })"
                    DefaultExpandDepth="1"
                    ShowExpandAll="true"
                    ShowPagination="false"
                    Reorderable="true"
                    Resizable="true">
            <Columns>
                <BbDataGridSelectColumn TData="FileEntry" />
                <BbDataGridHierarchyColumn TData="FileEntry" TProp="string" Property="@(f => f.Name)" Title="Name" Sortable>
                    <CellTemplate>
                        <div class="flex items-center gap-2">
                            <LucideIcon Name="@GetFileIcon(context.Item)"
                                       Class="@ClassNames.cn("w-4 h-4 shrink-0", context.Item.IsFolder ? "text-blue-500" : "text-muted-foreground")" />
                            <span class="truncate">@context.Value</span>
                        </div>
                    </CellTemplate>
                </BbDataGridHierarchyColumn>
                <BbDataGridTemplateColumn TData="FileEntry" Title="Size" Sortable SortBy="@(f => (object)(f.Size ?? 0L))">
                    <ChildContent>
                        <span class="text-muted-foreground tabular-nums">@FormatFileSize(context.Size)</span>
                    </ChildContent>
                </BbDataGridTemplateColumn>
                <BbDataGridPropertyColumn TData="FileEntry" TProp="string" Property="@(f => f.Extension ?? "")" Title="Type" Sortable />
                <BbDataGridPropertyColumn TData="FileEntry" TProp="DateTime" Property="@(f => f.Modified)" Title="Modified" Format="yyyy-MM-dd" Sortable />
            </Columns>
        </BbDataGrid>
        @if (selectedFiles?.Count > 0)
        {
            <p class="text-sm text-muted-foreground">
                @selectedFiles.Count item(s) selected
            </p>
        }
        <CodeBlock Source="Components/DataGridHierarchy/file-explorer.txt" />
    </div>

    <!-- ── Large Dataset (World Geography) ────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Large Dataset</h2>
            <p class="text-sm text-muted-foreground">
                A 4-level hierarchy of Continent → Country → State/Province → City with
                <strong>@totalPlaceCount.ToString("N0")</strong> total rows. The hierarchy column is
                <code class="bg-muted px-1 py-0.5 rounded">Pinned="BlazorBlueprint.Primitives.DataGrid.ColumnPinning.Left"</code> so it stays
                visible while scrolling. Columns are <code class="bg-muted px-1 py-0.5 rounded">Reorderable</code>.
            </p>
        </div>
        <BbDataGrid TData="Place" Items="@worldData"
                    ChildrenSelector="@(p => p.Children)"
                    ItemValueSelector="@(p => p.Id)"
                    ChildPageSize="10"
                    ShowExpandAll="true"
                    Reorderable="true">
            <Columns>
                <BbDataGridHierarchyColumn TData="Place" TProp="string" Property="@(p => p.Name)" Title="Name" Sortable Filterable Pinned="BlazorBlueprint.Primitives.DataGrid.ColumnPinning.Left">
                    <CellTemplate>
                        <div class="flex items-center gap-2">
                            @if (context.Item.Type == "Country" && context.Item.Code.Length == 2)
                            {
                                <span class="text-base leading-none">@CountryCodeToFlag(context.Item.Code)</span>
                            }
                            <span class="truncate">@context.Value</span>
                        </div>
                    </CellTemplate>
                </BbDataGridHierarchyColumn>
                <BbDataGridPropertyColumn TData="Place" TProp="string" Property="@(p => p.Type)" Title="Type" Filterable />
                <BbDataGridPropertyColumn TData="Place" TProp="long" Property="@(p => p.Population)" Title="Population" Sortable />
                <BbDataGridPropertyColumn TData="Place" TProp="string" Property="@(p => p.Code)" Title="Code" Sortable Filterable />
            </Columns>
        </BbDataGrid>
        <CodeBlock Source="Components/DataGridHierarchy/large-dataset.txt" />
    </div>

    <!-- ── Virtualized Large Org Chart (4,000 employees) ────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Virtualized Large Org Chart</h2>
            <p class="text-sm text-muted-foreground">
                A generated org chart with <strong>@largeOrgEmployees.Count.ToString("N0")</strong> employees,
                each with a DiceBear avatar. Uses <code class="bg-muted px-1 py-0.5 rounded">Virtualize="true"</code>
                with <code class="bg-muted px-1 py-0.5 rounded">ItemSize="52"</code> so only visible rows are rendered
                in the DOM. Combined with a <code class="bg-muted px-1 py-0.5 rounded">BbFilterBuilder</code> for filtering.
                For large datasets, <code class="bg-muted px-1 py-0.5 rounded">HierarchyFilterMode</code> automatically
                switches to <code class="bg-muted px-1 py-0.5 rounded">ShowMatchedOnly</code> when the item count exceeds
                <code class="bg-muted px-1 py-0.5 rounded">HierarchyLargeDatasetThreshold</code> (default 500),
                and filtered results paginate by visible rows instead of root count.
            </p>
        </div>
        <div class="flex items-center gap-4">
            <BbFilterBuilder @bind-Filter="largeOrgFilter"
                             Fields="@largeOrgFields"
                             OnFilterChanged="HandleLargeOrgFilterChanged"
                             MaxDepth="2"
                             Compact="true"
                             Class="flex-1" />
        </div>
        <BbDataGrid TData="LargeOrgEmployee" Items="@largeOrgEmployees"
                    ParentValueSelector="@(e => e.ReportsToId)"
                    ItemValueSelector="@(e => e.Id)"
                    ItemFilter="@largeOrgFilterPredicate"
                    DefaultExpandDepth="1"
                    ChildPageSize="10"
                    ShowExpandAll="true"
                    Virtualize="true"
                    StickyHeader="true"
                    ItemSize="52"
                    Class="h-[600px] overflow-auto">
            <Columns>
                <BbDataGridHierarchyColumn TData="LargeOrgEmployee" TProp="string" Property="@(e => e.Name)" Title="Name" Sortable Filterable>
                    <CellTemplate>
                        <div class="flex items-center gap-2">
                            <BbAvatar Size="AvatarSize.Small">
                                <BbAvatarImage Source="@context.Item.AvatarUrl" Alt="@context.Item.Name" />
                                <BbAvatarFallback>@GetInitials(context.Item.Name)</BbAvatarFallback>
                            </BbAvatar>
                            <span class="truncate">@context.Value</span>
                        </div>
                    </CellTemplate>
                </BbDataGridHierarchyColumn>
                <BbDataGridPropertyColumn TData="LargeOrgEmployee" TProp="string" Property="@(e => e.Code)" Title="Code" Sortable />
                <BbDataGridPropertyColumn TData="LargeOrgEmployee" TProp="string" Property="@(e => e.JobTitle)" Title="Job Title" Sortable Filterable />
                <BbDataGridPropertyColumn TData="LargeOrgEmployee" TProp="string" Property="@(e => e.Department)" Title="Department" Sortable Filterable />
                <BbDataGridPropertyColumn TData="LargeOrgEmployee" TProp="string" Property="@(e => e.Location)" Title="Location" Sortable />
                <BbDataGridPropertyColumn TData="LargeOrgEmployee" TProp="int" Property="@(e => e.DirectReports)" Title="Direct Reports" Sortable />
            </Columns>
        </BbDataGrid>
        <CodeBlock Source="Components/DataGridHierarchy/virtualized-large-org.txt" />
    </div>

        <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>Hierarchy rows expose their level and expansion state. Supply an AriaLabel that identifies the data grid.</AccessibilityItem>
            <AccessibilityItem>ExpandedNodes and its change callback allow the application to retain expansion. Loading children should preserve stable item keys and meaningful row labels.</AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="Move between grid controls"><BbKbd>Tab</BbKbd> / <BbKbd>Shift + Tab</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Navigate focused grid rows when EnableKeyboardNavigation is enabled"><BbKbd>ArrowUp</BbKbd> / <BbKbd>ArrowDown</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Activate a focused expand or collapse button"><BbKbd>Enter</BbKbd> / <BbKbd>Space</BbKbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">API Reference</h2>
            <p class="text-muted-foreground">Component properties and parameters.</p>
        </div>

        <ApiReference ComponentName="BbDataGrid">
            <ApiParameter Name="Items" Type="IEnumerable&lt;TData&gt;?">The data source for the grid. Can be IQueryable&lt;TData&gt; or IEnumerable&lt;TData&gt;. Mutually exclusive with ItemsProvider.</ApiParameter>
            <ApiParameter Name="ItemKey" Type="Func&lt;TData, object&gt;?">A function that returns a stable identity key for each data item (e.g., item =&gt; item.Id). When set, selection and expansion state is tracked by key instead of reference equality, so state survives data re-fetches. Also forwarded to the Virtualize component when virtualization is enabled.</ApiParameter>
            <ApiParameter Name="ItemValueSelector" Type="Func&lt;TData, string&gt;?">Function that extracts a unique string identifier from each item. Required when using hierarchy features.</ApiParameter>
            <ApiParameter Name="ParentValueSelector" Type="Func&lt;TData, string?&gt;?">Function that returns the parent&#x27;s value for self-referencing (flat) hierarchical data. Mutually exclusive with ChildrenSelector.</ApiParameter>
            <ApiParameter Name="ChildrenSelector" Type="Func&lt;TData, IEnumerable&lt;TData&gt;?&gt;?">Function that returns the children of an item for nested hierarchical data. Mutually exclusive with ParentValueSelector.</ApiParameter>
            <ApiParameter Name="HasChildrenPredicate" Type="Func&lt;TData, bool&gt;?">Optional predicate to determine if an item has children before they are loaded. Used for lazy loading where children may not be indexed yet.</ApiParameter>
            <ApiParameter Name="LoadChildren" Type="Func&lt;TData, Task&lt;IEnumerable&lt;TData&gt;&gt;&gt;?">Async callback to load all children for a node on demand (lazy loading - full).</ApiParameter>
            <ApiParameter Name="LoadChildrenPaged" Type="Func&lt;TData, int, int, Task&lt;ChildPageResult&lt;TData&gt;&gt;&gt;?">Async callback to load a page of children for a node (lazy loading - paged). Parameters: parent item, skip count, take count.</ApiParameter>
            <ApiParameter Name="ChildPageSize" Type="int?">Page size for child-level pagination in hierarchy mode. When set, each expanded node shows at most this many children with a compact pager. Set to null to show all children inline. Default is null (no child pagination).</ApiParameter>
            <ApiParameter Name="DefaultExpandAll" Type="bool">Whether all hierarchy nodes should be expanded by default. Default is false.</ApiParameter>
            <ApiParameter Name="DefaultExpandDepth" Type="int?">Maximum depth to expand by default (exclusive). For example, 1 expands only root nodes.</ApiParameter>
            <ApiParameter Name="ExpandedNodes" Type="HashSet&lt;string&gt;?">The set of expanded node values in hierarchy mode. Use with @@bind-ExpandedNodes for controlled state.</ApiParameter>
            <ApiParameter Name="ExpandedNodesChanged" Type="EventCallback&lt;HashSet&lt;string&gt;&gt;">Event callback for controlled expansion state changes.</ApiParameter>
            <ApiParameter Name="HierarchySelectionMode" Type="HierarchySelectionMode" Default="HierarchySelectionMode.Independent">Controls how row selection interacts with the hierarchy. HierarchySelectionMode.Independent (default) treats each row independently. HierarchySelectionMode.Cascade cascades selection to descendants and shows an indeterminate state on parents with partially selected children. Only applies when SelectionMode is DataTableSelectionMode.Multiple and hierarchy mode is active.</ApiParameter>
            <ApiParameter Name="HierarchyFilterMode" Type="HierarchyFilterMode" Default="HierarchyFilterMode.ShowMatchedSubtree">Controls how hierarchy filtering treats descendants of matching nodes. Primitives.Utilities.HierarchyFilterMode.ShowMatchedSubtree (default) shows the entire subtree of matching parents. Primitives.Utilities.HierarchyFilterMode.ShowMatchedOnly only shows items that independently match the filter. When the total item count exceeds HierarchyLargeDatasetThreshold, ShowMatchedSubtree is automatically downgraded to ShowMatchedOnly during filtering to prevent performance issues with large trees.</ApiParameter>
            <ApiParameter Name="ShowExpandAll" Type="bool">Whether to show a built-in expand/collapse all toggle button in the hierarchy column header. Default is false.</ApiParameter>
            <ApiParameter Name="OnExpandAll" Type="EventCallback">Event callback invoked when expand all is triggered (via the built-in toggle or ExpandAllAsync).</ApiParameter>
            <ApiParameter Name="OnCollapseAll" Type="EventCallback">Event callback invoked when collapse all is triggered (via the built-in toggle or CollapseAllAsync).</ApiParameter>
            <ApiParameter Name="OnNodeExpand" Type="EventCallback&lt;TData&gt;">Event callback invoked when a hierarchy node is expanded.</ApiParameter>
            <ApiParameter Name="OnNodeCollapse" Type="EventCallback&lt;TData&gt;">Event callback invoked when a hierarchy node is collapsed.</ApiParameter>
            <ApiParameter Name="EnableKeyboardNavigation" Type="bool" Default="true">Enable keyboard navigation for rows. Default is true.</ApiParameter>
            <ApiParameter Name="AriaLabel" Type="string?">ARIA label for the grid.</ApiParameter>
        </ApiReference>
    </section>

</div>
