@page "/components/copy-text"
@inject ToastService ToastService

<PageTitle>Copy Text Component - Blazor Blueprint</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">Copy Text Component</h1>
            <p class="text-xl text-muted-foreground">
                Displays inline text that copies text to the clipboard when clicked.
            </p>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Basic Example</h2>
            <p class="text-sm text-muted-foreground">
                A simple inline text that copies text to the clipboard when clicked.
            </p>
        </div>
        <div class="border rounded-lg p-4 text-sm">
            Use code <BbCopyText Value="20OFF">20OFF</BbCopyText> to receive a 20% discount on your next order.
        </div>
        <CodeBlock Source="Components/CopyText/basic.txt" />
    </div>

    <!-- Custom Styling -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Custom Styling</h2>
            <p class="text-sm text-muted-foreground">
                A custom-styled text.
            </p>
        </div>
        <div class="border rounded-lg p-4 text-sm">
            Use code <BbCopyText Class="px-2 rounded-md bg-gradient-to-r from-purple-500 to-pink-500 text-white" Value="20OFF">20OFF</BbCopyText>
            to receive a 20% discount on your next order.
        </div>
        <CodeBlock Source="Components/CopyText/custom-styling.txt" />
    </div>

    <!-- On Copy Trigger -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Event Callback</h2>
            <p class="text-sm text-muted-foreground">
                An example showing a toast when text is copied.
            </p>
        </div>
        <div class="border rounded-lg p-4 text-sm">
            Use code <BbCopyText Value="20OFF" OnCopied='(promoCode)=> ToastService.Success($"Copied promo code {promoCode} to clipboard!")'>20OFF</BbCopyText>
            to receive a 20% discount on your next order.
        </div>
        <CodeBlock Source="Components/CopyText/event-callback.txt" />
    </div>

    <!-- Inside a scrollable container -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Inside a Scrollable Container</h2>
            <p class="text-sm text-muted-foreground">
                The tooltip renders through the portal, so an ancestor with
                <code class="text-xs bg-muted px-1 py-0.5 rounded">overflow: auto</code> or
                <code class="text-xs bg-muted px-1 py-0.5 rounded">overflow: hidden</code> does not clip it. Hover the
                first row — the tooltip escapes the scroll box rather than being cut off at its edge.
            </p>
        </div>
        <div class="border rounded-lg h-32 overflow-auto p-4 text-sm space-y-3">
            <div>Order <BbCopyText Value="ORD-10432">ORD-10432</BbCopyText> shipped on Tuesday.</div>
            <div>Order <BbCopyText Value="ORD-10433">ORD-10433</BbCopyText> is awaiting payment.</div>
            <div>Order <BbCopyText Value="ORD-10434">ORD-10434</BbCopyText> was refunded.</div>
            <div>Order <BbCopyText Value="ORD-10435">ORD-10435</BbCopyText> is in transit.</div>
            <div>Order <BbCopyText Value="ORD-10436">ORD-10436</BbCopyText> was delivered.</div>
        </div>
        <CodeBlock Source="Components/CopyText/scrollable-container.txt" />
    </div>

    <!-- Value from a function -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Value From a Function</h2>
            <p class="text-sm text-muted-foreground">
                <code class="text-xs bg-muted px-1 py-0.5 rounded">ValueFunc</code> is evaluated when the
                user copies, not on every render — for text derived from state that moves, or expensive
                enough that computing it up front would be wasted. Copy the token below, change the
                selection, and copy again.
            </p>
        </div>
        <div class="border rounded-lg p-4 text-sm space-y-3">
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground">Environment:</span>
                <span class="font-mono">@_environment</span>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="CycleEnvironment">
                    Change
                </BbButton>
            </div>
            <div>
                Connection token:
                <BbCopyText ValueFunc="@(() => $"{_environment}-{DateTime.Now:HHmmss}")"
                            OnCopied='(token) => ToastService.Success($"Copied {token}")'>
                    @_environment-&lt;generated at copy time&gt;
                </BbCopyText>
            </div>
        </div>
        <CodeBlock Source="Components/CopyText/value-func.txt" />
    </div>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">API Reference</h2>
            <p class="text-muted-foreground">Component properties and parameters.</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="BbCopyText">
                <ApiParameter Name="Value" Type="string?" Default="null">
                    The text to copy to clipboard when clicked. Takes precedence over
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">ValueFunc</code> when non-empty.
                </ApiParameter>
                <ApiParameter Name="ValueFunc" Type="Func<string?>?" Default="null">
                    A function producing the text to copy, evaluated at click time rather than on every
                    render. Used when <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code> is
                    null or empty — the test is emptiness, not null, so a bound-but-unset
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code> falls through to the
                    function instead of copying nothing.
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?" Default="null">
                    The content displayed inside the copy text element.
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?" Default="null">
                    Additional CSS classes to apply to the container.
                </ApiParameter>
                <ApiParameter Name="AriaLabel" Type="string?" Default="null">
                    ARIA label for the copy button. Defaults to the localized "Click to copy" text.
                </ApiParameter>
                <ApiParameter Name="OnCopied" Type="EventCallback<string?>">
                    Callback invoked when the user clicks the component to copy text.
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary<string, object>?" Default="null">
                    Additional HTML attributes applied to the container element.
                </ApiParameter>
            </ApiReference>
        </div>
    </section>

    <LocalizationSection
        Description="The copy text tooltip and aria label strings are configurable."
        Labels="@(new LocalizationSection.LabelInfo[]
        {
            new("ClickToCopy", "Click to copy", "Tooltip and aria label prompting the user to copy"),
            new("Copied", "Copied!", "Tooltip shown after the value has been copied"),
        })"
        CodeExample="@(@"services.AddBlazorBlueprintComponents(opts =>
{
    opts.CopyText.ClickToCopy = ""Zum Kopieren klicken"";
    opts.CopyText.Copied = ""Kopiert!"";
});")" />
</div>

@code {
    private static readonly string[] Environments = ["dev", "staging", "prod"];

    private string _environment = Environments[0];

    private void CycleEnvironment() =>
        _environment = Environments[(Array.IndexOf(Environments, _environment) + 1) % Environments.Length];
}
