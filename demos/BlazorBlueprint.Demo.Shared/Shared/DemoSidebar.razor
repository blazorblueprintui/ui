@using BlazorBlueprint.Icons.Lucide

<BbSidebar Collapsible="true">
    <BbSidebarHeader>
        <BbSidebarMenu>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="" Size="@SidebarMenuButtonSize.Large" class="data-[state=collapsed]:justify-center">
                    <div class="flex aspect-square size-8 items-center justify-center rounded-lg">
                        <img src="_content/BlazorBlueprint.Demo.Shared/images/b-icon-blueprint.png" alt="BlazorBlueprint" class="size-8 rounded-lg" />
                    </div>
                    <div class="grid flex-1 text-left text-sm leading-tight">
                        <span class="truncate font-semibold">Blazor Blueprint</span>
                    </div>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
        </BbSidebarMenu>
    </BbSidebarHeader>

    <BbSidebarContent>
        <!-- Top-level Navigation -->
        <BbSidebarGroup>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="" Match="NavLinkMatch.All" Tooltip="Home">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>Home</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>

                <BbSidebarMenuItem>
                    <BbSidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="architecture" Tooltip="Architecture">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="16" height="20" x="4" y="2" rx="2"></rect>
                            <path d="M8 6h8"></path>
                            <path d="M8 10h8"></path>
                            <path d="M8 14h5"></path>
                        </svg>
                        <span>Architecture</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>

                <BbSidebarMenuItem>
                    <BbSidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives" Tooltip="Primitives">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                            <path d="M9 3v18"></path>
                        </svg>
                        <span>Primitives</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>

                <BbSidebarMenuItem>
                    <BbSidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="components" Tooltip="Components">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                            <path d="M3 9h18"></path>
                            <path d="M9 21V9"></path>
                        </svg>
                        <span>Components</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarGroup>

        <!-- Primitives Section with Collapsible Submenu -->
        <BbSidebarGroup>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbCollapsible Open="@_primitivesMenuOpen" OpenChanged="@OnPrimitivesMenuOpenChanged">
                        <BbSidebarMenuButton Tooltip="Primitives">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                                <path d="M9 3v18"></path>
                            </svg>
                            <span>Primitives</span>
                            <BbSidebarMenuChevron>
                                <LucideIcon Name="chevron-right" Size="16" />
                            </BbSidebarMenuChevron>
                        </BbSidebarMenuButton>
                        <BbCollapsibleContent>
                            <BbSidebarMenuSub>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/accordion">
                                        <span>Accordion</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/alert-dialog">
                                        <span>Alert Dialog</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/checkbox">
                                        <span>Checkbox</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/collapsible">
                                        <span>Collapsible</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/context-menu">
                                        <span>Context Menu</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/dialog">
                                        <span>Dialog</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/datagrid">
                                        <span>DataGrid</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/dropdown-menu">
                                        <span>Dropdown Menu</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/hovercard">
                                        <span>Hover Card</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/label">
                                        <span>Label</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/menubar">
                                        <span>Menubar</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/navigation-menu">
                                        <span>Navigation Menu</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/popover">
                                        <span>Popover</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/progress">
                                        <span>Progress</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/radio-group">
                                        <span>Radio Group</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/select">
                                        <span>Select</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/scroll-area">
                                        <span>Scroll Area</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/separator">
                                        <span>Separator</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/sheet">
                                        <span>Sheet</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/slider">
                                        <span>Slider</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/sortable">
                                        <span>Sortable</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/switch">
                                        <span>Switch</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/table">
                                        <span>Table</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/tabs">
                                        <span>Tabs</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/toggle">
                                        <span>Toggle</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/toggle-group">
                                        <span>Toggle Group</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/tooltip">
                                        <span>Tooltip</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives/tree-view">
                                        <span>Tree View</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                            </BbSidebarMenuSub>
                        </BbCollapsibleContent>
                    </BbCollapsible>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarGroup>

        <!-- Components Section with Collapsible Submenu -->
        <BbSidebarGroup>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbCollapsible Open="@_componentsMenuOpen" OpenChanged="@OnComponentsMenuOpenChanged">
                        <BbSidebarMenuButton Tooltip="Components">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                                <path d="M3 9h18"></path>
                                <path d="M9 21V9"></path>
                            </svg>
                            <span>Components</span>
                            <BbSidebarMenuChevron>
                                <LucideIcon Name="chevron-right" Size="16" />
                            </BbSidebarMenuChevron>
                        </BbSidebarMenuButton>
                        <BbCollapsibleContent>
                            <BbSidebarMenuSub>
                                @foreach (var group in ComponentCatalog.NavigationGroups)
                                {
                                    <BbSidebarMenuSubItem @key="group.Entry.Url">
                                        <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="@group.Entry.Url" Class="demo-component-link" title="@group.Entry.Name">
                                            <span class="demo-component-label">@group.Entry.Name</span>
                                            @if (group.Entry.IsNew)
                                            {
                                                <span class="shrink-0 rounded border border-primary/20 bg-primary/10 px-1.5 py-0.5 text-[10px] font-semibold leading-none text-primary" title="Added in v4">v4</span>
                                            }
                                        </BbSidebarMenuSubButton>
                                        @if (group.Children.Count > 0)
                                        {
                                            <BbSidebarMenuSub Class="my-1" aria-label="@($"{group.Entry.Name} related demos")">
                                                @foreach (var child in group.Children)
                                                {
                                                    <BbSidebarMenuSubItem @key="child.Url">
                                                        <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="@child.Url" Class="demo-component-link" title="@child.Name">
                                                            <span class="demo-component-label">@ComponentCatalog.NavigationLabel(group.Entry, child)</span>
                                                            @if (child.IsNew)
                                                            {
                                                                <span class="shrink-0 rounded border border-primary/20 bg-primary/10 px-1.5 py-0.5 text-[10px] font-semibold leading-none text-primary" title="Added in v4">v4</span>
                                                            }
                                                        </BbSidebarMenuSubButton>
                                                    </BbSidebarMenuSubItem>
                                                }
                                            </BbSidebarMenuSub>
                                        }
                                    </BbSidebarMenuSubItem>
                                }
                            </BbSidebarMenuSub>
                        </BbCollapsibleContent>
                    </BbCollapsible>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarGroup>

        <!-- Charts Section with Collapsible Submenu -->
        <BbSidebarGroup>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbCollapsible Open="@_chartsMenuOpen" OpenChanged="@OnChartsMenuOpenChanged">
                        <BbSidebarMenuButton Tooltip="Charts">
                            <LucideIcon Name="bar-chart-3" Size="18" />
                            <span>Charts</span>
                            <BbSidebarMenuChevron>
                                <LucideIcon Name="chevron-right" Size="16" />
                            </BbSidebarMenuChevron>
                        </BbSidebarMenuButton>
                        <BbCollapsibleContent>
                            <BbSidebarMenuSub>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="charts/area">
                                        <span>Area Chart</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="charts/bar">
                                        <span>Bar Chart</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="charts/candlestick">
                                        <span>Candlestick Chart</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="charts/composite">
                                        <span>Composite Chart</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="charts/funnel">
                                        <span>Funnel Chart</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="charts/gauge">
                                        <span>Gauge Chart</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="charts/heatmap">
                                        <span>Heatmap Chart</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="charts/line">
                                        <span>Line Chart</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="charts/pie">
                                        <span>Pie Chart</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="charts/radar">
                                        <span>Radar Chart</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="charts/scatter">
                                        <span>Scatter Chart</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                @* Radial Chart — WIP, hidden from nav *@
                            </BbSidebarMenuSub>
                        </BbCollapsibleContent>
                    </BbCollapsible>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarGroup>

        <!-- Icons Section with Collapsible Submenu -->
        <BbSidebarGroup>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbCollapsible Open="@_iconsMenuOpen" OpenChanged="@OnIconsMenuOpenChanged">
                        <BbSidebarMenuButton Tooltip="Icons">
                            <LucideIcon Name="smile" Size="18" />
                            <span>Icons</span>
                            <BbSidebarMenuChevron>
                                <LucideIcon Name="chevron-right" Size="16" />
                            </BbSidebarMenuChevron>
                        </BbSidebarMenuButton>
                        <BbCollapsibleContent>
                            <BbSidebarMenuSub>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="icons/lucide">
                                        <span>Lucid Icons</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="icons/heroicons">
                                        <span>Heroicons</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="icons/feather">
                                        <span>Feather Icons</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="icons/fontawesome">
                                        <span>Font Awesome Icons</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                            </BbSidebarMenuSub>
                        </BbCollapsibleContent>
                    </BbCollapsible>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarGroup>

        <!-- Recipes Section -->
        <BbSidebarGroup>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbCollapsible Open="@_recipesMenuOpen" OpenChanged="@OnRecipesMenuOpenChanged">
                        <BbSidebarMenuButton Tooltip="Recipes">
                            <LucideIcon Name="chef-hat" Size="18" />
                            <span>Recipes</span>
                            <BbSidebarMenuChevron>
                                <LucideIcon Name="chevron-right" Size="16" />
                            </BbSidebarMenuChevron>
                        </BbSidebarMenuButton>
                        <BbCollapsibleContent>
                            <BbSidebarMenuSub>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="recipes/filterable-datagrid">
                                        <span>Filterable Data Grid</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="recipes/mobile-shop">
                                        <span>Mobile Shop</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                            </BbSidebarMenuSub>
                        </BbCollapsibleContent>
                    </BbCollapsible>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarGroup>

        <!-- Guides Section -->
        <BbSidebarGroup>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbCollapsible Open="@_guidesMenuOpen" OpenChanged="@OnGuidesMenuOpenChanged">
                        <BbSidebarMenuButton Tooltip="Guides">
                            <LucideIcon Name="book-open" Size="18" />
                            <span>Guides</span>
                            <BbSidebarMenuChevron>
                                <LucideIcon Name="chevron-right" Size="16" />
                            </BbSidebarMenuChevron>
                        </BbSidebarMenuButton>
                        <BbCollapsibleContent>
                            <BbSidebarMenuSub>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="guides/animations">
                                        <span>Animations</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="guides/nested-overlays">
                                        <span>Nested Overlays</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="guides/localization">
                                        <span>Localization</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
                                <BbSidebarMenuSubItem>
                                    <BbSidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="guides/render-modes">
                                        <span>Render Modes</span>
                                    </BbSidebarMenuSubButton>
                                </BbSidebarMenuSubItem>
