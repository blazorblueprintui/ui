<BbMenubar>

    <BbMenubarMenu>
        <BbMenubarTrigger>File</BbMenubarTrigger>
        <BbMenubarContent>
            <BbMenubarItem OnClick="Quit">
                Quit <BbMenubarShortcut>Alt+F4</BbMenubarShortcut>
            </BbMenubarItem>
        </BbMenubarContent>
    </BbMenubarMenu>

    <BbMenubarMenu>
        <BbMenubarTrigger>Help</BbMenubarTrigger>
        <BbMenubarContent>
            <BbMenubarItem OnClick="ShowAbout">About</BbMenubarItem>
        </BbMenubarContent>
    </BbMenubarMenu>

</BbMenubar>

<About @ref="_aboutForm"></About>

@code {
    private About? _aboutForm;

    private void Quit() {
        Environment.Exit(0);
    }

    private void ShowAbout() {
        _aboutForm?.ShowAboutDialog();
    }
}
