@* Bento Grid Layout *@
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
    @* Row 1: Sign In + Calendar spanning 2 cols *@
    <BbCard>
        <BbCardHeader class="pb-3">
            <BbCardTitle class="text-base">Create an account</BbCardTitle>
            <BbCardDescription>Enter your email below to create your account</BbCardDescription>
        </BbCardHeader>
        <BbCardContent class="space-y-4">
            <div class="grid grid-cols-2 gap-2">
                <BbButton Variant="ButtonVariant.Outline" Class="w-full">
                    <LucideIcon Name="github" class="mr-2 h-4 w-4" /> GitHub
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" Class="w-full">
                    <LucideIcon Name="mail" class="mr-2 h-4 w-4" /> Google
                </BbButton>
            </div>
            <div class="relative">
                <div class="absolute inset-0 flex items-center">
                    <BbSeparator />
                </div>
                <div class="relative flex justify-center text-xs uppercase">
                    <span class="bg-card px-2 text-muted-foreground">Or continue with</span>
                </div>
            </div>
            <div class="space-y-2">
                <BbLabel>Email</BbLabel>
                <BbInput Type="InputType.Email" Placeholder="m@example.com" />
            </div>
            <div class="space-y-2">
                <BbLabel>Password</BbLabel>
                <BbInput Type="InputType.Password" Placeholder="••••••••" />
            </div>
            <BbButton Class="w-full">Create account</BbButton>
        </BbCardContent>
    </BbCard>

    <BbCard class="xl:col-span-2 overflow-hidden">
        <BbCardContent class="p-0">
            <div class="flex flex-col xl:flex-row">
                <div class="p-6 flex justify-center items-center border-b xl:border-b-0 xl:border-r">
                    <BbCalendar @bind-Selected="calendarDate" />
                </div>
                <div class="flex-1 p-6 space-y-4">
                    <div>
                        <h3 class="font-semibold">Upcoming Events</h3>
                        <p class="text-sm text-muted-foreground">Your schedule for today</p>
                    </div>
                    <div class="space-y-3">
                        <div class="flex items-center gap-3 p-3 rounded-lg bg-muted/50">
                            <div class="h-2 w-2 rounded-full bg-primary"></div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium">Team standup</p>
                                <p class="text-xs text-muted-foreground">9:00 AM - 9:30 AM</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-3 rounded-lg bg-muted/50">
                            <div class="h-2 w-2 rounded-full bg-chart-2"></div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium">Design review</p>
                                <p class="text-xs text-muted-foreground">2:00 PM - 3:00 PM</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-3 rounded-lg bg-muted/50">
                            <div class="h-2 w-2 rounded-full bg-chart-4"></div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium">Client call</p>
                                <p class="text-xs text-muted-foreground">4:30 PM - 5:00 PM</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </BbCardContent>
    </BbCard>

    @* Row 2: Chat + Team Members + Notifications *@
    <BbCard>
        <BbCardHeader class="pb-3">
            <div class="flex items-center gap-3">
                <BbAvatar Class="h-9 w-9">
                    <BbAvatarFallback class="bg-primary/10 text-primary">SD</BbAvatarFallback>
                </BbAvatar>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium">Sofia Davis</p>
                    <p class="text-xs text-muted-foreground">Active now</p>
                </div>
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon">
                    <LucideIcon Name="phone" class="h-4 w-4" />
                </BbButton>
            </div>
        </BbCardHeader>
        <BbCardContent class="space-y-3">
            <div class="flex gap-2">
                <BbAvatar Class="h-8 w-8 shrink-0">
                    <BbAvatarFallback class="text-xs bg-muted">SD</BbAvatarFallback>
                </BbAvatar>
                <div class="bg-muted rounded-2xl rounded-tl-none px-3 py-2 text-sm">
                    Hey! How's the project going?
                </div>
            </div>
            <div class="flex gap-2 justify-end">
                <div class="bg-primary text-primary-foreground rounded-2xl rounded-tr-none px-3 py-2 text-sm">
                    Going great! Almost done with the design.
                </div>
            </div>
            <div class="flex gap-2">
                <BbAvatar Class="h-8 w-8 shrink-0">
                    <BbAvatarFallback class="text-xs bg-muted">SD</BbAvatarFallback>
                </BbAvatar>
                <div class="bg-muted rounded-2xl rounded-tl-none px-3 py-2 text-sm">
                    That's awesome! Can't wait to see it
                </div>
            </div>
        </BbCardContent>
        <BbCardFooter class="pt-0">
            <div class="flex w-full gap-2">
                <BbInput Placeholder="Type a message..." Class="flex-1" />
                <BbButton Size="ButtonSize.Icon">
                    <LucideIcon Name="send" class="h-4 w-4" />
                </BbButton>
            </div>
        </BbCardFooter>
    </BbCard>

    <BbCard>
        <BbCardHeader class="pb-3">
            <BbCardTitle class="text-base">Team Members</BbCardTitle>
            <BbCardDescription>Manage your team and permissions</BbCardDescription>
        </BbCardHeader>
        <BbCardContent class="space-y-4">
            <div class="flex items-center gap-3">
                <BbAvatar Class="h-9 w-9">
                    <BbAvatarFallback class="bg-chart-1/20 text-chart-1">SD</BbAvatarFallback>
                </BbAvatar>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium">Sofia Davis</p>
                    <p class="text-xs text-muted-foreground">sofia@example.com</p>
                </div>
                <BbSelect TValue="string" @bind-Value="role1" DisplayTextSelector="@GetRoleDisplayText" Class="w-[110px]">
                    <BbSelectTrigger><BbSelectValue Placeholder="Role" /></BbSelectTrigger>
                    <BbSelectContent>
                        @foreach (var role in roleOptions) {
                            <BbSelectItem Value="@role.Value" Text="@role.Label">@role.Label</BbSelectItem>
                        }
                    </BbSelectContent>
                </BbSelect>
            </div>
            <BbSeparator />
            <div class="flex items-center gap-3">
                <BbAvatar Class="h-9 w-9">
                    <BbAvatarFallback class="bg-chart-2/20 text-chart-2">JL</BbAvatarFallback>
                </BbAvatar>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium">Jackson Lee</p>
                    <p class="text-xs text-muted-foreground">jackson@example.com</p>
                </div>
                <BbSelect TValue="string" @bind-Value="role2" DisplayTextSelector="@GetRoleDisplayText" Class="w-[110px]">
                    <BbSelectTrigger><BbSelectValue Placeholder="Role" /></BbSelectTrigger>
                    <BbSelectContent>
                        @foreach (var role in roleOptions) {
                            <BbSelectItem Value="@role.Value" Text="@role.Label">@role.Label</BbSelectItem>
                        }
                    </BbSelectContent>
                </BbSelect>
            </div>
            <BbSeparator />
            <BbButton Variant="ButtonVariant.Outline" Class="w-full">
                <LucideIcon Name="user-plus" class="mr-2 h-4 w-4" /> Invite Member
            </BbButton>
        </BbCardContent>
    </BbCard>

    <BbCard>
        <BbCardHeader class="pb-3">
            <BbCardTitle class="text-base">Notifications</BbCardTitle>
            <BbCardDescription>Configure how you receive notifications</BbCardDescription>
        </BbCardHeader>
        <BbCardContent class="space-y-4">
            <div class="flex items-center justify-between">
                <div class="space-y-0.5">
                    <p class="text-sm font-medium">Push Notifications</p>
                    <p class="text-xs text-muted-foreground">Receive push notifications</p>
                </div>
                <BbSwitch Checked="true" />
            </div>
            <BbSeparator />
            <div class="flex items-center justify-between">
                <div class="space-y-0.5">
                    <p class="text-sm font-medium">Email Digest</p>
                    <p class="text-xs text-muted-foreground">Weekly summary emails</p>
                </div>
                <BbSwitch Checked="true" />
            </div>
            <BbSeparator />
            <div class="flex items-center justify-between">
                <div class="space-y-0.5">
                    <p class="text-sm font-medium">Marketing</p>
                    <p class="text-xs text-muted-foreground">Product updates and tips</p>
                </div>
                <BbSwitch />
            </div>
        </BbCardContent>
    </BbCard>

    @* Row 3: Product Filters + Brand Settings + Contact Info *@
    <BbCard>
        <BbCardHeader class="pb-3">
            <BbCardTitle class="text-base">Product Filters</BbCardTitle>
            <BbCardDescription>Refine your search results</BbCardDescription>
        </BbCardHeader>
        <BbCardContent class="space-y-4">
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>Price Range</span>
                    <span class="text-muted-foreground">$@priceRange.Start - $@priceRange.End</span>
                </div>
                <BbRangeSlider @bind-Value="priceRange" Min="0" Max="1000" Step="10" />
            </div>
            <BbSeparator />
            <div class="space-y-2">
                <BbLabel>Minimum Rating</BbLabel>
                <div class="flex items-center gap-2">
                    <BbRating @bind-Value="minRating" Size="RatingSize.Small" />
                    <span class="text-sm text-muted-foreground">& up</span>
                </div>
            </div>
            <BbSeparator />
            <div class="space-y-2">
                <BbLabel>Items per page</BbLabel>
                <BbNumericInput TValue="int" @bind-Value="itemsPerPage" Min="10" Max="100" Step="10" ShowButtons="true" />
            </div>
            <BbButton Class="w-full">
                <LucideIcon Name="filter" class="mr-2 h-4 w-4" /> Apply Filters
            </BbButton>
        </BbCardContent>
    </BbCard>

    <BbCard>
        <BbCardHeader class="pb-3">
            <BbCardTitle class="text-base">Brand Settings</BbCardTitle>
            <BbCardDescription>Customize your brand appearance</BbCardDescription>
        </BbCardHeader>
        <BbCardContent class="space-y-4">
            <div class="space-y-2">
                <BbLabel>Brand Color</BbLabel>
                <BbColorPicker @bind-Value="themeColor" />
            </div>
            <div class="space-y-2">
                <BbLabel>Preview</BbLabel>
                <div class="flex gap-2">
                    <div class="h-10 w-10 rounded-md" style="@($"background-color: {themeColor}")"></div>
                    <div class="flex-1 space-y-1">
                        <div class="h-4 rounded" style="@($"background-color: {themeColor}; opacity: 0.8")"></div>
                        <div class="h-4 w-2/3 rounded" style="@($"background-color: {themeColor}; opacity: 0.5")"></div>
                    </div>
                </div>
            </div>
            <BbButton Class="w-full" style="@($"background-color: {themeColor}")">
                <LucideIcon Name="palette" class="mr-2 h-4 w-4" /> Save Brand Settings
            </BbButton>
        </BbCardContent>
    </BbCard>

    <BbCard>
        <BbCardHeader class="pb-3">
            <BbCardTitle class="text-base">Contact Information</BbCardTitle>
            <BbCardDescription>How can we reach you?</BbCardDescription>
        </BbCardHeader>
        <BbCardContent class="space-y-4">
            <div class="space-y-2">
                <BbLabel>Phone Number</BbLabel>
                <BbMaskedInput @bind-Value="phoneNumber" Preset="MaskPreset.Phone" />
            </div>
            <div class="space-y-2">
                <BbLabel>Preferred Call Time</BbLabel>
                <BbTimePicker @bind-Value="appointmentTime" MinuteStep="30" />
            </div>
            <div class="space-y-2">
                <BbLabel>Monthly Budget</BbLabel>
                <BbCurrencyInput @bind-Value="budget" CurrencyCode="USD" />
            </div>
            <BbButton Class="w-full">
                <LucideIcon Name="phone" class="mr-2 h-4 w-4" /> Request Callback
            </BbButton>
        </BbCardContent>
    </BbCard>

    @* Row 4: New Components - Payment + Booking + Review *@
    <BbCard>
        <BbCardHeader class="pb-3">
            <BbCardTitle class="text-base">Payment Details</BbCardTitle>
            <BbCardDescription>Enter your payment information</BbCardDescription>
        </BbCardHeader>
        <BbCardContent class="space-y-4">
            <div class="space-y-2">
                <BbLabel>Card Number</BbLabel>
                <BbMaskedInput @bind-Value="cardNumber" Preset="MaskPreset.CreditCard" Placeholder="0000 0000 0000 0000" />
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-2">
                    <BbLabel>Expiry Date</BbLabel>
                    <BbMaskedInput @bind-Value="cardExpiry" Preset="MaskPreset.Custom" Mask="99/99" Placeholder="MM/YY" />
                </div>
                <div class="space-y-2">
                    <BbLabel>CVV</BbLabel>
                    <BbMaskedInput @bind-Value="cardCvv" Preset="MaskPreset.Custom" Mask="999" Placeholder="123" />
                </div>
            </div>
            <div class="space-y-2">
                <BbLabel>Amount</BbLabel>
                <BbCurrencyInput @bind-Value="paymentAmount" CurrencyCode="USD" />
            </div>
            <BbButton Class="w-full">
                <LucideIcon Name="credit-card" class="mr-2 h-4 w-4" /> Pay @paymentAmount.ToString("C")
            </BbButton>
        </BbCardContent>
    </BbCard>

    <BbCard>
        <BbCardHeader class="pb-3">
            <BbCardTitle class="text-base">Book a Stay</BbCardTitle>
            <BbCardDescription>Select your dates and check-in time</BbCardDescription>
        </BbCardHeader>
        <BbCardContent class="space-y-4">
            <div class="space-y-2">
                <BbLabel>Travel Dates</BbLabel>
                <BbDateRangePicker @bind-Value="bookingDates" />
            </div>
            <div class="space-y-2">
                <BbLabel>Check-in Time</BbLabel>
                <BbTimePicker @bind-Value="checkInTime" />
            </div>
            <div class="space-y-2">
                <BbLabel>Guests</BbLabel>
                <BbNumericInput TValue="int" @bind-Value="guestCount" Min="1" Max="10" ShowButtons="true" />
            </div>
            <BbButton Class="w-full">
                <LucideIcon Name="calendar-check" class="mr-2 h-4 w-4" /> Check Availability
            </BbButton>
        </BbCardContent>
    </BbCard>

    <BbCard>
        <BbCardHeader class="pb-3">
            <BbCardTitle class="text-base">Leave a Review</BbCardTitle>
            <BbCardDescription>Share your experience with others</BbCardDescription>
        </BbCardHeader>
        <BbCardContent class="space-y-4">
            <div class="space-y-2">
                <BbLabel>Overall Rating</BbLabel>
                <div class="flex items-center gap-2">
                    <BbRating @bind-Value="reviewRating" AllowHalf="true" />
                    <span class="text-sm text-muted-foreground">@reviewRating / 5</span>
                </div>
            </div>
            <div class="space-y-2">
                <BbLabel>Value for Money</BbLabel>
                <BbRating @bind-Value="valueRating" Size="RatingSize.Small" />
            </div>
            <div class="space-y-2">
                <BbLabel>Your Review</BbLabel>
                <BbTextarea Placeholder="Tell us about your experience..." Class="min-h-[80px]" />
            </div>
            <BbButton Class="w-full">
                <LucideIcon Name="send" class="mr-2 h-4 w-4" /> Submit Review
            </BbButton>
        </BbCardContent>
    </BbCard>

</div>

@code {
    private DateTime? calendarDate = DateTime.Today;
    private string? role1 = "owner";
    private string? role2 = "developer";

    // Payment form
    private string cardNumber = "";
    private string cardExpiry = "";
    private string cardCvv = "";
    private decimal paymentAmount = 99.99m;

    // Booking form
    private DateRange? bookingDates;
    private TimeSpan? checkInTime = new TimeSpan(15, 0, 0);
    private int guestCount = 2;

    // Review form
    private double reviewRating = 4.5;
    private double valueRating = 4;

    // Product filters
    private (double Start, double End) priceRange = (100, 500);
    private double minRating = 3;
    private int itemsPerPage = 20;

    // Brand settings
    private string themeColor = "#3b82f6";

    // Contact info
    private string phoneNumber = "";
    private TimeSpan? appointmentTime;
    private decimal budget = 5000m;

    private record RoleOption(string Value, string Label);
    private static readonly RoleOption[] roleOptions = new[]
    {
        new RoleOption("viewer", "Viewer"),
        new RoleOption("developer", "Developer"),
        new RoleOption("billing", "Billing"),
        new RoleOption("owner", "Owner")
    };

    private string GetRoleDisplayText(string value) =>
        roleOptions.FirstOrDefault(r => r.Value == value)?.Label ?? value;
}
