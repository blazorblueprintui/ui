@namespace BlazorBlueprint.Primitives.Sheet
@using System.ComponentModel
@using BlazorBlueprint.Primitives.Services
@inject IFocusManager FocusManager
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@*
    SheetContent is the main content container for the sheet.
    Handles focus trap, escape key, scroll lock, side-specific positioning, and ARIA attributes.
    With NonModal set it behaves as a non-modal dialog instead: no focus trap, no scroll lock,
    aria-modal="false", and (with CloseOnInteractOutside) a pointer-down outside closes it.
*@

@if (Context.IsPresent)
{
    <div @ref="_contentRef"
         id="@Context.ContentId"
         role="dialog"
         aria-modal="@(NonModal ? "false" : "true")"
         aria-labelledby="@Context.TitleId"
         aria-describedby="@Context.DescriptionId"
         tabindex="-1"
         @attributes="AdditionalAttributes"
         data-state="@(Context.IsOpen ? "open" : "closed")"
         data-side="@Context.Side.ToString().ToLower()">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter]
    private SheetContext Context { get; set; } = null!;

    /// <summary>
    /// The content to render inside the sheet.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional attributes to apply to the content container.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Whether pressing Escape should close the sheet.
    /// Default is true.
    /// </summary>
    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// Whether to trap focus within the sheet.
    /// Default is true for modal sheets.
    /// </summary>
    [Parameter]
    public bool TrapFocus { get; set; } = true;

    /// <summary>
    /// What to focus when the focus trap is established. Defaults to the first tabbable
    /// descendant.
    /// </summary>
    /// <remarks>
    /// Set this to <see cref="FocusTrapInitialFocus.Container"/> when the first tabbable child
    /// has a side effect on focus, or use <see cref="InitialFocusElement"/> to name a target.
    /// An element carrying <c>data-autofocus</c> wins over this setting.
    /// </remarks>
    [Parameter]
    public FocusTrapInitialFocus InitialFocus { get; set; } = FocusTrapInitialFocus.FirstFocusable;

    /// <summary>
    /// An explicit element to focus when the focus trap is established, beating both
    /// <see cref="InitialFocus"/> and any <c>data-autofocus</c> element. Ignored when it is not
    /// inside the sheet.
    /// </summary>
    [Parameter]
    public ElementReference? InitialFocusElement { get; set; }

    /// <summary>
    /// Whether to lock body scroll when sheet is open.
    /// Default is true for modal sheets.
    /// </summary>
    [Parameter]
    public bool LockScroll { get; set; } = true;

    /// <summary>
    /// Event callback invoked when Escape key is pressed.
    /// </summary>
    [Parameter]
    public EventCallback<KeyboardEventArgs> OnEscapeKeyDown { get; set; }

    /// <summary>
    /// Whether the sheet behaves as a non-modal dialog, leaving the page behind it usable.
    /// Default is false.
    /// </summary>
    /// <remarks>
    /// <para>
    /// When true, the content gets <c>aria-modal="false"</c>, focus is moved into it on open
    /// (following <see cref="InitialFocus"/> and <see cref="InitialFocusElement"/>) but not
    /// trapped, and body scroll is not locked: <see cref="TrapFocus"/> and
    /// <see cref="LockScroll"/> are ignored. Escape still closes the sheet, and a pointer-down
    /// outside it closes it too unless <see cref="CloseOnInteractOutside"/> is false. Both follow
    /// the sheet's <c>Modal</c> setting, which decides whether the sheet can be dismissed at all.
    /// </para>
    /// <para>
    /// Render no <see cref="BbSheetOverlay"/> alongside a non-modal sheet: an overlay would
    /// block the page this mode exists to keep usable. This is distinct from the sheet's
    /// <c>Modal</c> parameter, which only controls dismissal. Read when the sheet opens:
    /// changing it while the sheet is open takes effect the next time it opens.
    /// </para>
    /// </remarks>
    [Parameter]
    public bool NonModal { get; set; }

    /// <summary>
    /// Whether a pointer-down outside the content closes the sheet. Only applies when
    /// <see cref="NonModal"/> is true; a modal sheet is dismissed through its overlay instead.
    /// Default is true.
    /// </summary>
    /// <remarks>
    /// The trigger does not count as outside (it toggles the sheet itself), and neither does
    /// floating content portaled out of the sheet, such as a popover, select or dropdown menu
    /// opened from inside it. A dialog or another sheet opened from inside it does count as
    /// outside.
    /// </remarks>
    [Parameter]
    public bool CloseOnInteractOutside { get; set; } = true;

    private ElementReference _contentRef;
    private IAsyncDisposable? _focusTrap;
    private IJSObjectReference? _portalModule;
    private IJSObjectReference? _scrollLockCleanup;
    private IJSObjectReference? _escapeModule;
    private IJSObjectReference? _interactOutsideHandle;
    private DotNetObjectReference<BbSheetContent>? _dotNetRef;
    private string _instanceId = Guid.NewGuid().ToString("N");
    private bool _isInitialized = false;
    private bool _disposed;

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException(
                "SheetContent must be used within a Sheet component. " +
                "Ensure SheetContent is a child of a Sheet component.");
        }

        // Subscribe to context changes
        Context.OnStateChanged += HandleContextStateChanged;
    }

    protected override void OnParametersSet() =>
        Context.ExitAnimation = WaitForExitAsync;

    /// <summary>
    /// Holds the sheet on the page until its closed-state CSS animation has played. The gate's
    /// supersede check releases the sheet if it is reopened first, so this only has to wait.
    /// </summary>
    private Task WaitForExitAsync(Func<bool> isCurrent) =>
        OverlayExit.WaitAsync(JSRuntime, _contentRef, OverlayExit.SlideFallbackDelay);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Context.IsOpen && !_isInitialized)
        {
            _isInitialized = true;

            // Set up focus trap. A non-modal sheet only takes focus on open; it does not keep it.
            if (NonModal)
            {
                await FocusInitialAsync();
            }
            else if (TrapFocus)
            {
                try
                {
                    _focusTrap = await FocusManager.TrapFocus(_contentRef, InitialFocus, InitialFocusElement);
                }
                catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
                {
                    // Expected during circuit disconnect in Blazor Server
                }
                catch (InvalidOperationException)
                {
                    // JS interop not available during prerendering
                }
            }

            // Lock body scroll (never for a non-modal sheet, whose page stays usable)
            if (LockScroll && !NonModal)
            {
                try
                {
                    _portalModule = await PrimitiveModules.GetAsync(JSRuntime);
                    _scrollLockCleanup = await _portalModule.InvokeAsync<IJSObjectReference>("portal.lockBodyScroll");
                }
                catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
                {
                    // Expected during circuit disconnect or module loading failure
                }
                catch (InvalidOperationException)
                {
                    // JS interop not available during prerendering
                }
            }

            // Set up escape key detection in JS (avoids C# round-trip on every keystroke)
            try
            {
                _escapeModule = await PrimitiveModules.GetAsync(JSRuntime);
                _dotNetRef = DotNetObjectReference.Create(this);
                await _escapeModule.InvokeVoidAsync("escapeKeydown.initialize", _dotNetRef, _instanceId);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // Expected during circuit disconnect or module loading failure
            }
            catch (InvalidOperationException)
            {
                // JS interop not available during prerendering
            }

            // Close on a pointer-down outside a non-modal sheet. The shared click-outside helper
            // excludes the trigger and any floating content portaled out of the sheet. Registered
            // whatever CloseOnInteractOutside says, which is read per pointer-down so it can change
            // while the sheet is open.
            if (NonModal)
            {
                try
                {
                    var module = await PrimitiveModules.GetAsync(JSRuntime);
                    _dotNetRef ??= DotNetObjectReference.Create(this);
                    _interactOutsideHandle = await module.InvokeAsync<IJSObjectReference>(
                        "clickOutside.onClickOutsideByIds", Context.ContentId, _dotNetRef, nameof(JsOnInteractOutside), Context.TriggerId);
                }
                catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
                {
                    // Expected during circuit disconnect or module loading failure
                }
                catch (InvalidOperationException)
                {
                    // JS interop not available during prerendering
                }
            }
        }
        else if (!Context.IsPresent && _isInitialized)
        {
            await CleanupAsync();
        }
    }

    private void HandleContextStateChanged()
    {
        // An exiting sheet keeps its focus trap and scroll lock until it leaves.
        if (!Context.IsPresent && _isInitialized)
        {
            // Sheet closed, clean up on the Blazor sync context
            _ = InvokeAsync(async () =>
            {
                await CleanupAsync();
                StateHasChanged();
            });
            return;
        }

        StateHasChanged();
    }

    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public async Task JsOnEscapeKey()
    {
        if (_disposed) { return; }

        // Invoke custom handler if provided
        if (OnEscapeKeyDown.HasDelegate)
        {
            await OnEscapeKeyDown.InvokeAsync(new KeyboardEventArgs { Key = "Escape" });
        }

        // Close sheet if configured (both CloseOnEscape and the sheet's Modal must allow it)
        if (CloseOnEscape && Context.Modal)
        {
            Context.Close();
        }
    }

    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public Task JsOnInteractOutside()
    {
        if (_disposed || !Context.IsOpen) { return Task.CompletedTask; }

        // Same rule as the overlay click: the sheet's Modal decides whether it can be dismissed
        if (NonModal && CloseOnInteractOutside && Context.Modal)
        {
            Context.Close();
        }

        return Task.CompletedTask;
    }

    // Moves focus into a non-modal sheet the same way the modal one does (InitialFocusElement,
    // then data-autofocus, then InitialFocus), by establishing the trap and releasing it straight
    // away, so the two modes can never disagree about where focus lands.
    private async Task FocusInitialAsync()
    {
        try
        {
            var trap = await FocusManager.TrapFocus(_contentRef, InitialFocus, InitialFocusElement);
            await trap.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
        {
            // Expected during circuit disconnect, or when the element is gone
        }
        catch (InvalidOperationException)
        {
            // JS interop not available during prerendering
        }
    }

    private async Task CleanupAsync()
    {
        // Dispose focus trap
        if (_focusTrap != null)
        {
            await _focusTrap.DisposeAsync();
            _focusTrap = null;
        }

        // Unlock body scroll
        if (_scrollLockCleanup != null)
        {
            try
            {
                await _scrollLockCleanup.InvokeVoidAsync("apply");
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // Cleanup may already be disposed or circuit disconnected
            }
            _scrollLockCleanup = null;
        }

        // Remove the outside-interaction listener
        if (_interactOutsideHandle != null)
        {
            try
            {
                await _interactOutsideHandle.InvokeVoidAsync("dispose");
                await _interactOutsideHandle.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // Cleanup may already be disposed or circuit disconnected
            }
            _interactOutsideHandle = null;
        }

        // Remove escape key listener
        if (_escapeModule != null)
        {
            try
            {
                await _escapeModule.InvokeVoidAsync("escapeKeydown.dispose", _instanceId);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // Cleanup may already be disposed or circuit disconnected
            }
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;

        _isInitialized = false;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        await CleanupAsync();



        _dotNetRef?.Dispose();

        if (Context != null)
        {
            Context.OnStateChanged -= HandleContextStateChanged;
            Context.ExitAnimation = null;
        }
    }
}
