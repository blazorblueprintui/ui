@typeparam TValue
@namespace BlazorBlueprint.Primitives.Select
@using System.ComponentModel
@using BlazorBlueprint.Primitives.Floating
@using BlazorBlueprint.Primitives.Services
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IFocusManager FocusManager
@implements IAsyncDisposable

@*
    SelectContent primitive - headless dropdown container.
    Uses FloatingPortal for portal/positioning infrastructure.
    Maintains Select-specific behavior: keyboard navigation, item focus, ARIA attributes.
*@

@if (_context != null)
{
    <BbFloatingPortal IsOpen="@(_context.IsOpen)"
                    AnchorElement="@_context.State.TriggerElement"
                    PortalId="@_portalId"
                    Side="@Side"
                    Align="@Align"
                    Offset="@Offset"
                    MatchAnchorWidth="@MatchTriggerWidth"
                    Strategy="PositioningStrategy.Fixed"
                    ZIndex="9999"
                    ForceMount="false"
                    SideElementId="@_context.ContentId"
                    RestoreFocusToId="@_context.TriggerId"
                    RestoreFocusOnClose="@_context.State.RestoreFocusOnClose"
                    Dismiss="@BuildDismissOptions()"
                    Keyboard="@BuildKeyboardOptions()"
                    OnDismiss="@HandleDismiss">
        @RenderSelectListbox()
    </BbFloatingPortal>
}

@code {
    [CascadingParameter]
    private SelectContext<TValue>? _context { get; set; }

    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<BbSelectContent<TValue>>? _dotNetRef;
    private bool _disposed = false;
    private string _portalId = "";

    /// <summary>
    /// Content to render inside the select dropdown.
    /// Typically contains SelectItem components.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional attributes to be applied to the content container.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Preferred side for positioning.
    /// Default is Bottom.
    /// </summary>
    [Parameter]
    public PopoverSide Side { get; set; } = PopoverSide.Bottom;

    /// <summary>
    /// Alignment relative to trigger.
    /// Default is Start.
    /// </summary>
    [Parameter]
    public PopoverAlign Align { get; set; } = PopoverAlign.Start;

    /// <summary>
    /// Offset distance from the trigger element in pixels.
    /// Default is 4.
    /// </summary>
    [Parameter]
    public int Offset { get; set; } = 4;

    /// <summary>
    /// Whether the select content should match the trigger width.
    /// Default is true (common pattern for selects).
    /// </summary>
    [Parameter]
    public bool MatchTriggerWidth { get; set; } = true;

    protected override void OnInitialized()
    {
        if (_context == null)
        {
            throw new InvalidOperationException(
                "SelectContent must be used within a Select component. " +
                "Ensure SelectContent is a child of a Select component.");
        }

        _portalId = $"select-portal-{_context.ContentId}";
        _dotNetRef = DotNetObjectReference.Create(this);

        // Subscribe to context state changes for cleanup
        _context.OnStateChanged += HandleContextStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_jsModule == null)
            {
                _jsModule = await PrimitiveModules.GetAsync(JS);
            }
        }
    }

    private RenderFragment RenderSelectListbox() => builder =>
    {
        // Re-cascade the SelectContext through the portal so SelectItem components can access it
        builder.OpenComponent<CascadingValue<SelectContext<TValue>>>(0);
        builder.AddAttribute(1, "Value", _context);
        builder.AddAttribute(2, "IsFixed", true);
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(contentBuilder =>
        {
            contentBuilder.OpenElement(0, "div");
            contentBuilder.AddAttribute(1, "id", _context!.ContentId);
            contentBuilder.AddAttribute(2, "role", "listbox");
            contentBuilder.AddAttribute(3, "aria-labelledby", _context.TriggerId);
            contentBuilder.AddAttribute(5, "data-select-content", "true");
            contentBuilder.AddAttribute(6, "tabindex", "-1");
            contentBuilder.AddAttribute(7, "data-state", _context.IsOpen ? "open" : "closed");
            // The side it is declared with, not the side it lands on. JS overwrites this the
            // moment it has measured, and keeps it current when a scroll flips the listbox. C#
            // renders a value that never changes so that Blazor emits no diff for it and never
            // takes the attribute back off JS.
            contentBuilder.AddAttribute(8, "data-side", Side.ToValue());
            contentBuilder.AddMultipleAttributes(9, AdditionalAttributes);
            contentBuilder.AddContent(10, ChildContent);
            contentBuilder.CloseElement();
        }));
        builder.CloseComponent();
    };

    // Declared rather than wired, and no longer raised at all from C#.
    //
    // Scrolling the listbox to its selected option and attaching the keyboard handler used to run
    // from the portal's ready callback, which on Blazor Server only fires once the browser has
    // acknowledged the render batch carrying the content. That put both a full round trip behind
    // the list appearing: it showed up unscrolled and deaf to the arrow keys, then caught up.
    //
    // BbFloatingPortal now does them inside the one call that positions and reveals the listbox,
    // before the reveal — so the list is already scrolled and already keyboard-ready the first
    // frame it is on screen.
    private FloatingKeyboardOptions? BuildKeyboardOptions()
    {
        if (_context == null)
        {
            return null;
        }

        // No "have I already attached?" flag, and no side effect here. This runs on every render,
        // not only on the way open, so a flag set on the first render would read as "already
        // attached" by the time the user actually opened the listbox — and the handlers would
        // never be attached at all. select.setupKeyboardNavigation disposes any handler it finds
        // for this content id before attaching, so asking for it on every open is idempotent.
        return new FloatingKeyboardOptions
        {
            Kind = FloatingKeyboardKind.Listbox,
            ContentId = _context.ContentId,
            SelectedValue = _context.State.Value?.ToString(),
            CallbackRef = _dotNetRef
        };
    }

    // Declared rather than wired. BbFloatingPortal registers the listener inside the same interop
    // call that positions and reveals the listbox; wiring it here afterwards cost a network round
    // trip, and until it landed the listbox was on screen and ignored a click outside it.
    //
    // Escape is not listed: the select watches it through select.setupKeyboardNavigation, which
    // also handles Tab and the arrow keys, so a second document listener here would dismiss twice.
    private FloatingDismissOptions? BuildDismissOptions()
    {
        if (_context == null)
        {
            return null;
        }

        return new FloatingDismissOptions
        {
            ContentId = _context.ContentId,
            TriggerId = _context.TriggerId,
            OnOutsideInteraction = true
        };
    }

    private void HandleDismiss(FloatingDismissReason reason)
    {
        if (_disposed || reason != FloatingDismissReason.OutsideInteraction) { return; }

        _context?.Close();
    }

    private void HandleContextStateChanged()
    {
        _ = InvokeAsync(HandleContextStateChangedAsync);
    }

    private Task HandleContextStateChangedAsync()
    {
        try
        {
            // When context closes, clean up
            if (_context?.IsOpen == false)
            {
                // Capture both the trigger ref and the restore flag before teardown.
                // State.TriggerElement is still populated at this point (Close() doesn't
                // clear it), but we read it eagerly in case anything else mutates state.
                // Focus goes back to the trigger inside overlay.close, through the portal's
                // RestoreFocusToId and RestoreFocusOnClose above — for an intentional close
                // only. Awaiting FocusAsync from here was a round trip on every Escape and
                // every selection.
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is ObjectDisposedException or TaskCanceledException)
        {
            // Component may be disposed during async operation
        }

        return Task.CompletedTask;
    }

    // Cleanup has two callers — the context state-change handler when the listbox closes, and
    // DisposeAsync when the component is torn down — and a close racing a teardown puts both in
    // flight at once. Each block therefore takes ownership of what it is about to release,
    // clearing the field before the first await, so the second caller sees nothing to do rather
    // than dereferencing a field the first one nulled while suspended. Reading the field after
    // an await instead threw a NullReferenceException, which no filter here catches, so it
    // escaped DisposeAsync into the renderer's disposal queue and took the circuit down (#441).
    private async Task CleanupAsync()
    {
        // Only disposal reaches here now. A close releases the listbox handlers inside
        // overlay.close, in the same call that hides the element — it used to be a separately
        // awaited interop call, and so a circuit round trip, spent removing two event listeners
        // from an overlay the user had already dismissed.
        var module = _jsModule;
        var contentId = _context?.ContentId;
        if (module != null && contentId != null)
        {
            try
            {
                await module.InvokeVoidAsync("select.cleanupKeyboardNavigation", contentId);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // JS module may be disposed or circuit disconnected
            }
        }
    }

    /// <summary>
    /// Called from JavaScript when the Escape key is pressed.
    /// </summary>
    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public void JsOnEscapeKey()
    {
        if (_disposed) { return; }
        // Escape is an intentional dismiss — return focus to the trigger.
        _context?.Close(restoreFocus: true);
    }

    /// <summary>
    /// Called from JavaScript when the Tab key is pressed.
    /// </summary>
    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public void JsOnTabKey()
    {
        if (_disposed) { return; }
        _context?.Close();
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) { return; }
        _disposed = true;

        if (_context != null)
        {
            _context.OnStateChanged -= HandleContextStateChanged;
        }

        try
        {
            await CleanupAsync();
        }
        catch (Exception)
        {
            // Disposal runs inside the renderer's disposal queue, where anything that escapes
            // is unhandled and tears down the whole circuit. A teardown-time cleanup failure is
            // not worth that, so it stops here — the races it can hit are handled above.
        }



        _dotNetRef?.Dispose();
    }
}
