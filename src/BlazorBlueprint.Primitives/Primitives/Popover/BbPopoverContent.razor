@namespace BlazorBlueprint.Primitives.Popover
@using System.ComponentModel
@using BlazorBlueprint.Primitives.Floating
@using BlazorBlueprint.Primitives.Services
@inject IJSRuntime JSRuntime
@inject IFocusManager FocusManager
@implements IAsyncDisposable

@*
    PopoverContent is the main content container for the popover.
    Uses FloatingPortal for portal/positioning infrastructure.
    Maintains Popover-specific behavior: click-outside, escape key, ARIA attributes.
*@

<BbFloatingPortal IsOpen="@(Context.IsOpen && Context.State.TriggerElement.HasValue)"
                AnchorElement="@Context.State.TriggerElement"
                PortalId="@_portalId"
                Side="@Side"
                Align="@Align"
                Offset="@Offset"
                MatchAnchorWidth="@MatchTriggerWidth"
                Strategy="@Strategy"
                ZIndex="@ZIndex"
                ForceMount="@ForceMount"
                SideElementId="@Context.ContentId"
                ScrollToCurrentIn="@(ScrollToSelected ? Context.ContentId : null)"
                ScrollToCurrentSelector="@ScrollToSelectedSelector"
                Dismiss="@BuildDismissOptions()"
                OnDismiss="@HandleDismissAsync"
                OnReady="@HandleFloatingReady">
    @RenderPopoverContent()
</BbFloatingPortal>

@code {
    [CascadingParameter]
    private PopoverContext Context { get; set; } = null!;

    /// <summary>
    /// The content to render inside the popover.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional attributes to apply to the content container.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Whether to scroll the currently chosen item into view each time the popover opens, before
    /// it is revealed.
    /// </summary>
    /// <remarks>
    /// For list content in a popover — a combobox, for instance — which otherwise reopens at the
    /// top of the list however far down the chosen value sits. The scroll happens in the same
    /// interop call that positions the popover, so it costs no round trip and the list is already
    /// in the right place the first frame it is on screen.
    /// </remarks>
    [Parameter]
    public bool ScrollToSelected { get; set; }

    /// <summary>
    /// CSS selector identifying the chosen item for <see cref="ScrollToSelected"/>.
    /// </summary>
    [Parameter]
    public string ScrollToSelectedSelector { get; set; } = "[role=\"option\"][aria-selected=\"true\"]";

    /// <summary>
    /// Whether pressing Escape should close the popover.
    /// Default is true.
    /// </summary>
    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// Whether clicking outside should close the popover.
    /// Default is true.
    /// </summary>
    [Parameter]
    public bool CloseOnClickOutside { get; set; } = true;

    /// <summary>
    /// Preferred side for positioning.
    /// Default is Bottom.
    /// </summary>
    [Parameter]
    public PopoverSide Side { get; set; } = PopoverSide.Bottom;

    /// <summary>
    /// Alignment relative to trigger.
    /// Default is Center.
    /// </summary>
    [Parameter]
    public PopoverAlign Align { get; set; } = PopoverAlign.Center;

    /// <summary>
    /// Offset distance from the trigger element in pixels.
    /// Default is 4.
    /// </summary>
    [Parameter]
    public int Offset { get; set; } = 4;

    /// <summary>
    /// Whether to match the popover width to the trigger element width.
    /// Default is false.
    /// </summary>
    [Parameter]
    public bool MatchTriggerWidth { get; set; } = false;

    /// <summary>
    /// CSS positioning strategy.
    /// Default is <see cref="PositioningStrategy.Fixed"/> to correctly escape stacking contexts
    /// (e.g. inside Dialog, Sheet, Drawer).
    /// Use <see cref="PositioningStrategy.Absolute"/> only when the popover should scroll with a container.
    /// </summary>
    [Parameter]
    public PositioningStrategy Strategy { get; set; } = PositioningStrategy.Fixed;

    /// <summary>
    /// CSS z-index value for the popover content.
    /// Default is 9999 to render above overlays (Dialog, Sheet, Drawer).
    /// </summary>
    [Parameter]
    public int ZIndex { get; set; } = 9999;

    /// <summary>
    /// Event callback invoked when Escape key is pressed.
    /// </summary>
    [Parameter]
    public EventCallback<KeyboardEventArgs> OnEscapeKeyDown { get; set; }

    /// <summary>
    /// Event callback invoked when clicking outside the popover.
    /// </summary>
    [Parameter]
    public EventCallback OnClickOutside { get; set; }

    /// <summary>
    /// The ARIA role for the popover content.
    /// Default is "dialog" per WAI-ARIA 1.2 for interactive popovers.
    /// Set to null for simple supplemental content that doesn't need a role.
    /// </summary>
    [Parameter]
    public string? Role { get; set; } = "dialog";

    /// <summary>
    /// Whether to keep the content mounted in the DOM when closed.
    /// When true, enables CSS exit animations.
    /// Default is false.
    /// </summary>
    [Parameter]
    public bool ForceMount { get; set; } = false;

    /// <summary>
    /// Event callback invoked when the popover content is fully ready (positioned and visible).
    /// Useful for focus management.
    /// </summary>
    [Parameter]
    public EventCallback OnContentReady { get; set; }

    private bool _disposed = false;
    private string _portalId = "";

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException(
                "PopoverContent must be used within a Popover component. " +
                "Ensure PopoverContent is a child of a Popover component.");
        }

        _portalId = $"popover-portal-{Context.ContentId}";

        // Subscribe to context changes
        Context.OnStateChanged += HandleContextStateChanged;
    }

    private RenderFragment RenderPopoverContent() => __builder =>
    {
        <div id="@Context.ContentId"
             role="@Role"
             tabindex="-1"
             @onkeydown="HandleKeyDown"
             @attributes="AdditionalAttributes"
             data-state="@(Context.IsOpen ? "open" : "closed")"
             data-side="@Side.ToValue()">
            @ChildContent
        </div>
    };

    // data-side is JS's to write now, through SideElementId above. Routing it through C# meant a
    // render batch — a round trip on Blazor Server — to record a measurement the browser had
    // already made, and it landed between computing the position and revealing the element, so a
    // popover that flipped paid for the re-render before anything appeared.

    private async Task HandleFloatingReady()
    {
        // Notify subscribers that content is ready (for focus management, etc.)
        Context.NotifyContentReady();

        // Also invoke the parameter callback if provided
        if (OnContentReady.HasDelegate)
        {
            await OnContentReady.InvokeAsync();
        }
    }

    // Declared rather than wired. BbFloatingPortal registers both listeners inside the same
    // interop call that positions and reveals the content; wiring them here afterwards cost a
    // network round trip each, and until they landed the popover was on screen and ignored a
    // click outside it.
    //
    // Escape is watched at the document, not on the content element. The element handler only
    // sees the key when focus is already inside the popover, and opening one does not move focus
    // — it stays on the trigger, which lives in a different subtree entirely once the content
    // renders through the portal. So the keydown never bubbled anywhere near the content and
    // Escape did nothing, leaving the popover open with its trigger pointer-events-disabled and
    // therefore no way to close it from the keyboard.
    private FloatingDismissOptions? BuildDismissOptions()
    {
        if (!CloseOnClickOutside && !CloseOnEscape)
        {
            return null;
        }

        return new FloatingDismissOptions
        {
            ContentId = Context.ContentId,
            TriggerId = Context.TriggerId,
            OnOutsideInteraction = CloseOnClickOutside,
            OnEscapeKey = CloseOnEscape
        };
    }

    private Task HandleDismissAsync(FloatingDismissReason reason) => reason switch
    {
        FloatingDismissReason.EscapeKey => HandleEscapeDismissAsync(),
        _ => HandleOutsideDismissAsync()
    };

    private async Task HandleEscapeDismissAsync()
    {
        if (_disposed || !Context.IsOpen || !CloseOnEscape) return;

        if (OnEscapeKeyDown.HasDelegate)
        {
            await OnEscapeKeyDown.InvokeAsync(new KeyboardEventArgs { Key = "Escape" });
        }

        // Escape is an intentional dismiss — return focus to the trigger.
        Context.Close(restoreFocus: true);
    }

    private async Task HandleOutsideDismissAsync()
    {
        if (_disposed || !Context.IsOpen) return;

        if (OnClickOutside.HasDelegate)
        {
            await OnClickOutside.InvokeAsync();
        }

        if (CloseOnClickOutside)
        {
            Context.Close();
        }
    }

    private void HandleContextStateChanged()
    {
        _ = InvokeAsync(HandleContextStateChangedAsync);
    }

    private async Task HandleContextStateChangedAsync()
    {
        try
        {
            if (!Context.IsOpen)
            {
                // Capture both the trigger ref and the restore flag before teardown.
                var trigger = Context.State.TriggerElement;
                var shouldRestoreFocus = Context.State.RestoreFocusOnClose;

                StateHasChanged();

                // Restore focus to the trigger AFTER cleanup so the now-unmounted popover
                // isn't the active element when the user next presses Tab. Only restore
                // for intentional closes (Escape) — click-outside leaves focus where the
                // user clicked.
                if (shouldRestoreFocus && trigger.HasValue)
                {
                    await FocusManager.RestoreFocus(trigger);
                }
            }
            else
            {
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is ObjectDisposedException or TaskCanceledException)
        {
            // Component may be disposed during async operation
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            // Invoke custom handler if provided
            if (OnEscapeKeyDown.HasDelegate)
            {
                await OnEscapeKeyDown.InvokeAsync(args);
            }

            // Close popover if configured
            if (CloseOnEscape)
            {
                // Escape is an intentional dismiss — return focus to the trigger.
                Context.Close(restoreFocus: true);
            }
        }
    }

    public ValueTask DisposeAsync()
    {
        if (_disposed) { return ValueTask.CompletedTask; }
        _disposed = true;

        // The dismissal listeners and the .NET reference they call back into both belong to
        // BbFloatingPortal now, and it releases them when the overlay closes. There is nothing
        // left here that could throw into the renderer's disposal queue.
        if (Context != null)
        {
            Context.OnStateChanged -= HandleContextStateChanged;
        }

        return ValueTask.CompletedTask;
    }
}
