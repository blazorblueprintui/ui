@namespace BlazorBlueprint.Primitives.Floating
@inherits BlazorBlueprint.Primitives.BbPrimitiveBase
@using BlazorBlueprint.Primitives.Services
@using Microsoft.Extensions.Logging
@using System.Text.Json
@using System.ComponentModel
@inject IPositioningService PositioningService
@inject IPortalService PortalService
@inject IJSRuntime JSRuntime
@inject ILogger<BbFloatingPortal> Logger
@implements IAsyncDisposable

@*
    FloatingPortal - Unified infrastructure for floating content.
    Handles ONLY: portal registration, positioning, and lifecycle management.
    Does NOT handle: click-outside, keyboard navigation, or any behavior.

    When ForceMount is true (default), portal content stays registered in the DOM
    when closed — hidden via CSS instead of unmounted. This eliminates re-mount
    overhead and enables CSS exit animations via the data-state attribute.

    Use this as the base layer for Select, Popover, DropdownMenu, Tooltip, etc.
*@

@code {
    /// <summary>
    /// The content to render in the floating portal.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether the floating content is currently visible.
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Whether to keep portal content mounted in the DOM when closed.
    /// When true, content is hidden via CSS instead of being unmounted, eliminating
    /// re-mount overhead on each open/close cycle. A <c>data-state</c> attribute
    /// (<c>"open"</c> / <c>"closed"</c>) on the content div enables CSS animations.
    /// Default is true.
    /// </summary>
    [Parameter]
    public bool ForceMount { get; set; } = true;

    /// <summary>
    /// The element to position the floating content relative to.
    /// </summary>
    [Parameter]
    public ElementReference? AnchorElement { get; set; }

    /// <summary>
    /// Dismissal gestures to listen for, wired in the same interop call that opens the overlay.
    /// Leave null and the owner is responsible for its own listeners.
    /// </summary>
    /// <remarks>
    /// The portal reports the gesture through <see cref="OnDismiss"/> and does nothing else with
    /// it — what a dismissal means is the owner's decision.
    /// </remarks>
    [Parameter]
    public FloatingDismissOptions? Dismiss { get; set; }

    /// <summary>
    /// Raised when one of the gestures named by <see cref="Dismiss"/> happens.
    /// </summary>
    [Parameter]
    public EventCallback<FloatingDismissReason> OnDismiss { get; set; }

    /// <summary>
    /// Unique identifier for this portal instance.
    /// Required to prevent conflicts when multiple floating elements exist.
    /// </summary>
    [Parameter]
    public string PortalId { get; set; } = "";

    /// <summary>
    /// Preferred side for positioning.
    /// Default is Bottom.
    /// </summary>
    [Parameter]
    public PopoverSide Side { get; set; } = PopoverSide.Bottom;

    /// <summary>
    /// Alignment relative to anchor element.
    /// Default is Center.
    /// </summary>
    [Parameter]
    public PopoverAlign Align { get; set; } = PopoverAlign.Center;

    /// <summary>
    /// Offset distance from the anchor element in pixels.
    /// Default is 4.
    /// </summary>
    [Parameter]
    public int Offset { get; set; } = 4;

    /// <summary>
    /// Whether to match the floating content width to the anchor element width.
    /// Default is false.
    /// </summary>
    [Parameter]
    public bool MatchAnchorWidth { get; set; } = false;

    /// <summary>
    /// CSS positioning strategy.
    /// Use <see cref="PositioningStrategy.Fixed"/> for dropdowns that need to escape stacking contexts.
    /// Default is <see cref="PositioningStrategy.Absolute"/>.
    /// </summary>
    [Parameter]
    public PositioningStrategy Strategy { get; set; } = PositioningStrategy.Absolute;

    /// <summary>
    /// CSS z-index value for the floating content.
    /// Default is 50.
    /// </summary>
    [Parameter]
    public int ZIndex { get; set; } = 50;

    /// <summary>
    /// Event callback invoked when the floating content is positioned and visible.
    /// Use this to set up keyboard navigation, focus management, etc.
    /// Fires on every open, including re-opens when ForceMount is true.
    /// </summary>
    [Parameter]
    public EventCallback OnReady { get; set; }

    /// <summary>
    /// Event callback invoked when the actual placement changes (e.g., flips from bottom to top).
    /// Passes the final placement string (e.g., "top", "bottom-start", "left-end").
    /// </summary>
    /// <remarks>
    /// Setting this costs a circuit round trip on every open, because JS has to call back into
    /// .NET with the measurement. Prefer <see cref="SideElementId"/> when all that is wanted is a
    /// <c>data-side</c> attribute to style from — JS writes that directly, for free. The callback
    /// fires after the overlay is on screen either way, so it never delays the reveal.
    /// </remarks>
    [Parameter]
    public EventCallback<string> OnPlacementChanged { get; set; }

    /// <summary>
    /// The <c>id</c> of the element that should carry the resolved <c>data-side</c> attribute,
    /// written by JS as soon as the overlay is positioned and kept current when a scroll flips it.
    /// </summary>
    /// <remarks>
    /// The side an overlay lands on is a browser measurement, and the styled layer reads it from
    /// the DOM. Routing it through C# meant a render batch — a round trip on Blazor Server — to
    /// write an attribute the browser already knew, wedged between computing the position and
    /// revealing the element, so an overlay that flipped paid for the re-render before anything
    /// appeared.
    /// </remarks>
    [Parameter]
    public string? SideElementId { get; set; }

    /// <summary>
    /// Asks the portal to wire the content's keyboard behaviour inside the same interop call that
    /// opens it, and to release it inside the one that closes it.
    /// </summary>
    [Parameter]
    public FloatingKeyboardOptions? Keyboard { get; set; }

    /// <summary>
    /// The <c>id</c> of an element to search for the currently chosen item, which is scrolled into
    /// view before the overlay is revealed.
    /// </summary>
    /// <remarks>
    /// For content that shows its chosen value with an icon rather than with <c>aria-selected</c>.
    /// A combobox reads <c>aria-selected</c> as "keyboard-focused", so it has to mark the chosen
    /// item its own way and name that marker through <see cref="ScrollToCurrentSelector"/>.
    /// </remarks>
    [Parameter]
    public string? ScrollToCurrentIn { get; set; }

    /// <summary>
    /// CSS selector for the chosen item inside <see cref="ScrollToCurrentIn"/>. Defaults to the
    /// listbox convention, <c>[role="option"][aria-selected="true"]</c>.
    /// </summary>
    [Parameter]
    public string ScrollToCurrentSelector { get; set; } = "[role=\"option\"][aria-selected=\"true\"]";

    /// <summary>
    /// The <c>id</c> of an element to focus one frame after the overlay is revealed — a search
    /// box, for instance.
    /// </summary>
    /// <remarks>
    /// Inside the open call, and so free. Focusing from a ready callback instead costs a round
    /// trip on Blazor Server before the callback runs, and another for <c>FocusAsync</c>.
    /// </remarks>
    [Parameter]
    public string? AutoFocusId { get; set; }

    /// <summary>
    /// The <c>id</c> of the element to return focus to when the overlay closes — normally the
    /// trigger. Only used when <see cref="RestoreFocusOnClose"/> is true at the time of the close.
    /// </summary>
    [Parameter]
    public string? RestoreFocusToId { get; set; }

    /// <summary>
    /// Whether the close now in progress should return focus to <see cref="RestoreFocusToId"/>.
    /// True for a close the user asked for — Escape, a selection — and false for a click outside,
    /// which leaves focus where the user clicked.
    /// </summary>
    [Parameter]
    public bool RestoreFocusOnClose { get; set; }

    private static readonly Action<ILogger, string, string, Exception?> LogOpenFailed =
        LoggerMessage.Define<string, string>(LogLevel.Warning, new EventId(3, "FloatingPortalOpenFailed"),
            "FloatingPortal '{PortalId}' failed to open: {ErrorMessage}");

    private static readonly Action<ILogger, string, Exception?> LogMissingAnchor =
        LoggerMessage.Define<string>(LogLevel.Warning, new EventId(4, "FloatingPortalMissingAnchor"),
            "FloatingPortal '{PortalId}' has no AnchorElement, so it cannot be positioned.");

    /// <summary>Whether the portal's content is registered with the host.</summary>
    private bool isRegistered;

    /// <summary>Whether overlay.open has been dispatched for this portal and overlay.close has not.</summary>
    private bool isOverlayOpen;

    /// <summary>
    /// Whether overlay.close was dispatched asking for <see cref="JsOnClosed"/> and the callback
    /// has not arrived yet. The callback fires after the exit animation, and a component disposed
    /// in that window — a navigation during the close — would otherwise take the .NET reference
    /// with it and leave JS calling into nothing.
    /// </summary>
    private bool closeCallbackPending;

    /// <summary>Previous <c>IsOpen</c>, so the open and close edges can be told apart.</summary>
    private bool wasOpen;

    /// <summary>
    /// Set when an edge could not be dispatched because the primitive bundle was not imported yet.
    /// <see cref="OnAfterRenderAsync"/> picks it up and pays the import round trip once.
    /// </summary>
    private bool openPending;
    private bool closePending;

    /// <summary>Handed to JS so the dismissal, placement and closed callbacks can call back.</summary>
    private DotNetObjectReference<BbFloatingPortal>? selfRef;

    private bool disposed;

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(PortalId))
        {
            throw new InvalidOperationException(
                "FloatingPortal requires a PortalId to be specified. " +
                "Each floating element must have a unique identifier.");
        }
    }

    /// <summary>
    /// Dispatches the whole open, or the whole close, from the synchronous pass that renders it.
    /// </summary>
    /// <remarks>
    /// <para>
    /// This method is the reason an overlay costs one circuit round trip instead of five. Both
    /// halves of an open — registering the content so the host renders it, and telling JS to
    /// position and reveal it — happen here, synchronously, inside the render cycle the user's
    /// click started. The registration marks the host dirty in time to join the same render batch,
    /// and the interop call is dispatched without being awaited, so it rides out in the same flush
    /// as that batch. The server sends both and waits for neither.
    /// </para>
    /// <para>
    /// None of it can happen in <c>OnAfterRenderAsync</c>, which is where it used to. On Blazor
    /// Server that callback runs only once the browser has acknowledged the render batch, so
    /// anything it does starts a round trip behind the render — and anything it then awaits starts
    /// another one behind that. Four of the five round trips an open used to cost were this
    /// pattern, chained.
    /// </para>
    /// <para>
    /// The cost of dispatching here is that the interop message reaches the browser <em>before</em>
    /// the render batch carrying the content, because the server sent it first. JS waits for the
    /// element rather than being handed one; see <c>overlay.js</c>.
    /// </para>
    /// </remarks>
    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var opening = IsOpen && !wasOpen;
        var closing = !IsOpen && wasOpen;
        wasOpen = IsOpen;

        // ForceMount keeps the content in the DOM across closes, so it registers on first render
        // and stays. Without it the content is registered on the way open and released once the
        // exit animation has finished.
        var justRegistered = (ForceMount || IsOpen) && EnsureRegistered();

        if (opening)
        {
            BeginOpen();
        }
        else if (closing)
        {
            BeginClose();
        }

        // Content updates while mounted — a data-state change, new child content — reach the host
        // through a refresh rather than a re-registration, which would replace the RenderFragment
        // delegate. The existing delegate captures 'this', so the host reads current state from it.
        // The host ignores refreshes raised during its own render cycle, which is what keeps a
        // FloatingPortal nested inside another portal from looping.
        //
        // The open edge needs this too, and skipping it there broke every ForceMount overlay.
        // Their content registers on first render and never re-registers, so the registration's
        // own notification is long spent by the time the user opens one: without a refresh the
        // host never re-rendered, data-state stayed "closed", and the tooltip never appeared.
        // Only a registration raised in this very pass can stand in for it.
        if (isRegistered && !justRegistered)
        {
            PortalService.RefreshPortal(PortalId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Warm the bundle so the first open can dispatch from OnParametersSet like every open
            // after it. Without this the first overlay on a page falls to the slow path below and
            // pays the import as a round trip of its own, in front of the user.
            await WarmModuleAsync();
        }

        // The slow path, and only reached when the bundle was not loaded in time. It costs the
        // round trip that OnParametersSet exists to avoid, once, and warms the cache for next time.
        if (openPending || closePending)
        {
            var wantedOpen = openPending;
            openPending = false;
            closePending = false;

            var module = await TryLoadModuleAsync();
            if (module is not null)
            {
                if (wantedOpen && IsOpen)
                {
                    DispatchOpen(module);
                }
                else if (!wantedOpen && !IsOpen)
                {
                    DispatchClose(module);
                }
            }
        }

        // Deliberately here and not beside the dispatch. OnReady means "the content exists", and
        // an owner is free to do its own interop from it — which is ack-gated and costs a round
        // trip. Owners on the fast path declare what they need through Dismiss and Listbox
        // instead, and those are wired inside the one call that opens the overlay.
        if (IsOpen && isOverlayOpen && !readyRaised && OnReady.HasDelegate)
        {
            readyRaised = true;
            await OnReady.InvokeAsync();
        }
        else if (!IsOpen)
        {
            readyRaised = false;
        }
    }

    private bool readyRaised;

    /// <summary>
    /// Registers the content with the host if it is not registered already.
    /// </summary>
    /// <returns><c>true</c> if it registered in this call, and so raised its own notification.</returns>
    private bool EnsureRegistered()
    {
        if (isRegistered || string.IsNullOrEmpty(PortalId))
        {
            return false;
        }

        isRegistered = true;

        // Synchronous on purpose: this marks the portal host dirty while the current render cycle
        // is still open, so the host's output joins this batch instead of starting another one.
        PortalService.RegisterPortal(PortalId, RenderPortalContent(), PortalCategory.Overlay);
        return true;
    }

    private void BeginOpen()
    {
        readyRaised = false;

        if (AnchorElement is null || !AnchorElement.HasValue)
        {
            LogMissingAnchor(Logger, PortalId, null);
            return;
        }

        isOverlayOpen = true;

        if (PrimitiveModules.TryGetLoaded(JSRuntime, out var module))
        {
            DispatchOpen(module);
        }
        else
        {
            openPending = true;
        }
    }

    private void BeginClose()
    {
        if (!isOverlayOpen)
        {
            return;
        }

        isOverlayOpen = false;

        if (PrimitiveModules.TryGetLoaded(JSRuntime, out var module))
        {
            DispatchClose(module);
        }
        else
        {
            closePending = true;
        }
    }

    private void DispatchOpen(IJSObjectReference module)
    {
        if (AnchorElement is null || !AnchorElement.HasValue)
        {
            return;
        }

        var placement = Align == PopoverAlign.Center ? Side.ToValue() : $"{Side.ToValue()}-{Align.ToValue()}";

        var options = new
        {
            placement,
            offset = Offset,
            matchReferenceWidth = MatchAnchorWidth,
            strategy = Strategy.ToValue(),
            zIndex = ZIndex,
            flip = true,   // Flip to the opposite side when there is not enough space
            shift = true,  // Shift to keep the content inside the viewport
            sideElementId = SideElementId,

            // Opt-in, because it is a call back into .NET and therefore a round trip. It happens
            // after the overlay is on screen, so it delays nothing the user can see — but an owner
            // that only styles itself from the side should name SideElementId and let JS write it.
            reportPlacement = OnPlacementChanged.HasDelegate,

            dismiss = WantsDismissListeners()
                ? new
                {
                    contentId = Dismiss!.ContentId,
                    triggerId = Dismiss.TriggerId,
                    onOutsideInteraction = Dismiss.OnOutsideInteraction,
                    onEscapeKey = Dismiss.OnEscapeKey
                }
                : null,

            scrollToCurrent = ScrollToCurrentIn is not null
                ? new { containerId = ScrollToCurrentIn, selector = ScrollToCurrentSelector }
                : null,

            autoFocusId = AutoFocusId,

            keyboard = Keyboard is not null
                ? new
                {
                    kind = Keyboard.Kind.ToString(),
                    contentId = Keyboard.ContentId,
                    callbackRef = Keyboard.CallbackRef,
                    selectedValue = Keyboard.SelectedValue,
                    loop = Keyboard.Loop,
                    mode = Keyboard.Mode
                }
                : null
        };

        Dispatch(module, "overlay.open", PortalId, AnchorElement.Value, options, SelfRef());
    }

    private void DispatchClose(IJSObjectReference module)
    {
        // ForceMount content stays in the DOM, so nobody needs telling when the animation is over.
        // Without it the content is unmounted, and that has to wait for the animation — otherwise
        // the element is gone before it can play.
        var options = new
        {
            notifyClosed = !ForceMount,

            // Released in the same call that hides the element. The owner used to await its own
            // interop call to drop these handlers, which is a round trip spent removing an event
            // listener from an overlay the user has already dismissed.
            keyboard = Keyboard is not null
                ? new { kind = Keyboard.Kind.ToString(), contentId = Keyboard.ContentId }
                : null,

            // Read now, during the close render, when the owner's state says which kind of close
            // this is. The owner used to await FocusAsync itself after its close render — a round
            // trip, on every Escape and every selection.
            restoreFocusToId = RestoreFocusOnClose ? RestoreFocusToId : null
        };

        closeCallbackPending = !ForceMount;
        Dispatch(module, "overlay.close", PortalId, options, SelfRef());
    }

    /// <summary>
    /// Sends an interop call without awaiting it, swallowing the failures a teardown produces.
    /// </summary>
    /// <remarks>
    /// Not awaiting is the whole point — an awaited call is a round trip. The trade is that a
    /// failure has no caller to report to, so every one of them is logged here instead.
    /// </remarks>
    private void Dispatch(IJSObjectReference module, string identifier, params object?[] args)
        => _ = DispatchAsync(module, identifier, args);

    private async Task DispatchAsync(IJSObjectReference module, string identifier, object?[] args)
    {
        try
        {
            await module.InvokeVoidAsync(identifier, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
        {
            // Circuit gone, or the element torn down before the call landed. Nothing to report.
        }
        catch (Exception ex)
        {
            LogOpenFailed(Logger, PortalId, ex.Message, ex);
        }
    }

    private async Task WarmModuleAsync()
    {
        try
        {
            await PrimitiveModules.GetAsync(JSRuntime);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            // Prerendering, or a circuit that went away. The next open retries.
        }
    }

    private async Task<IJSObjectReference?> TryLoadModuleAsync()
    {
        try
        {
            return await PrimitiveModules.GetAsync(JSRuntime);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            return null;
        }
    }

    private RenderFragment RenderPortalContent() => __builder =>
    {
        <div @attributes="FilteredAttributes"
             data-portal-content="true"
             data-bb-portal="@PortalId"
             data-state="@(IsOpen ? "open" : "closed")"
             style="@GetMergedStyle()">
            @ChildContent
        </div>
    };

    private bool WantsDismissListeners()
        => Dismiss is not null && (Dismiss.OnOutsideInteraction || Dismiss.OnEscapeKey);

    private DotNetObjectReference<BbFloatingPortal> SelfRef()
        => selfRef ??= DotNetObjectReference.Create(this);

    /// <summary>
    /// Called from JavaScript when the user interacts outside the content and its trigger.
    /// </summary>
    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public Task JsOnDismissOutside() => RaiseDismissAsync(FloatingDismissReason.OutsideInteraction);

    /// <summary>
    /// Called from JavaScript when Escape is pressed anywhere in the document.
    /// </summary>
    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public Task JsOnDismissEscape() => RaiseDismissAsync(FloatingDismissReason.EscapeKey);

    /// <summary>
    /// Called from JavaScript once the overlay is positioned, with the side it actually landed on.
    /// </summary>
    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public Task JsOnPlacementChanged(string placement)
    {
        if (disposed || !OnPlacementChanged.HasDelegate)
        {
            return Task.CompletedTask;
        }

        return OnPlacementChanged.InvokeAsync(placement);
    }

    /// <summary>
    /// Called from JavaScript once the exit animation has finished and the content is hidden.
    /// </summary>
    /// <remarks>
    /// Only for the non-<see cref="ForceMount"/> case, where the content is unmounted rather than
    /// hidden. The unmount cannot share the close's render — the element has to survive long
    /// enough to animate — so it lands here instead, one round trip later, behind an overlay the
    /// user already cannot see.
    /// </remarks>
    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public Task JsOnClosed()
    {
        closeCallbackPending = false;

        if (disposed || IsOpen || ForceMount || !isRegistered)
        {
            return Task.CompletedTask;
        }

        isRegistered = false;
        PortalService.UnregisterPortal(PortalId);
        return Task.CompletedTask;
    }

    private Task RaiseDismissAsync(FloatingDismissReason reason)
    {
        // The listeners outlive a close by as long as it takes overlay.close to run, so a gesture
        // can arrive for an overlay that is already on its way out.
        if (disposed || !IsOpen || !OnDismiss.HasDelegate)
        {
            return Task.CompletedTask;
        }

        return OnDismiss.InvokeAsync(reason);
    }

    /// <summary>
    /// The style the content is parked in: off screen, invisible and inert.
    /// </summary>
    /// <remarks>
    /// <para>
    /// It never changes, and that is the point. JS positions and reveals the element by writing
    /// straight onto it, and Blazor diffs the <c>style</c> attribute against what it last
    /// <em>rendered</em> rather than against the DOM — so as long as this string is constant,
    /// Blazor emits no update for it and never fights the values JS wrote. The close is the mirror:
    /// <c>hidePosition</c> writes these same values back, explicitly, because rendering them would
    /// produce no diff and therefore no change at all.
    /// </para>
    /// <para>
    /// It used to hold the computed coordinates, so that C# could re-render the element without
    /// losing its position. That required C# to know the position, which required awaiting the
    /// call that computed it — a round trip, on every open, before the overlay appeared.
    /// </para>
    /// <para>
    /// <c>position: fixed</c> with off-screen coordinates, rather than <c>display: none</c>:
    /// the content has to be measurable before it is placed, and a hidden element measures zero.
    /// <c>visibility</c> keeps it out of the way without the browser scrolling to it, and
    /// <c>pointer-events: none</c> stops it swallowing a click on its way in or out.
    /// </para>
    /// </remarks>
    private string GetParkedStyle()
        => FormattableString.Invariant(
            $"position: fixed; z-index: {ZIndex}; top: -9999px; left: -9999px; visibility: hidden; opacity: 0; pointer-events: none;");

    private string GetMergedStyle()
    {
        var baseStyle = GetParkedStyle();

        if (AdditionalAttributes != null && AdditionalAttributes.TryGetValue("style", out var userStyle))
        {
            return $"{userStyle}; {baseStyle}";
        }

        return baseStyle;
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;

        // Also sent when a close is still animating in the browser. overlay.close invalidates the
        // earlier call's token, so its JsOnClosed callback is dropped instead of reaching a
        // reference that is about to be disposed (it logged "close callback failed" on every
        // navigation away from an open overlay).
        if ((isOverlayOpen || closeCallbackPending) && PrimitiveModules.TryGetLoaded(JSRuntime, out var module))
        {
            isOverlayOpen = false;
            closeCallbackPending = false;

            try
            {
                // Awaited here, unlike every other close: disposal is the one path with nothing
                // left to render, so there is no round trip to save, and the listeners must be
                // gone before the component is.
                await module.InvokeVoidAsync("overlay.close", PortalId, new { notifyClosed = false }, null);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // Circuit gone or element already torn down — nothing left to hide.
            }
        }

        if (isRegistered && !string.IsNullOrEmpty(PortalId))
        {
            isRegistered = false;
            PortalService.UnregisterPortal(PortalId);
        }

        selfRef?.Dispose();
        selfRef = null;
    }
}
