@namespace BlazorBlueprint.Primitives.ContextMenu
@using BlazorBlueprint.Primitives.Menu
@using BlazorBlueprint.Primitives.Services
@using System.ComponentModel
@inherits BlazorBlueprint.Primitives.BbPrimitiveBase
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@*
    ContextMenu content - the menu panel positioned at click coordinates.
    Handles keyboard navigation via menu-keyboard.js and escape key dismiss.
*@

@if (Context?.IsPresent == true)
{
    <div @ref="overlayRef"
         style="position: fixed; inset: 0; z-index: 40;@((Context?.IsOpen ?? false) ? string.Empty : " pointer-events: none;")"
         @onclick="HandleOverlayClick"
         @onclick:stopPropagation="true"
         @oncontextmenu="HandleOverlayContextMenu"
         @oncontextmenu:preventDefault="true">
    </div>
    <div @ref="contentRef"
         role="menu"
         tabindex="-1"
         data-state="@(Context!.IsOpen ? "open" : "closed")"
         style="@MergedContentStyle"
         @onclick:stopPropagation="true"
         @oncontextmenu:preventDefault="true"
         @attributes="FilteredAttributes">
        <CascadingValue Value="menuScope" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
}

@code {
    private MenuScope menuScope = null!;
    private ElementReference overlayRef;
    private ElementReference contentRef;
    private IJSObjectReference? menuKeyboardModule;
    private DotNetObjectReference<BbContextMenuContent>? dotNetRef;
    private readonly string instanceId = Guid.NewGuid().ToString("N")[..8];
    private bool disposed;
    private bool wasOpen;
    private bool _exitWaitStarted;

    [CascadingParameter]
    private BbContextMenu? Context { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        menuScope = new MenuScope(() => Context?.IsOpen == true, () => Context?.Close() ?? Task.CompletedTask);

        if (Context == null)
        {
            throw new InvalidOperationException(
                "BbContextMenuContent must be used within a BbContextMenu component.");
        }
    }

    /// <summary>
    /// The menu content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether keyboard navigation loops from last to first item.
    /// </summary>
    [Parameter]
    public bool Loop { get; set; } = true;

    private string ContentStyle => $"position: fixed; left: {Context?.X}px; top: {Context?.Y}px; z-index: 50";

    private string? MergedContentStyle => MergeStyles(ContentStyle);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Context?.IsOpen == true && (!wasOpen || Context.NeedsFocus))
        {
            wasOpen = true;
            _exitWaitStarted = false;
            if (Context != null)
            {
                Context.NeedsFocus = false;
            }

            try
            {
                menuKeyboardModule ??= await PrimitiveModules.GetAsync(JSRuntime);
                dotNetRef ??= DotNetObjectReference.Create(this);

                // initialize() disposes any existing instance before re-initializing,
                // so this is safe to call when re-opening at a new position.
                // Clamp before focusing: the menu is placed at raw pointer coordinates, so near a
                // viewport edge it would otherwise open partly off-screen and scroll on focus.
                await menuKeyboardModule.InvokeVoidAsync("menuKeyboard.clampToViewport", contentRef, Context!.X, Context.Y, 8);
                await menuKeyboardModule.InvokeVoidAsync("menuKeyboard.initialize", contentRef, dotNetRef, instanceId,
                    new { mode = "vertical", loop = Loop, initialFocus = "first" });
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // Expected during circuit disconnect or module loading failure
            }
            catch (InvalidOperationException)
            {
                // JS interop not available during prerendering
            }
        }
        else if (Context?.IsOpen != true && wasOpen)
        {
            wasOpen = false;
            await CleanupKeyboardAsync();

            // Closing (or already closed but still mounted). The context keeps IsPresent set until
            // the exit animation finishes, so the overlay and content are unmounted only after the
            // close render has played.
            if (Context != null && Context.IsPresent && !_exitWaitStarted)
            {
                _exitWaitStarted = true;
                await WaitForExitThenCompleteAsync();
            }
        }
    }

    private async Task WaitForExitThenCompleteAsync()
    {
        await OverlayExit.WaitAsync(JSRuntime, contentRef, OverlayExit.FadeFallbackDelay);

        if (disposed || Context?.IsOpen == true)
        {
            return;
        }

        Context?.CompleteClose();
        StateHasChanged();
    }

    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public async Task JsOnEscapeKey()
    {
        if (disposed)
        {
            return;
        }

        if (Context != null)
        {
            await Context.Close();
        }
    }

    private async Task CleanupKeyboardAsync()
    {
        if (menuKeyboardModule != null)
        {
            try
            {
                await menuKeyboardModule.InvokeVoidAsync("menuKeyboard.dispose", instanceId);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
                // Expected during cleanup
            }
        }
    }

    private async Task HandleOverlayClick()
    {
        if (Context != null)
        {
            await Context.Close();
        }
    }

    private async Task HandleOverlayContextMenu(MouseEventArgs e)
    {
        if (Context != null)
        {
            await Context.Close();
        }
    }

    public async ValueTask DisposeAsync()
    {
        GC.SuppressFinalize(this);
        disposed = true;

        await CleanupKeyboardAsync();


        dotNetRef?.Dispose();
    }
}
