@namespace BlazorBlueprint.Primitives.ContextMenu
@using System.ComponentModel
@using BlazorBlueprint.Primitives.Utilities
@implements IAsyncDisposable

@*
    ContextMenu primitive - headless context menu triggered by right-click.
    Manages open/close state and position coordinates.
*@

<CascadingValue Value="this" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>
    /// The child content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Controls whether the context menu is open (controlled mode).
    /// </summary>
    [Parameter]
    public bool? Open { get; set; }

    /// <summary>
    /// Event callback invoked when the open state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Gets whether the context menu is open.
    /// </summary>
    public bool IsOpen { get; private set; }

    /// <summary>
    /// Gets the X coordinate where the context menu was triggered.
    /// </summary>
    public double X { get; private set; }

    /// <summary>
    /// Gets the Y coordinate where the context menu was triggered.
    /// </summary>
    public double Y { get; private set; }

    internal bool NeedsFocus { get; set; }

    /// <summary>Gets whether the menu is playing its closed-state exit animation. While set, the
    /// overlay and content stay mounted with <c>data-state="closed"</c> so their animate-out
    /// classes get a window to run in, then <see cref="CompleteClose"/> clears it to unmount.</summary>
    internal bool IsAnimatingOut => exit.IsAnimatingOut;

    /// <summary>Gets whether the menu should be present in the DOM: open, or playing its exit animation.</summary>
    internal bool IsPresent => exit.IsPresent(IsOpen);

    private readonly ExitAnimationGate exit = new();

    private bool disposed;

    protected override void OnParametersSet()
    {
        if (Open is { } open)
        {
            var wasOpen = IsOpen;
            NeedsFocus = open && !wasOpen;
            IsOpen = open;

            if (open)
            {
                exit.Cancel();
            }
            else if (wasOpen)
            {
                exit.Begin();
            }
        }
    }

    /// <summary>
    /// Opens the context menu at the specified coordinates.
    /// </summary>
    public async Task OpenAt(double x, double y)
    {
        X = x;
        Y = y;
        IsOpen = true;
        NeedsFocus = true;
        exit.Cancel();

        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(true);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Closes the context menu, keeping the overlay and content mounted for their exit animation.
    /// </summary>
    public async Task Close()
    {
        if (!IsOpen)
        {
            return;
        }

        IsOpen = false;
        exit.Begin();

        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(false);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Ends the exit animation, allowing the overlay and content to unmount. No-op while the menu
    /// is open, so a reopen that beats the animation to the punch keeps the menu mounted.
    /// </summary>
    internal void CompleteClose() =>
        _ = exit.CompleteClose(IsOpen);

    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public async Task JsOnClickOutside()
    {
        if (disposed)
        {
            return;
        }

        await Close();
    }

    public ValueTask DisposeAsync()
    {
        GC.SuppressFinalize(this);
        disposed = true;
        return ValueTask.CompletedTask;
    }
}
