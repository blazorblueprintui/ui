@namespace BlazorBlueprint.Primitives.ContextMenu
@using System.ComponentModel
@using BlazorBlueprint.Primitives.Utilities
@implements IAsyncDisposable

@*
    ContextMenu primitive - headless context menu triggered by right-click.
    Manages open/close state and position coordinates.
*@

<CascadingValue Value="this" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>
    /// The child content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Controls whether the context menu is open (controlled mode).
    /// </summary>
    [Parameter]
    public bool? Open { get; set; }

    /// <summary>
    /// Event callback invoked when the open state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Gets whether the context menu is open.
    /// </summary>
    public bool IsOpen { get; private set; }

    /// <summary>
    /// Gets the X coordinate where the context menu was triggered.
    /// </summary>
    public double X { get; private set; }

    /// <summary>
    /// Gets the Y coordinate where the context menu was triggered.
    /// </summary>
    public double Y { get; private set; }

    internal bool NeedsFocus { get; set; }

    /// <summary>
    /// The exit animation registered by the content, or null when the menu leaves the page as soon
    /// as it closes.
    /// </summary>
    internal Func<Func<bool>, Task>? ExitAnimation
    {
        get => exit.ExitAnimation;
        set => exit.ExitAnimation = value;
    }

    /// <summary>
    /// Gets whether the menu has closed but is still on the page, playing its exit animation.
    /// </summary>
    internal bool IsExiting => exit.IsAnimatingOut;

    /// <summary>
    /// Gets whether the menu's overlay and content should be rendered: while it is open, and while
    /// its exit animation plays.
    /// </summary>
    internal bool IsPresent => exit.IsPresent(IsOpen);

    private readonly ExitAnimationGate exit = new();

    private bool disposed;

    protected override void OnParametersSet()
    {
        if (Open is { } open)
        {
            NeedsFocus = open && !IsOpen;

            // A controlled change bypasses OpenAt/Close, so start or drop the exit here while the
            // content is still rendered.
            if (open && !IsOpen)
            {
                exit.Cancel();
            }
            else if (!open && IsOpen)
            {
                BeginExit();
            }

            IsOpen = open;
        }
    }

    private void BeginExit() =>
        exit.Begin(() => _ = InvokeAsync(StateHasChanged));

    /// <summary>
    /// Opens the context menu at the specified coordinates.
    /// </summary>
    public async Task OpenAt(double x, double y)
    {
        exit.Cancel();
        X = x;
        Y = y;
        IsOpen = true;
        NeedsFocus = true;

        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(true);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Closes the context menu, keeping its content mounted until the exit animation ends.
    /// </summary>
    public async Task Close()
    {
        if (IsOpen)
        {
            BeginExit();
        }

        IsOpen = false;

        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(false);
        }

        StateHasChanged();
    }

    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public async Task JsOnClickOutside()
    {
        if (disposed)
        {
            return;
        }

        await Close();
    }

    public ValueTask DisposeAsync()
    {
        GC.SuppressFinalize(this);
        disposed = true;
        return ValueTask.CompletedTask;
    }
}
