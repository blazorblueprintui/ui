<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- NuGet Package Configuration -->
    <PackageId>BlazorBlueprint.Primitives</PackageId>
    <RootNamespace>BlazorBlueprint.Primitives</RootNamespace>
    <AssemblyName>BlazorBlueprint.Primitives</AssemblyName>
    <Description>Headless, unstyled Blazor primitive components with ARIA attributes and keyboard support. Build your own component library using these composable primitives.</Description>
    <PackageTags>blazor;primitives;headless;ui;components;accessibility;radix;unstyled;aria</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- <PackageIcon>icon.png</PackageIcon> -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://blazorblueprintui.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/blazorblueprintui/ui</RepositoryUrl>
    <Authors>Mathew Taylor</Authors>
    <Copyright>Copyright (c) 2025-present Mathew Taylor</Copyright>

    <!-- MinVer Configuration - Version from git tags -->
    <MinVerTagPrefix>primitives/v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>beta.0</MinVerDefaultPreReleaseIdentifiers>

    <!-- NuGet rejects a package whose release notes run past 35,000 characters, and the push is
         the first step that says so - after the tag is cut, the build has run and the package has
         been packed. Truncating here turns that into a shorter set of notes rather than a failed
         release. -->
    <_ReleaseNotesFile>$(MSBuildThisFileDirectory)RELEASE_NOTES.md</_ReleaseNotesFile>
    <_ReleaseNotesText Condition="Exists('$(_ReleaseNotesFile)')">$([System.IO.File]::ReadAllText('$(_ReleaseNotesFile)'))</_ReleaseNotesText>
    <_ReleaseNotesLimit>34500</_ReleaseNotesLimit>
    <PackageReleaseNotes Condition="'$(_ReleaseNotesText)' != '' And $(_ReleaseNotesText.Length) &lt;= $(_ReleaseNotesLimit)">$(_ReleaseNotesText)</PackageReleaseNotes>
    <PackageReleaseNotes Condition="'$(_ReleaseNotesText)' != '' And $(_ReleaseNotesText.Length) &gt; $(_ReleaseNotesLimit)">$(_ReleaseNotesText.Substring(0, $(_ReleaseNotesLimit)))

Truncated to fit NuGet's release-note limit. The full list is in the changelog:
https://github.com/blazorblueprintui/ui/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!-- Suppress CA1716: 'Select' namespace matches a keyword but is a domain term -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="MinVer" Version="5.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
