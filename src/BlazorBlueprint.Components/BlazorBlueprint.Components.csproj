<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- NuGet Package Configuration -->
    <PackageId>BlazorBlueprint.Components</PackageId>
    <AssemblyName>BlazorBlueprint.Components</AssemblyName>
    <RootNamespace>BlazorBlueprint.Components</RootNamespace>
    <Description>Pre-styled Blazor components built with shadcn/ui design and Tailwind CSS. Beautiful defaults that you can customize to match your brand.</Description>
    <PackageTags>blazor;ui;components;shadcn;tailwind;styled;design-system</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- <PackageIcon>icon.png</PackageIcon> -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://blazorblueprintui.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/blazorblueprintui/ui</RepositoryUrl>
    <Authors>Mathew Taylor</Authors>
    <Copyright>Copyright (c) 2025-present Mathew Taylor</Copyright>
    <!-- NuGet rejects a package whose release notes run past 35,000 characters, and the push is
         the first step that says so - after the tag is cut, the build has run and the package has
         been packed. Truncating here turns that into a shorter set of notes rather than a failed
         release. -->
    <_ReleaseNotesFile>$(MSBuildThisFileDirectory)RELEASE_NOTES.md</_ReleaseNotesFile>
    <_ReleaseNotesText Condition="Exists('$(_ReleaseNotesFile)')">$([System.IO.File]::ReadAllText('$(_ReleaseNotesFile)'))</_ReleaseNotesText>
    <_ReleaseNotesLimit>34500</_ReleaseNotesLimit>
    <PackageReleaseNotes Condition="'$(_ReleaseNotesText)' != '' And $(_ReleaseNotesText.Length) &lt;= $(_ReleaseNotesLimit)">$(_ReleaseNotesText)</PackageReleaseNotes>
    <PackageReleaseNotes Condition="'$(_ReleaseNotesText)' != '' And $(_ReleaseNotesText.Length) &gt; $(_ReleaseNotesLimit)">$(_ReleaseNotesText.Substring(0, $(_ReleaseNotesLimit)))

Truncated to fit NuGet's release-note limit. The full list is in the changelog:
https://github.com/blazorblueprintui/ui/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!-- MinVer Configuration - Version from git tags -->
    <MinVerTagPrefix>components/v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>beta.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stay on 9.1.x or later: the 9.0.x line hard-pins AngleSharp to the vulnerable
         0.17.1 (GHSA-pgww-w46g-26qg), and the pin is exact, so the transitive cannot be
         lifted from here. 9.1.x resolves AngleSharp 1.x, which carries the fix. -->
    <PackageReference Include="HtmlSanitizer" Version="9.1.982" />
    <PackageReference Include="TailwindMerge.NET" Version="1.3.0" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="MinVer" Version="5.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Use ProjectReference for local development, PackageReference for packing.
       The release scripts update the Primitives PackageReference below to the selected
       published version, then pass -p:UsePackageReferences=true.
       Otherwise ProjectReference keeps the package dependency aligned with the source build. NU5104 is suppressed because
       TreatWarningsAsErrors promotes it to an error when packing with ProjectReference
       during development; the release script handles this correctly via UsePackageReferences. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="..\BlazorBlueprint.Icons.Lucide\BlazorBlueprint.Icons.Lucide.csproj" />
    <ProjectReference Include="..\BlazorBlueprint.Primitives\BlazorBlueprint.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="BlazorBlueprint.Icons.Lucide" Version="2.0.0" />
    <PackageReference Include="BlazorBlueprint.Primitives" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Prevent wwwroot files from being packed as NuGet contentFiles.
       They are already served via the RCL static web assets mechanism (staticwebassets/).
       Including both causes duplicate asset conflicts in .NET 10 SDK when multiple
       projects in the same solution reference this package. -->
  <ItemGroup>
    <Content Update="wwwroot\**" Pack="false" />
  </ItemGroup>

  <Import Project="..\..\tools\tailwind.targets" />
</Project>
