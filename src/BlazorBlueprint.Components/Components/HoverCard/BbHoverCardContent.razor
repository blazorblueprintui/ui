@namespace BlazorBlueprint.Components

@*
    Styled HoverCardContent component.
    Wraps the HoverCardContent primitive with shadcn/ui styling.
*@

<BlazorBlueprint.Primitives.HoverCard.BbHoverCardContent Side="@Side"
                                                      Align="@Align"
                                                      Offset="@Offset"
                                                      class="@CssClass"
                                                      @attributes="AdditionalAttributes">
    @ChildContent
</BlazorBlueprint.Primitives.HoverCard.BbHoverCardContent>

@code {
    /// <summary>
    /// The child content to render inside the hover card.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Preferred side for positioning.
    /// </summary>
    [Parameter]
    public PopoverSide Side { get; set; } = PopoverSide.Bottom;

    /// <summary>
    /// Alignment relative to trigger.
    /// </summary>
    [Parameter]
    public PopoverAlign Align { get; set; } = PopoverAlign.Center;

    /// <summary>
    /// Offset distance from trigger in pixels.
    /// </summary>
    [Parameter]
    public int Offset { get; set; } = 4;

    /// <summary>
    /// Additional CSS classes to apply to the content.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => ClassNames.cn(
        "bb:z-50 bb:w-64 bb:rounded-md bb:border bb:bg-popover bb:p-4 bb:text-popover-foreground bb:shadow-md bb:outline-none",
        "bb:data-[state=open]:animate-in bb:data-[state=closed]:animate-out",
        "bb:data-[state=closed]:fade-out-0 bb:data-[state=open]:fade-in-0",
        "bb:data-[state=closed]:zoom-out-95 bb:data-[state=open]:zoom-in-95",
        "bb:data-[side=bottom]:slide-in-from-top-2 bb:data-[side=left]:slide-in-from-right-2",
        "bb:data-[side=right]:slide-in-from-left-2 bb:data-[side=top]:slide-in-from-bottom-2",
        Class
    );
}
