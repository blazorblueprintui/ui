@namespace BlazorBlueprint.Components
@typeparam TItem
@using BlazorBlueprint.Primitives.Gantt
@using BlazorBlueprint.Icons.Lucide.Components
@inject IBbLocalizer Localizer

@*
    Gantt — a task list and a timeline sharing one table.

    The column declarations render into a hidden box first: a column has to run its lifecycle to
    register itself, and only then is there a task list to measure the timeline against.
*@

<div class="@RootClass" data-slot="gantt" @attributes="AdditionalAttributes">

    <div class="bb:hidden">
        <CascadingValue Value="this" IsFixed="true">
            @if (Columns is not null)
            {
                @Columns
            }
            else
            {
                <BbGanttColumn TItem="TItem" Title="@Localizer["Gantt.Task"]" Width="240" IsTree="true" />
            }
        </CascadingValue>
    </div>

    @if (ShowToolbar)
    {
        <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Small"
                      OnClick="GoToTodayAsync"
                      aria-label="@Localizer["Gantt.Today"]">
                <LucideIcon Name="calendar-days" Size="16" Class="bb:me-2" />
                @Localizer["Gantt.Today"]
            </BbButton>

            <BbButton Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.Small"
                      OnClick="ExpandAllAsync"
                      aria-label="@Localizer["Gantt.ExpandAll"]">
                <LucideIcon Name="unfold-vertical" Size="16" Class="bb:me-2" />
                @Localizer["Gantt.ExpandAll"]
            </BbButton>

            <BbButton Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.Small"
                      OnClick="CollapseAllAsync"
                      aria-label="@Localizer["Gantt.CollapseAll"]">
                <LucideIcon Name="fold-vertical" Size="16" Class="bb:me-2" />
                @Localizer["Gantt.CollapseAll"]
            </BbButton>

            @if (ShowZoomControls)
            {
                <div class="bb:ms-auto bb:flex bb:items-center bb:gap-1" role="group" aria-label="@Localizer["Gantt.Zoom"]">
                    @foreach (var level in Enum.GetValues<GanttZoom>())
                    {
                        var isCurrent = level == Zoom;
                        <BbButton Variant="@(isCurrent ? ButtonVariant.Default : ButtonVariant.Ghost)"
                                  Size="ButtonSize.Small"
                                  OnClick="@(() => SetZoomAsync(level))"
                                  aria-pressed="@isCurrent.ToString().ToLowerInvariant()">
                            @Localizer[$"Gantt.Zoom{level}"]
                        </BbButton>
                    }
                </div>
            }
        </div>
    }

    @if (buildError is not null)
    {
        <p role="alert" class="bb:text-sm bb:text-destructive">@buildError</p>
    }
    else if (Loading)
    {
        <div class="bb:flex bb:items-center bb:gap-2 bb:py-8 bb:text-sm bb:text-muted-foreground">
            <BbSpinner Size="SpinnerSize.Small" />
            <span>@Localizer["Gantt.Loading"]</span>
        </div>
    }
    else if (chart is null || chart.IsEmpty)
    {
        <p class="bb:py-8 bb:text-center bb:text-sm bb:text-muted-foreground">
            @(EmptyMessage ?? Localizer["Gantt.Empty"])
        </p>
    }
    else
    {
        var axis = chart.Axis;
        var slotWidth = EffectiveSlotWidth;
        var treeWidth = TreeWidth;
        var timelineWidth = TimelineWidth;
        var today = TodayLine();
        var treeColumn = TreeColumn;

        <div @ref="rootElement"
             id="@chartId"
             data-gantt-root
             data-slot-width="@slotWidth"
             data-snap="@(SnapToSlot ? "true" : "false")"
             data-allow-drag="@(AllowDrag ? "true" : "false")"
             data-allow-resize="@(AllowResize ? "true" : "false")"
             data-allow-progress="@(AllowProgressDrag ? "true" : "false")"
             data-allow-link="@(AllowLinking ? "true" : "false")"
             data-allow-row-drag="@(AllowRowDrag ? "true" : "false")"
             data-row-height="@RowHeight"
             class="bb:overflow-auto bb:rounded-md bb:border bb:border-border"
             style="@(Height is { Length: > 0 } height ? $"height:{height};" : string.Empty)">

            @*
                A content box the size of the whole chart. The drawing layer is positioned against
                this rather than against the scroller, so it travels with the bars instead of
                staying pinned to the window.
            *@
            <div class="bb:relative" style="@ContentStyle()">
            <table class="bb:border-separate bb:border-spacing-0 bb:text-sm"
                   style="@TableStyle()"
                   aria-label="@AriaLabel">
                <colgroup>
                    @foreach (var column in DeclaredColumns)
                    {
                        <col data-column-id="@column.EffectiveKey" style="@ColumnWidthStyle(column)" />
                    }
                    @for (var slot = 0; slot < axis.SlotCount; slot++)
                    {
                        <col style="@SlotWidthStyle()" />
                    }
                </colgroup>

                <thead>
                    <tr>
                        @{
                            var headerOffset = 0;
                        }
                        @foreach (var column in DeclaredColumns)
                        {
                            var offset = headerOffset;
                            var isSorted = string.Equals(sortKey, column.EffectiveKey, StringComparison.Ordinal);
                            headerOffset += column.EffectiveWidth;

                            <th rowspan="@HeaderTiers"
                                scope="col"
                                data-column-id="@column.EffectiveKey"
                                class="bb:sticky bb:top-0 bb:z-40 bb:border-b bb:border-border bb:bg-surface bb:px-3 bb:text-start bb:font-medium bb:text-muted-foreground @(headerOffset >= treeWidth ? "bb:border-e" : string.Empty)"
                                style="@HeaderCellStyle(offset)"
                                aria-sort="@(isSorted ? (sortDescending ? "descending" : "ascending") : "none")">
                                <div class="bb:relative bb:flex bb:h-full bb:items-center">
                                    @if (column.Sortable)
                                    {
                                        <button type="button"
                                                class="bb:flex bb:items-center bb:gap-1 bb:truncate bb:hover:text-foreground"
                                                @onclick="@(() => SortByAsync(column))">
                                            <span class="bb:truncate">@column.Title</span>
                                            @if (isSorted)
                                            {
                                                <LucideIcon Name="@(sortDescending ? "arrow-down" : "arrow-up")" Size="13" />
                                            }
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="bb:truncate">@column.Title</span>
                                    }

                                    @if (Resizable)
                                    {
                                        <div class="bb:absolute bb:end-0 bb:top-0 bb:bottom-0 bb:w-2 bb:cursor-col-resize bb:hover:bg-primary/20 bb:active:bg-primary/40"
                                             data-resize-handle="@column.EffectiveKey"></div>
                                    }
                                </div>
                            </th>
                        }

                        @if (axis.Major.Count > 0)
                        {
                            @foreach (var slot in axis.Major)
                            {
                                <th colspan="@slot.Span"
                                    scope="col"
                                    class="bb:sticky bb:top-0 bb:z-30 bb:border-b bb:border-e bb:border-border bb:bg-surface bb:px-2 bb:text-start bb:text-xs bb:font-medium bb:text-muted-foreground"
                                    style="@TierStyle()">
                                    <span class="bb:sticky bb:inline-block bb:truncate" style="@MajorLabelStyle()">@slot.Label</span>
                                </th>
                            }
                        }
                        else
                        {
                            @foreach (var slot in axis.Minor)
                            {
                                <th scope="col"
                                    class="bb:sticky bb:top-0 bb:z-30 bb:border-b bb:border-border bb:bg-surface bb:text-center bb:text-xs bb:font-normal bb:text-muted-foreground"
                                    style="@SingleTierStyle()"
                                    title="@slot.Start.ToString("D")">
                                    @slot.Label
                                </th>
                            }
                        }
                    </tr>

                    @if (axis.Major.Count > 0)
                    {
                        <tr>
                            @foreach (var slot in axis.Minor)
                            {
                                <th scope="col"
                                    class="bb:sticky bb:z-30 bb:border-b bb:border-border bb:bg-surface bb:text-center bb:text-xs bb:font-normal @(slot.IsNonWorking && ShowNonWorkingDays ? "bb:text-muted-foreground/50" : "bb:text-muted-foreground")"
                                    style="@LowerTierStyle()"
                                    title="@slot.Start.ToString("D")">
                                    @slot.Label
                                </th>
                            }
                        </tr>
                    }
                </thead>

                <tbody>
                    @foreach (var row in chart.Rows)
                    {
                        <tr class="@ClassNames.cn("bb:group/row")" style="@RowStyle()">
                            @{
                                var cellOffset = 0;
                            }
                            @foreach (var column in DeclaredColumns)
                            {
                                var offset = cellOffset;
                                cellOffset += column.EffectiveWidth;
                                var isTree = ReferenceEquals(column, treeColumn);

                                <td class="bb:sticky bb:z-20 bb:border-b bb:border-border bb:bg-surface bb:px-3 bb:group-hover/row:bg-muted/50 @(cellOffset >= treeWidth ? "bb:border-e" : string.Empty) @AlignClass(column)"
                                    style="@BodyCellStyle(offset)">
                                    @if (isTree)
                                    {
                                        <div class="bb:flex bb:items-center bb:gap-1" style="@IndentStyle(row)" data-gantt-row="@row.Id">
                                            @if (AllowRowDrag)
                                            {
                                                <span class="bb:flex bb:size-4 bb:shrink-0 bb:cursor-grab bb:items-center bb:justify-center bb:text-muted-foreground bb:opacity-0 bb:group-hover/row:opacity-100"
                                                      data-gantt-row-handle
                                                      role="button"
                                                      aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Localizer["Gantt.DragRow"], row.Text)">
                                                    <LucideIcon Name="grip-vertical" Size="14" />
                                                </span>
                                            }
                                            @if (row.IsSummary)
                                            {
                                                <button type="button"
                                                        class="bb:flex bb:size-5 bb:shrink-0 bb:items-center bb:justify-center bb:rounded bb:text-muted-foreground bb:hover:bg-muted bb:hover:text-foreground"
                                                        aria-expanded="@row.IsExpanded.ToString().ToLowerInvariant()"
                                                        aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Localizer[row.IsExpanded ? "Gantt.Collapse" : "Gantt.Expand"], row.Text)"
                                                        @onclick="@(() => ToggleAsync(row.Id))">
                                                    <LucideIcon Name="@(row.IsExpanded ? "chevron-down" : "chevron-right")" Size="14" />
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="bb:size-5 bb:shrink-0"></span>
                                            }
                                            @if (column.ChildContent is not null)
                                            {
                                                @* The template owns the rest of the cell. Wrapping
                                                   it in the truncating span as well would clip
                                                   whatever it put there, an input most of all. *@
                                                <div class="bb:min-w-0 bb:flex-1">
                                                    @column.ChildContent(row)
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="bb:truncate @(row.IsSummary ? "bb:font-medium" : string.Empty)" title="@row.Text">
                                                    @column.Text(row, isTree)
                                                </span>
                                            }
                                        </div>
                                    }
                                    else if (column.ChildContent is not null)
                                    {
                                        @column.ChildContent(row)
                                    }
                                    else
                                    {
                                        <span class="bb:truncate">@column.Text(row, isTree)</span>
                                    }
                                </td>
                            }

                            @*
                                The timeline cell is structure only. Everything drawn against the
                                axis lives in one layer after the table, because a table paints its
                                cells in document order and no z-index on a later cell's child will
                                lift a dependency arrow over an earlier cell's bar.
                            *@
                            <td colspan="@axis.SlotCount" class="bb:border-b bb:border-border bb:p-0" style="@RowStyle()"></td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="bb:pointer-events-none bb:absolute bb:top-0" style="@DrawingLayerStyle()">
                @foreach (var band in NonWorkingBands())
                {
                    <div class="bb:absolute bb:top-0 bb:bottom-0 bb:bg-muted/50"
                         style="@BandStyle(band.X, band.Width)"></div>
                }
                @foreach (var line in MajorLines())
                {
                    <div class="bb:absolute bb:top-0 bb:bottom-0 bb:w-px bb:bg-border"
                         style="@LineStyle(line)"></div>
                }
                @if (today is { } marker)
                {
                    <div class="bb:absolute bb:top-0 bb:bottom-0 bb:w-px bb:bg-primary"
                         style="@LineStyle(marker)"></div>
                }

                @foreach (var row in chart.Rows)
                {
                    @if (row.IsMilestone)
                    {
                        @* The marker is turned, so the box holding it is not: a connector inside a rotated
                           parent turns with it, and the handles have to sit square to the row. *@
                        <div class="@ClassNames.cn("bb:group/bar bb:pointer-events-auto bb:absolute", AllowDrag ? "bb:cursor-grab bb:touch-none" : null)"
                             style="@MilestoneStyle(row)"
                             data-gantt-bar="@row.Id"
                             role="img"
                             aria-label="@BarLabel(row)"
                             @onclick="@(() => ClickAsync(row))">
                            <div class="bb:size-full bb:rotate-45 bb:rounded-[2px]" style="@MilestonePaint(row).TrimStart(';')"></div>
                            @Connectors(row)
                            @Tooltip(row)
                        </div>
                    }
                    else if (row.IsSummary)
                    {
                        <div class="@ClassNames.cn("bb:group/bar bb:pointer-events-auto bb:absolute")"
                             style="@(BarStyle(row) + BarPaint(row))"
                             data-gantt-bar="@row.Id"
                             role="img"
                             aria-label="@BarLabel(row)"
                             @onclick="@(() => ClickAsync(row))">
                            @if (row.Progress > 0)
                            {
                                <div class="bb:absolute bb:inset-y-0 bb:start-0"
                                     style="@ProgressStyle(row)"></div>
                            }
                            @* The two legs hang below the crossbar, which is what says "this is
                               the span of what is under it" rather than "this is a task". *@
                            <div class="bb:absolute bb:top-0 bb:start-0 bb:w-[3px]" style="@SummaryLegStyle()"></div>
                            <div class="bb:absolute bb:top-0 bb:end-0 bb:w-[3px]" style="@SummaryLegStyle()"></div>
                            @Connectors(row)
                            @Tooltip(row)
                        </div>
                    }
                    else
                    {
                        <div class="@ClassNames.cn("bb:group/bar bb:pointer-events-auto bb:absolute bb:rounded-[3px]", AllowDrag || AllowResize ? "bb:cursor-grab bb:touch-none" : null)"
                             style="@(BarStyle(row) + BarPaint(row) + ";" + BarOutline())"
                             data-gantt-bar="@row.Id"
                             role="img"
                             aria-label="@BarLabel(row)"
                             @onclick="@(() => ClickAsync(row))">
                            @if (BarTemplate is not null)
                            {
                                @BarTemplate(row)
                            }
                            else if (row.Progress > 0 || AllowProgressDrag)
                            {
                                @* Rendered even at nothing done, or a drag would have no fill to
                                   widen and a task could never be started from the chart. *@
                                <div class="bb:absolute bb:inset-y-0 bb:start-0 bb:rounded-s-[3px]"
                                     style="@ProgressStyle(row)"
                                     data-gantt-fill></div>
                            }

                            @if (AllowProgressDrag)
                            {
                                <div class="bb:absolute bb:top-1/2 bb:-mt-[5px] bb:size-2.5 bb:rotate-45 bb:cursor-ew-resize bb:rounded-[2px] bb:bg-background bb:opacity-0 bb:ring-1 bb:group-hover/bar:opacity-100"
                                     style="@ProgressHandleStyle(row)"
                                     data-gantt-progress
                                     role="slider"
                                     aria-valuemin="0"
                                     aria-valuemax="100"
                                     aria-valuenow="@((int)Math.Round(row.Progress * 100))"
                                     aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Localizer["Gantt.ProgressHandle"], row.Text)"></div>
                            }

                            @if (AllowResize)
                            {
                                <div class="bb:absolute bb:inset-y-0 bb:start-0 bb:w-1.5 bb:cursor-ew-resize bb:rounded-s-[3px] bb:bg-foreground/40 bb:opacity-0 bb:group-hover/bar:opacity-100"
                                     data-gantt-resize="start"></div>
                                <div class="bb:absolute bb:inset-y-0 bb:end-0 bb:w-1.5 bb:cursor-ew-resize bb:rounded-e-[3px] bb:bg-foreground/40 bb:opacity-0 bb:group-hover/bar:opacity-100"
                                     data-gantt-resize="end"></div>
                            }

                            @Connectors(row)
                            @Tooltip(row)
                        </div>
                    }

                    @if (ShowTaskLabels)
                    {
                        <span class="bb:absolute bb:flex bb:items-center bb:whitespace-nowrap bb:text-xs bb:text-muted-foreground"
                              style="@LabelStyle(row)">
                            @row.Text
                        </span>
                    }
                }

                @if (ShowDependencies)
                {
                    @* Mirrored as a whole in a right-to-left page: an SVG coordinate system does
                       not flip on its own, and an arrow that still points right there would be
                       pointing backwards in time. *@
                    <svg class="bb:absolute bb:top-0 bb:start-0 bb:text-muted-foreground"
                         width="@timelineWidth"
                         height="@BodyHeight"
                         data-gantt-links
                         role="list"
                         aria-label="@Localizer["Gantt.Dependencies"]">
                        @foreach (var link in chart.Links)
                        {
                            <g role="listitem" class="@(AllowLinking ? "bb:pointer-events-auto bb:cursor-pointer bb:hover:text-destructive" : string.Empty)">
                                <title>@LinkLabel(link)</title>
                                @if (AllowLinking)
                                {
                                    @* A one-and-a-half pixel line is not something anyone can hit.
                                       The wide transparent twin is what the pointer actually finds. *@
                                    <path d="@LinkPath(link)"
                                          fill="none"
                                          stroke="transparent"
                                          stroke-width="10"
                                          @onclick="@(() => ClickLinkAsync(link))" />
                                }
                                <path d="@LinkPath(link)" fill="none" stroke="currentColor" stroke-width="1.5" pointer-events="none" />
                                <polygon points="@LinkArrow(link)" fill="currentColor" pointer-events="none" />
                            </g>
                        }
                    </svg>
                }
            </div>
            </div>
        </div>

        @if (ShowLegend)
        {
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-x-5 bb:gap-y-2 bb:text-xs bb:text-muted-foreground"
                 role="list"
                 aria-label="@Localizer["Gantt.Legend"]">
                <span class="bb:flex bb:items-center bb:gap-2" role="listitem">
                    <span class="bb:inline-flex bb:h-2.5 bb:w-8 bb:overflow-hidden bb:rounded-[3px] bb:bg-primary/30 bb:ring-1 bb:ring-inset bb:ring-primary/50" aria-hidden="true">
                        <span class="bb:h-full bb:w-1/2 bb:bg-primary"></span>
                    </span>
                    @Localizer["Gantt.LegendTask"] <span class="bb:opacity-60">(@Localizer["Gantt.LegendDone"])</span>
                </span>

                @if (chart.Rows.Any(r => r.IsSummary))
                {
                    <span class="bb:flex bb:items-center bb:gap-2" role="listitem">
                        <span class="bb:relative bb:inline-block bb:h-3 bb:w-8" aria-hidden="true">
                            <span class="bb:absolute bb:inset-x-0 bb:top-0 bb:h-1 bb:bg-foreground/80"></span>
                            <span class="bb:absolute bb:start-0 bb:top-0 bb:h-2.5 bb:w-[3px] bb:bg-foreground/80"></span>
                            <span class="bb:absolute bb:end-0 bb:top-0 bb:h-2.5 bb:w-[3px] bb:bg-foreground/80"></span>
                        </span>
                        @Localizer["Gantt.LegendSummary"]
                    </span>
                }

                @if (chart.Rows.Any(r => r.IsMilestone))
                {
                    <span class="bb:flex bb:items-center bb:gap-2" role="listitem">
                        <span class="bb:inline-block bb:size-2.5 bb:rotate-45 bb:rounded-[2px] bb:bg-foreground" aria-hidden="true"></span>
                        @Localizer["Gantt.LegendMilestone"]
                    </span>
                }

                @if (ShowToday)
                {
                    <span class="bb:flex bb:items-center bb:gap-2" role="listitem">
                        <span class="bb:inline-block bb:h-3.5 bb:w-px bb:bg-primary" aria-hidden="true"></span>
                        @Localizer["Gantt.LegendToday"]
                    </span>
                }

                @if (ShowNonWorkingDays && chart.Axis.Minor.Any(slot => slot.IsNonWorking))
                {
                    <span class="bb:flex bb:items-center bb:gap-2" role="listitem">
                        <span class="bb:inline-block bb:h-3.5 bb:w-4 bb:rounded-[2px] bb:bg-muted" aria-hidden="true"></span>
                        @Localizer["Gantt.LegendNonWorking"]
                    </span>
                }

                @if (ShowDependencies && chart.Links.Count > 0)
                {
                    <span class="bb:flex bb:items-center bb:gap-2" role="listitem">
                        <svg width="26" height="10" aria-hidden="true" class="bb:text-muted-foreground">
                            <path d="M 0 5 L 17 5" fill="none" stroke="currentColor" stroke-width="1.5" />
                            <polygon points="23,5 17,2 17,8" fill="currentColor" />
                        </svg>
                        @Localizer["Gantt.Dependencies"]
                    </span>
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>
    /// The two dots a dependency is drawn from, one at each end of a bar.
    /// </summary>
    /// <remarks>
    /// Which dot the drag starts on and which half of the target it lands on decide the type, so
    /// all four come out of the gesture rather than out of a menu asking which one was meant.
    /// </remarks>
    private RenderFragment Connectors(GanttRow<TItem> row) => @<text>
        @if (AllowLinking)
        {
            <div class="bb:absolute bb:top-1/2 bb:-mt-1 bb:size-2 bb:cursor-crosshair bb:rounded-full bb:bg-background bb:opacity-0 bb:ring-1 bb:group-hover/bar:opacity-100"
                 style="@ConnectorStyle(start: true)"
                 data-gantt-link="start"
                 aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Localizer["Gantt.LinkFromStart"], row.Text)"></div>
            <div class="bb:absolute bb:top-1/2 bb:-mt-1 bb:size-2 bb:cursor-crosshair bb:rounded-full bb:bg-background bb:opacity-0 bb:ring-1 bb:group-hover/bar:opacity-100"
                 style="@ConnectorStyle(start: false)"
                 data-gantt-link="end"
                 aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Localizer["Gantt.LinkFromEnd"], row.Text)"></div>
        }
    </text>;

    /// <summary>
    /// The card shown while a bar is hovered.
    /// </summary>
    /// <remarks>
    /// Plain markup shown by CSS, not a floating overlay. A plan can hold hundreds of bars, and on
    /// Blazor Server asking the circuit what to show on every pointer-over is a card that arrives
    /// after the pointer has moved on. The bar already carries the same words in its aria-label, so
    /// this is hidden from a screen reader rather than read out twice.
    /// </remarks>
    private RenderFragment Tooltip(GanttRow<TItem> row) => @<text>
        @if (ShowTooltip)
        {
            <div class="bb:pointer-events-none bb:absolute bb:z-10 bb:w-max bb:max-w-60 bb:rounded-md bb:border bb:border-border bb:bg-popover bb:px-2.5 bb:py-2 bb:text-xs bb:text-popover-foreground bb:shadow-md bb:opacity-0 bb:transition-opacity bb:group-hover/bar:opacity-100"
                 style="@TooltipStyle(row)"
                 aria-hidden="true">
                @if (TooltipTemplate is not null)
                {
                    @TooltipTemplate(row)
                }
                else
                {
                    <p class="bb:font-medium bb:text-foreground">@row.Text</p>
                    <p class="bb:mt-0.5 bb:text-muted-foreground">@TooltipRange(row)</p>
                    @if (TooltipLength(row) is { } length)
                    {
                        <p class="bb:text-muted-foreground">@length</p>
                    }
                    @if (!row.IsMilestone)
                    {
                        <p class="bb:text-muted-foreground">
                            @string.Format(System.Globalization.CultureInfo.CurrentCulture, Localizer["Gantt.TooltipDone"], (int)Math.Round(row.Progress * 100))
                        </p>
                    }
                }
            </div>
        }
    </text>;
}
