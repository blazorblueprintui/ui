@namespace BlazorBlueprint.Components
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation
@implements IDisposable

<BbScreenTransition TransitionKey="location" Preset="Preset" Duration="Duration" Enabled="Enabled" Class="@Class">@ChildContent</BbScreenTransition>

@code {
    /// <summary>Place around RouteView or layout body to animate incoming navigation content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>The incoming page animation.</summary>
    [Parameter] public MotionPreset Preset { get; set; } = MotionPreset.Fade;
    /// <summary>Duration in milliseconds.</summary>
    [Parameter] public int Duration { get; set; } = 250;
    /// <summary>Enables animation after the first interactive render.</summary>
    [Parameter] public bool Enabled { get; set; } = true;
    /// <summary>Additional wrapper classes.</summary>
    [Parameter] public string? Class { get; set; }
    private string location = "";
    private bool disposed;
    protected override void OnInitialized() { location = Navigation.Uri; Navigation.LocationChanged += OnLocationChanged; }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() => { if (!disposed) { location = args.Location; StateHasChanged(); } });
    }
    public void Dispose() { disposed = true; Navigation.LocationChanged -= OnLocationChanged; }
}
