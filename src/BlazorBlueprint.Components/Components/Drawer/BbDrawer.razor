@namespace BlazorBlueprint.Components
@using BlazorBlueprint.Primitives.Utilities

@* Drawer - A mobile-friendly slide panel built on Sheet primitive *@
<CascadingValue Value="this" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool? Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public bool DefaultOpen { get; set; }

    [Parameter]
    public DrawerDirection Direction { get; set; } = DrawerDirection.Bottom;

    /// <summary>Ascending fractions of the viewport (greater than 0, at most 1). Empty uses natural content size.</summary>
    [Parameter] public IReadOnlyList<double> SnapPoints { get; set; } = [];
    /// <summary>The active zero-based snap point.</summary>
    [Parameter] public int SnapIndex { get; set; }
    /// <summary>Called when the active snap point changes.</summary>
    [Parameter] public EventCallback<int> SnapIndexChanged { get; set; }
    /// <summary>Allows dragging below half the smallest snap point to dismiss.</summary>
    [Parameter] public bool DismissOnDrag { get; set; } = true;

    protected override void OnParametersSet()
    {
        for (var i = 0; i < SnapPoints.Count; i++)
        {
            if (!double.IsFinite(SnapPoints[i]) || SnapPoints[i] <= 0 || SnapPoints[i] > 1 || (i > 0 && SnapPoints[i] <= SnapPoints[i - 1]))
            {
                throw new ArgumentException("SnapPoints must be ascending viewport fractions greater than 0 and at most 1.", nameof(SnapPoints));
            }
        }
        if (SnapPoints.Count > 0 && (SnapIndex < 0 || SnapIndex >= SnapPoints.Count)) { throw new ArgumentOutOfRangeException(nameof(SnapIndex)); }

        // A controlled Open change bypasses SetOpen, so detect the open→closed transition here,
        // while the content is still rendered, and start its exit animation.
        if (IsOpen != lastOpen)
        {
            ApplyOpenTransition(IsOpen);
            lastOpen = IsOpen;
        }
    }

    /// <summary>
    /// The exit animation registered by the content, or null when the drawer leaves the page as
    /// soon as it closes.
    /// </summary>
    internal Func<Func<bool>, Task>? ExitAnimation
    {
        get => exit.ExitAnimation;
        set => exit.ExitAnimation = value;
    }

    /// <summary>
    /// Gets whether the drawer has closed but is still on the page, playing its exit animation.
    /// </summary>
    internal bool IsExiting => exit.IsAnimatingOut;

    /// <summary>
    /// Gets whether the drawer's overlay and content should be rendered: while it is open, and
    /// while its exit animation plays.
    /// </summary>
    internal bool IsPresent => exit.IsPresent(IsOpen);

    private readonly ExitAnimationGate exit = new();

    private bool lastOpen;

    private void ApplyOpenTransition(bool open)
    {
        if (open)
        {
            exit.Cancel();
        }
        else
        {
            exit.Begin(() => _ = InvokeAsync(StateHasChanged));
        }
    }

    internal async Task SetSnapIndexAsync(int index)
    {
        if (index < 0 || index >= SnapPoints.Count || index == SnapIndex) { return; }
        SnapIndex = index;
        await SnapIndexChanged.InvokeAsync(index);
        StateHasChanged();
    }

    internal bool IsControlled => Open.HasValue;
    internal bool IsOpen => Open ?? _internalOpen;
    internal ElementReference? TriggerElement { get; set; }
    private bool _internalOpen;

    internal async Task SetOpen(bool open)
    {
        if (IsControlled)
        {
            await OpenChanged.InvokeAsync(open);
            return;
        }

        // Left to itself the drawer used to keep the state and say nothing, so a page listening to
        // OpenChanged without binding Open never heard it open or close. Dialog and Sheet report in
        // both modes; so does this now. Only a real change is reported: the drawer's own state is
        // always current, so comparing against it cannot go stale the way a controlled value can.
        if (_internalOpen == open)
        {
            return;
        }

        _internalOpen = open;
        lastOpen = open;
        ApplyOpenTransition(open);
        StateHasChanged();
        await OpenChanged.InvokeAsync(open);
    }

    protected override void OnInitialized()
    {
        _internalOpen = DefaultOpen;
        lastOpen = IsOpen;
    }
}
