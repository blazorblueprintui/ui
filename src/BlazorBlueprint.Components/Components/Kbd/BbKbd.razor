@namespace BlazorBlueprint.Components

<kbd class="@CssClass" @attributes="AdditionalAttributes">
    @if (ChildContent != null)
    {
        @ChildContent
    }
    else
    {
        @Keys
    }
</kbd>

@code {
    /// <summary>
    /// The keyboard keys to display (e.g., "Ctrl+C", "Shift+Enter").
    /// Used when ChildContent is not provided.
    /// </summary>
    [Parameter]
    public string? Keys { get; set; }

    /// <summary>
    /// Custom content for the keyboard shortcut display.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes to apply.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Size variant of the kbd element.
    /// </summary>
    [Parameter]
    public KbdSize Size { get; set; } = KbdSize.Default;

    private string SizeClasses => Size switch
    {
        KbdSize.Small => "bb:text-[10px] bb:px-1 bb:py-0.5",
        KbdSize.Default => "bb:text-xs bb:px-1.5 bb:py-0.5",
        KbdSize.Large => "bb:text-sm bb:px-2 bb:py-1",
        _ => "bb:text-xs bb:px-1.5 bb:py-0.5"
    };

    private string CssClass => ClassNames.cn(
        "bb:pointer-events-none bb:inline-flex bb:h-5 bb:select-none bb:items-center bb:gap-1 bb:rounded bb:border bb:bg-muted bb:font-mono bb:font-medium bb:text-muted-foreground",
        SizeClasses,
        Class
    );
}
