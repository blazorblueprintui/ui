@typeparam TValue
@namespace BlazorBlueprint.Components
@inject IJSRuntime JSRuntime
@using Microsoft.JSInterop
@implements IAsyncDisposable

@* Styled SelectContent wrapper around SelectContent primitive *@
<BlazorBlueprint.Primitives.Select.BbSelectContent TValue="TValue"
                                               class="@OuterCssClass"
                                               @attributes="AdditionalAttributes">
    <div @ref="_scrollRef" class="@InnerCssClass">
        @ChildContent
        @if (IsLoading)
        {
            <div class="flex items-center justify-center py-2">
                <BbSpinner Size="SpinnerSize.Small" />
            </div>
        }
        else if (!string.IsNullOrEmpty(EndOfListMessage))
        {
            <div class="py-2 text-center text-xs text-muted-foreground">
                @EndOfListMessage
            </div>
        }
    </div>
</BlazorBlueprint.Primitives.Select.BbSelectContent>

@code {
    private ElementReference _scrollRef;
    private DotNetObjectReference<BbSelectContent<TValue>>? _selfRef;
    private int _nearBottomObserver;

    /// <summary>
    /// Cascading parameter to infer TValue from parent Select context.
    /// </summary>
    [CascadingParameter]
    private BlazorBlueprint.Primitives.Select.SelectContext<TValue>? Context { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the content container.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the content to be rendered inside the dropdown.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the user scrolls near the bottom of the dropdown list.
    /// Use this to load additional items for infinite scroll scenarios.
    /// </summary>
    [Parameter]
    public EventCallback OnLoadMore { get; set; }

    /// <summary>
    /// Gets or sets whether additional items are currently being loaded.
    /// When true, a loading spinner is shown at the bottom of the list and
    /// <see cref="OnLoadMore"/> is suppressed until loading completes.
    /// </summary>
    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Gets or sets a message displayed at the bottom of the list when all items have been loaded.
    /// Only shown when <see cref="IsLoading"/> is false. Set to <c>null</c> or empty to hide.
    /// </summary>
    [Parameter]
    public string? EndOfListMessage { get; set; }

    /// <summary>
    /// Outer container: border, shadow, animation — no scrolling.
    /// </summary>
    private string OuterCssClass => ClassNames.cn(
        "z-50 w-full overflow-hidden rounded-md border",
        "bg-popover text-popover-foreground shadow-md",
        "data-[state=open]:animate-in data-[state=closed]:animate-out",
        "data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0",
        "data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95",
        "data-[side=bottom]:slide-in-from-top-2 data-[side=top]:slide-in-from-bottom-2",
        Class
    );

    /// <summary>
    /// Inner container: scrollable area with max height.
    /// </summary>
    private static string InnerCssClass => "max-h-60 overflow-auto p-1 [&::-webkit-scrollbar]:hidden";

    // No @onscroll — see BbCommandList for why. The browser watches the element and calls back
    // once per arrival at the bottom, instead of the server hearing about every scroll event and
    // awaiting a round trip to answer each one.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && OnLoadMore.HasDelegate)
        {
            _ = ObserveNearBottomAsync();
        }
    }

    private async Task ObserveNearBottomAsync()
    {
        try
        {
            var module = await PrimitiveModules.GetAsync(JSRuntime);
            _selfRef ??= DotNetObjectReference.Create(this);
            _nearBottomObserver = await module.InvokeAsync<int>(
                "elementUtils.observeNearBottom", _scrollRef, _selfRef, nameof(JsOnNearBottom), 80.0);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            // Circuit gone, prerendering, or the list already torn down. Load-more is a courtesy.
        }
    }

    /// <summary>
    /// Called from JavaScript when the list scrolls near its bottom.
    /// </summary>
    [JSInvokable]
    public async Task JsOnNearBottom()
    {
        if (!OnLoadMore.HasDelegate || IsLoading)
        {
            return;
        }

        await OnLoadMore.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_nearBottomObserver != 0 && PrimitiveModules.TryGetLoaded(JSRuntime, out var module))
        {
            var id = _nearBottomObserver;
            _nearBottomObserver = 0;

            try
            {
                await module.InvokeVoidAsync("elementUtils.unobserveNearBottom", id);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // Circuit gone — the listener went with the document.
            }
        }

        _selfRef?.Dispose();
        _selfRef = null;
    }
}
