@typeparam TValue
@namespace BlazorBlueprint.Components
@inject IBbLocalizer Localizer
@using Microsoft.JSInterop
@implements IAsyncDisposable

@* Styled SelectContent wrapper around SelectContent primitive *@
@if (IsSheet && Context is not null)
{
    <BbSheet Open="Context.IsOpen" OpenChanged="HandleSheetOpenChanged" Side="SheetSide.Bottom">
        <BbSheetContent Class="@ClassNames.cn("bb:max-h-[85dvh] bb:rounded-t-xl bb:pb-[max(1.5rem,env(safe-area-inset-bottom))]", Class)" @attributes="AdditionalAttributes">
            <BbSheetHeader>
                <BbSheetTitle>@(SheetTitle ?? Parent?.SheetTitle ?? Localizer["Select.ChooseOption"])</BbSheetTitle>
            </BbSheetHeader>
            @RenderSheetOptions()
        </BbSheetContent>
    </BbSheet>
}
else
{
    <BlazorBlueprint.Primitives.Select.BbSelectContent TValue="TValue" class="@OuterCssClass" @attributes="AdditionalAttributes">
        @RenderOptions()
    </BlazorBlueprint.Primitives.Select.BbSelectContent>
}

@code {
    [CascadingParameter] private BbSelect<TValue>? Parent { get; set; }
    /// <summary>Overrides the parent Select's presentation when supplied.</summary>
    [Parameter] public SelectPresentation? Presentation { get; set; }
    /// <summary>Overrides the parent Select's sheet title.</summary>
    [Parameter] public string? SheetTitle { get; set; }
    private bool IsSheet => (Presentation ?? Parent?.Presentation ?? SelectPresentation.Popover) == SelectPresentation.BottomSheet;
    private RenderFragment RenderOptions() => builder =>
    {
        builder.OpenComponent<SelectOptionsViewport>(0);
        builder.AddAttribute(1, nameof(SelectOptionsViewport.Class), InnerCssClass);
        builder.AddAttribute(2, nameof(SelectOptionsViewport.OnLoadMore), OnLoadMore);
        builder.AddAttribute(3, nameof(SelectOptionsViewport.IsLoading), IsLoading);
        builder.AddAttribute(4, nameof(SelectOptionsViewport.ChildContent), RenderOptionItems());
        builder.CloseComponent();
    };
    private RenderFragment RenderOptionItems() => __builder =>
    {
        @ChildContent
        @if (IsLoading)
        {
            <div class="bb:flex bb:items-center bb:justify-center bb:py-2">
                <BbSpinner Size="SpinnerSize.Small" />
            </div>
        }
        else if (!string.IsNullOrEmpty(EndOfListMessage))
        {
            <div class="bb:py-2 bb:text-center bb:text-xs bb:text-muted-foreground">
                @EndOfListMessage
            </div>
        }
    };
    private RenderFragment RenderSheetOptions() => builder =>
    {
        builder.OpenComponent<SelectSheetOptions<TValue>>(0);
        builder.AddAttribute(1, nameof(SelectSheetOptions<TValue>.Context), Context);
        builder.AddAttribute(2, nameof(SelectSheetOptions<TValue>.ChildContent), RenderOptions());
        builder.CloseComponent();
    };
    private void HandleSheetOpenChanged(bool open)
    {
        if (!open) { Context?.Close(restoreFocus: true); }
    }


    /// <summary>
    /// Cascading parameter to infer TValue from parent Select context.
    /// </summary>
    [CascadingParameter]
    private BlazorBlueprint.Primitives.Select.SelectContext<TValue>? Context { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the content container.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the content to be rendered inside the dropdown.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the user scrolls near the bottom of the dropdown list.
    /// Use this to load additional items for infinite scroll scenarios.
    /// </summary>
    [Parameter]
    public EventCallback OnLoadMore { get; set; }

    /// <summary>
    /// Gets or sets whether additional items are currently being loaded.
    /// When true, a loading spinner is shown at the bottom of the list and
    /// <see cref="OnLoadMore"/> is suppressed until loading completes.
    /// </summary>
    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Gets or sets a message displayed at the bottom of the list when all items have been loaded.
    /// Only shown when <see cref="IsLoading"/> is false. Set to <c>null</c> or empty to hide.
    /// </summary>
    [Parameter]
    public string? EndOfListMessage { get; set; }

    /// <summary>
    /// Outer container: border, shadow, animation — no scrolling.
    /// </summary>
    private string OuterCssClass => ClassNames.cn(
        "bb:z-50 bb:w-full bb:overflow-hidden bb:rounded-md bb:border",
        "bb:bg-popover bb:text-popover-foreground bb:shadow-md",
        "bb:data-[state=open]:animate-in bb:data-[state=closed]:animate-out",
        "bb:data-[state=closed]:fade-out-0 bb:data-[state=open]:fade-in-0",
        "bb:data-[state=closed]:zoom-out-95 bb:data-[state=open]:zoom-in-95",
        "bb:data-[side=bottom]:slide-in-from-top-2 bb:data-[side=top]:slide-in-from-bottom-2",
        Class
    );

    /// <summary>
    /// Inner container: scrollable area with max height.
    /// </summary>
    private string InnerCssClass => IsSheet
        ? "bb:max-h-[65dvh] bb:overflow-y-auto bb:p-1 bb:[&_[role=option]]:min-h-[44px]"
        : "bb:max-h-60 bb:overflow-auto bb:p-1 bb:[&::-webkit-scrollbar]:hidden";

    /// <summary>
    /// Called from JavaScript when the list scrolls near its bottom.
    /// </summary>
    [JSInvokable]
    public async Task JsOnNearBottom()
    {
        if (!OnLoadMore.HasDelegate || IsLoading)
        {
            return;
        }

        await OnLoadMore.InvokeAsync();
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}
