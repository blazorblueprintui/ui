@namespace BlazorBlueprint.Components
@typeparam TData where TData : class
@inject IBbLocalizer Localizer

<div class="bb:flex bb:items-center bb:justify-between bb:gap-2 bb:py-4" @attributes="AdditionalAttributes">
    <div class="bb:flex bb:flex-1 bb:items-center bb:gap-2">
        <BbInput @bind-Value="@_searchValue"
               @bind-Value:after="@HandleSearchChanged"
               Placeholder="@Localizer["DataTable.Search"]"
               Class="bb:h-8 bb:w-[150px] bb:lg:w-[250px]" />

        <BbPopover>
            <BbPopoverTrigger>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="bb:h-8 bb:ms-auto">
                    <svg class="bb:w-4 bb:h-4 bb:me-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    @Localizer["DataTable.Columns"]
                </BbButton>
            </BbPopoverTrigger>
            <BbPopoverContent Class="bb:w-[200px] bb:p-0" Side="@PopoverSide.Bottom" Align="@PopoverAlign.End">
                <div class="bb:p-4 bb:space-y-2">
                    <div class="bb:text-sm bb:font-medium bb:mb-3">@Localizer["DataTable.ToggleColumns"]</div>
                    @foreach (var column in Columns)
                    {
                        <div class="bb:flex bb:items-center bb:gap-2 bb:p-2 bb:hover:bg-accent bb:rounded-sm bb:transition-colors"
                             @onclick:stopPropagation="true">
                            <BbCheckbox Checked="@column.Visible"
                                      CheckedChanged="@((bool isChecked) => OnColumnVisibilityChanged?.Invoke(column.Id, isChecked))" />
                            <span class="bb:text-sm bb:select-none bb:cursor-pointer" @onclick="@(() => OnColumnVisibilityChanged?.Invoke(column.Id, !column.Visible))">@column.Header</span>
                        </div>
                    }
                </div>
            </BbPopoverContent>
        </BbPopover>
    </div>

    @if (ChildContent != null)
    {
        <div class="bb:flex bb:items-center bb:gap-2">
            @ChildContent
        </div>
    }
</div>

@code {
    private string _searchValue = string.Empty;

    [Parameter]
    public string GlobalSearchValue { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnGlobalSearchChanged { get; set; }

    [Parameter]
    public List<BbDataTable<TData>.ColumnData> Columns { get; set; } = new();

    [Parameter]
    public Action<string, bool> OnColumnVisibilityChanged { get; set; } = null!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        _searchValue = GlobalSearchValue;
    }

    private async Task HandleSearchChanged()
    {
        if (OnGlobalSearchChanged.HasDelegate)
        {
            await OnGlobalSearchChanged.InvokeAsync(_searchValue);
        }
    }
}
