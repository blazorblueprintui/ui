@typeparam TValue
@namespace BlazorBlueprint.Components

<div class="@CssClass" @attributes="AdditionalAttributes">
    <BbCheckbox Id="@itemId"
              Checked="@IsChecked"
              CheckedChanged="@HandleCheckedChanged"
              Disabled="@IsDisabled" />
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@itemId" class="bb:text-sm bb:font-medium bb:leading-none bb:peer-disabled:cursor-not-allowed bb:peer-disabled:opacity-70">
            @Label
        </label>
    }
    @ChildContent
</div>
