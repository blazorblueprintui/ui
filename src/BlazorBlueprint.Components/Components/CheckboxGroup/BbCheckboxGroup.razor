@typeparam TValue
@namespace BlazorBlueprint.Components
@attribute [CascadingTypeParameter(nameof(TValue))]

<CascadingValue Value="context">
    <div class="@CssClass" role="group" @attributes="AdditionalAttributes">
        @if (ShowSelectAll)
        {
            <div class="bb:flex bb:items-center bb:gap-2 bb:pb-2 bb:mb-1 bb:border-b">
                <BbCheckbox Checked="@IsAllSelected"
                          Indeterminate="@IsIndeterminate"
                          CheckedChanged="@HandleSelectAllChanged"
                          Disabled="@Disabled" />
                <span class="bb:text-sm bb:font-medium bb:leading-none">
                    @SelectAllLabel
                </span>
            </div>
        }
        @ChildContent
    </div>
</CascadingValue>
