@namespace BlazorBlueprint.Components
@typeparam TValue
@attribute [CascadingTypeParameter(nameof(TValue))]
@using BlazorBlueprint.Icons.Lucide.Components

<CascadingValue Value="this" IsFixed="true">
<div class="@ContainerClass" @attributes="AdditionalAttributes">
    <BbPopover Open="_isOpen" OpenChanged="HandleOpenChanged" RestoreFocusOnClose="_restoreFocusOnClose">
        <BbPopoverTrigger AsChild="false" role="combobox"
                        aria-expanded="@_isOpen.ToString().ToLower()"
                        aria-controls="@($"{Id}-listbox")"
                        aria-haspopup="listbox"
                        aria-multiselectable="true"
                        aria-describedby="@AriaDescribedBy"
                        disabled="@Disabled"
                        class="@TriggerCssClass">
            <div class="@TagListClass">
                @if (HasSelectedItems)
                {
                    @foreach (var value in SelectedValues.Take(MaxDisplayTags))
                    {
                        <BbBadge @key="value" Variant="BadgeVariant.Secondary" Class="@TagBadgeClass">
                            @GetDisplayText(value)
                            <button type="button"
                                    class="@TagRemoveButtonCssClass"
                                    aria-label="@($"Remove {GetDisplayText(value)}")"
                                    @onclick="GetRemoveHandler(value)"
                                    @onclick:stopPropagation="true">
                                <LucideIcon Name="x" Size="12" Class="bb:h-3 bb:w-3" />
                            </button>
                        </BbBadge>
                    }
                    @* In wrap mode "+N more" flows with the tags; in single-line mode it is pinned
                       to the right group below so it stays visible while the tags clip. *@
                    @if (OverflowCount > 0 && !SingleLine)
                    {
                        <span class="bb:text-xs bb:text-muted-foreground">+@OverflowCount more</span>
                    }
                }
                else
                {
                    <span class="bb:text-muted-foreground">@EffectivePlaceholder</span>
                }
            </div>
            <div class="bb:flex bb:shrink-0 bb:items-center bb:gap-1 bb:ml-2">
                @if (HasSelectedItems && OverflowCount > 0 && SingleLine)
                {
                    <span class="bb:shrink-0 bb:whitespace-nowrap bb:text-xs bb:text-muted-foreground">+@OverflowCount more</span>
                }
                @if (HasSelectedItems)
                {
                    <button type="button"
                            class="bb:rounded-sm bb:opacity-70 bb:hover:opacity-100 bb:focus:outline-none"
                            aria-label="@Localizer["MultiSelect.Clear"]"
                            @onclick="ClearAll"
                            @onclick:stopPropagation="true">
                        <LucideIcon Name="x" Size="14" Class="bb:h-3.5 bb:w-3.5" />
                    </button>
                }
                <LucideIcon Name="chevron-down" Size="16" Class="bb:h-4 bb:w-4 bb:shrink-0 bb:opacity-50" />
            </div>
        </BbPopoverTrigger>

        <BbPopoverContent Side="@PopoverSide.Bottom"
                        Align="@PopoverAlign.Start"
                        CloseOnClickOutside="@AutoClose"
                        CloseOnEscape="false"
                        OnEscapeKeyDown="@(_ => CloseAsync())"
                        OnClickOutside="@GetClickOutsideHandler()"
                        AutoFocusId="@($"{Id}-search")"
                        MatchTriggerWidth="@MatchTriggerWidth"
                        Class="@(MatchTriggerWidth ? "bb:!p-0" : $"{PopoverWidth} bb:!p-0")">
            @* Re-cascade through the portal so MultiSelectItem can resolve the CascadingParameter *@
            <CascadingValue Value="this" IsFixed="true">
            @* Search input section - matches CommandInput styling *@
            <div class="bb:flex bb:items-center bb:border-b bb:border-border bb:px-3">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="bb:mr-2 bb:h-4 bb:w-4 bb:shrink-0 bb:opacity-50">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input @ref="_searchInputRef"
                       id="@($"{Id}-search")"
                       type="text"
                       placeholder="@EffectiveSearchPlaceholder"
                       @bind="_searchQuery"
                       @bind:event="oninput"
                       @bind:after="HandleSearchQueryChangedAsync"
                       class="bb:flex bb:h-11 bb:w-full bb:rounded-md bb:bg-transparent bb:py-3 bb:text-sm bb:outline-none bb:placeholder:text-muted-foreground bb:disabled:cursor-not-allowed bb:disabled:opacity-50 bb:ml-2" />
            </div>

            @* Items list section *@
            <div id="@($"{Id}-listbox")" @ref="_listboxScrollRef" role="listbox" aria-multiselectable="true" class="bb:max-h-[300px] bb:overflow-y-auto bb:p-1">
                @if (IsCompositionalMode)
                {
                    @* Compositional mode: Select All + ChildContent *@
                    @if (ShowSelectAll && _itemTextRegistry.Count > 0)
                    {
                        var selectAllState = GetSelectAllState();
                        <div role="option"
                             aria-selected="@(selectAllState == SelectAllState.All ? "true" : "false")"
                             @onclick="HandleSelectAllToggle"
                             @onclick:stopPropagation="true"
                             class="@ItemCssClass">
                            <BlazorBlueprint.Primitives.Checkbox.BbCheckbox Checked="@(selectAllState == SelectAllState.All)"
                                      Indeterminate="@(selectAllState == SelectAllState.Indeterminate)"
                                      class="@CheckboxCssClass"
                                      AriaLabel="@EffectiveSelectAllLabel">
                                @if (selectAllState == SelectAllState.All)
                                {
                                    <LucideIcon Name="check" Size="14" Class="bb:h-3.5 bb:w-3.5 bb:stroke-current" />
                                }
                                else if (selectAllState == SelectAllState.Indeterminate)
                                {
                                    <LucideIcon Name="minus" Size="14" Class="bb:h-3.5 bb:w-3.5 bb:stroke-current" />
                                }
                            </BlazorBlueprint.Primitives.Checkbox.BbCheckbox>
                            <span class="bb:font-medium">@EffectiveSelectAllLabel</span>
                        </div>
                        <BbSeparator Decorative="false" Class="bb:my-1" />
                    }
                    @ChildContent
                    @if (_itemTextRegistry.Count > 0 && !HasFilteredItems)
                    {
                        <div class="bb:py-6 bb:text-center bb:text-sm bb:text-muted-foreground">@EffectiveEmptyMessage</div>
                    }
                }
                else
                {
                    @* Options mode: existing rendering *@
                    @if (!HasFilteredItems)
                    {
                        <div class="bb:py-6 bb:text-center bb:text-sm bb:text-muted-foreground">@EffectiveEmptyMessage</div>
                    }
                    else
                    {
                        @* Select All option *@
                        @if (ShowSelectAll)
                        {
                            var selectAllState = GetSelectAllState();
                            <div role="option"
                                 aria-selected="@(selectAllState == SelectAllState.All ? "true" : "false")"
                                 @onclick="HandleSelectAllToggle"
                                 @onclick:stopPropagation="true"
                                 class="@ItemCssClass">
                                <BlazorBlueprint.Primitives.Checkbox.BbCheckbox Checked="@(selectAllState == SelectAllState.All)"
                                          Indeterminate="@(selectAllState == SelectAllState.Indeterminate)"
                                          class="@CheckboxCssClass"
                                          AriaLabel="@EffectiveSelectAllLabel">
                                    @if (selectAllState == SelectAllState.All)
                                    {
                                        <LucideIcon Name="check" Size="14" Class="bb:h-3.5 bb:w-3.5 bb:stroke-current" />
                                    }
                                    else if (selectAllState == SelectAllState.Indeterminate)
                                    {
                                        <LucideIcon Name="minus" Size="14" Class="bb:h-3.5 bb:w-3.5 bb:stroke-current" />
                                    }
                                </BlazorBlueprint.Primitives.Checkbox.BbCheckbox>
                                <span class="bb:font-medium">@EffectiveSelectAllLabel</span>
                            </div>
                            <BbSeparator Decorative="false" Class="bb:my-1" />
                        }

                        @* Individual items *@
                        @foreach (var option in FilteredOptions)
                        {
                            var itemValue = option.Value;
                            var displayText = option.Text;
                            var isSelected = IsSelected(option);

                            <div @key="itemValue"
                                 role="option"
                                 aria-selected="@isSelected.ToString().ToLower()"
                                 @onclick="GetToggleHandler(option)"
                                 @onclick:stopPropagation="true"
                                 class="@ItemCssClass">
                                <BlazorBlueprint.Primitives.Checkbox.BbCheckbox Checked="@isSelected"
                                          class="@CheckboxCssClass"
                                          AriaLabel="@displayText">
                                    @if (isSelected)
                                    {
                                        <LucideIcon Name="check" Size="14" Class="bb:h-3.5 bb:w-3.5 bb:stroke-current" />
                                    }
                                </BlazorBlueprint.Primitives.Checkbox.BbCheckbox>
                                <span>@displayText</span>
                            </div>
                        }
                    }
                }
                @if (IsLoading)
                {
                    <div class="bb:flex bb:items-center bb:justify-center bb:py-2">
                        <BbSpinner Size="SpinnerSize.Small" />
                    </div>
                }
                else if (!string.IsNullOrEmpty(EndOfListMessage))
                {
                    <div class="bb:py-2 bb:text-center bb:text-xs bb:text-muted-foreground">
                        @EndOfListMessage
                    </div>
                }
            </div>

            @if (FooterContent is not null)
            {
                <div class="bb:border-t bb:p-2">@FooterContent</div>
            }
            else
            {
            @* Footer section *@
            <div class="bb:flex bb:items-center bb:justify-between bb:border-t bb:p-2">
                <button type="button"
                        class="bb:text-xs bb:text-muted-foreground bb:hover:text-foreground bb:transition-colors"
                        @onclick="ClearAll"
                        @onclick:stopPropagation="true">
                    @EffectiveClearLabel
                </button>
                <button type="button"
                        class="bb:text-xs bb:text-muted-foreground bb:hover:text-foreground bb:transition-colors"
                        @onclick="Close"
                        @onclick:stopPropagation="true">
                    @EffectiveCloseLabel
                </button>
            </div>
            }
            </CascadingValue>
        </BbPopoverContent>
    </BbPopover>
</div>
</CascadingValue>
