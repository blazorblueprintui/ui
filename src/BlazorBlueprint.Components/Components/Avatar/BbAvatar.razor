@namespace BlazorBlueprint.Components

@if (ShowDot)
{
    <span class="bb:relative bb:inline-flex" @attributes="AdditionalAttributes">
        <span class="@CssClass">
            @ChildContent
        </span>
        <span class="@DotCssClass"></span>
    </span>
}
else
{
    <span class="@CssClass" @attributes="AdditionalAttributes">
        @ChildContent
    </span>
}
