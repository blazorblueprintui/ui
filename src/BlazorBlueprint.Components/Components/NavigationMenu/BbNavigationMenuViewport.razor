@namespace BlazorBlueprint.Components

@*
    Navigation Menu Viewport - container for dropdown content with border and shadow.
    Used to provide consistent styling for all dropdown panels.
*@

<div class="@OuterCssClass" @attributes="AdditionalAttributes">
    <div class="@InnerCssClass">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>
    /// The content to render inside the viewport.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the outer container.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the computed CSS classes for the outer container.
    /// </summary>
    private string OuterCssClass => ClassNames.cn(
        "bb:absolute bb:left-0 bb:top-full bb:flex bb:justify-center",
        Class
    );

    /// <summary>
    /// Gets the computed CSS classes for the inner container.
    /// </summary>
    private string InnerCssClass => ClassNames.cn(
        "origin-top-center bb:relative bb:mt-1.5 bb:h-[var(--radix-navigation-menu-viewport-height)] bb:w-full",
        "bb:overflow-hidden bb:rounded-md bb:border bb:bg-popover bb:text-popover-foreground bb:shadow-lg",
        "bb:data-[state=open]:animate-in bb:data-[state=closed]:animate-out",
        "bb:data-[state=closed]:zoom-out-95 bb:data-[state=open]:zoom-in-90",
        "bb:md:w-[var(--radix-navigation-menu-viewport-width)]"
    );
}
