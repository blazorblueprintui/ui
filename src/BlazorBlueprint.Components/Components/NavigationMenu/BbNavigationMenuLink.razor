@namespace BlazorBlueprint.Components
@using Microsoft.AspNetCore.Components.Routing

@*
    Navigation Menu Link - a navigation link within the menu.
*@

<NavLink href="@Href"
         class="@CssClass"
         Match="@Match"
         ActiveClass="@ActiveCssClass"
         role="menuitem"
         tabindex="-1"
         @attributes="AdditionalAttributes">
    @ChildContent
</NavLink>

@code {
    /// <summary>
    /// The URL the link navigates to.
    /// </summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>
    /// The content of the link.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// How to match the URL for active state.
    /// </summary>
    [Parameter]
    public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;

    /// <summary>
    /// Additional CSS classes to apply to the link.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Additional attributes to apply to the link.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the computed CSS classes for the link.
    /// </summary>
    private string CssClass => ClassNames.cn(
        "bb:group bb:inline-flex bb:h-10 bb:w-max bb:items-center bb:justify-center bb:rounded-md bb:bg-background bb:px-4 bb:py-2 bb:text-sm bb:font-medium",
        "bb:transition-colors bb:hover:bg-accent bb:hover:text-accent-foreground",
        "bb:outline-none bb:focus:bg-accent bb:focus:text-accent-foreground bb:focus-visible:ring-2 bb:focus-visible:ring-ring bb:focus-visible:ring-offset-2",
        "bb:disabled:pointer-events-none bb:disabled:opacity-50",
        Class
    );

    /// <summary>
    /// Gets the CSS class for active state.
    /// </summary>
    private string ActiveCssClass => "bb:bg-accent/50";
}
