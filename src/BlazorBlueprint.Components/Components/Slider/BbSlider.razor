@namespace BlazorBlueprint.Components

@*
    Slider component - wraps the Slider primitive for drag, keyboard, and ARIA support.
*@

<BlazorBlueprint.Primitives.Slider.BbSlider
    Value="@Value"
    ValueChanged="@ValueChanged"
    DefaultValue="@DefaultValue"
    Min="@Min"
    Max="@Max"
    Step="@Step"
    Disabled="@Disabled"
    Orientation="@MappedOrientation"
    class="@CssClass"
    @attributes="AdditionalAttributes">
    <BlazorBlueprint.Primitives.Slider.BbSliderTrack class="@ComputedTrackClass">
        <BlazorBlueprint.Primitives.Slider.BbSliderRange class="@ComputedIndicatorClass" />
    </BlazorBlueprint.Primitives.Slider.BbSliderTrack>
    <BlazorBlueprint.Primitives.Slider.BbSliderThumb class="@ComputedThumbClass" />
</BlazorBlueprint.Primitives.Slider.BbSlider>

@code {
    [Parameter]
    public double Value { get; set; }

    [Parameter]
    public EventCallback<double> ValueChanged { get; set; }

    [Parameter]
    public double DefaultValue { get; set; }

    [Parameter]
    public double Min { get; set; } = 0;

    [Parameter]
    public double Max { get; set; } = 100;

    [Parameter]
    public double Step { get; set; } = 1;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public SliderOrientation Orientation { get; set; } = SliderOrientation.Horizontal;

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the slider track.
    /// </summary>
    [Parameter]
    public string? TrackClass { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the slider thumb.
    /// </summary>
    [Parameter]
    public string? ThumbClass { get; set; }

    private BlazorBlueprint.Primitives.Slider.SliderOrientation MappedOrientation =>
        Orientation == SliderOrientation.Vertical
            ? BlazorBlueprint.Primitives.Slider.SliderOrientation.Vertical
            : BlazorBlueprint.Primitives.Slider.SliderOrientation.Horizontal;

    private string CssClass => ClassNames.cn(
        "bb:relative bb:flex bb:w-full bb:touch-none bb:select-none bb:items-center",
        Disabled ? "bb:opacity-50 bb:cursor-not-allowed" : "bb:cursor-pointer",
        Class
    );

    private string ComputedTrackClass => ClassNames.cn(
        "bb:relative bb:h-2 bb:w-full bb:grow bb:overflow-hidden bb:rounded-full bb:bg-secondary",
        TrackClass
    );

    private string ComputedIndicatorClass => "bb:absolute bb:h-full bb:bg-primary";

    private string ComputedThumbClass => ClassNames.cn(
        "bb:absolute bb:block bb:h-5 bb:w-5 bb:rounded-full bb:border-2 bb:border-primary bb:bg-background bb:ring-offset-background bb:transition-colors",
        "bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring bb:focus-visible:ring-offset-2",
        "bb:disabled:pointer-events-none bb:disabled:opacity-50",
        "bb:-translate-x-1/2 bb:top-1/2 bb:-translate-y-1/2",
        Disabled ? "" : "bb:cursor-grab bb:active:cursor-grabbing",
        ThumbClass
    );
}
