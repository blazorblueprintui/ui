@namespace BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components
@using BlazorBlueprint.Primitives.TreeView

@*
    Styled TreeItem component.
    Wraps the TreeItem primitive with Tailwind styling, icons, badges, and actions.
*@

<BlazorBlueprint.Primitives.TreeView.BbTreeItem @ref="primitiveRef"
                                                  Value="@Value"
                                                  Disabled="@Disabled"
                                                  IsLeaf="@IsLeaf"
                                                  @attributes="AdditionalAttributes">
    <NodeContent>
        <div class="@NodeCssClass"
             style="@NodeStyle"
             data-tree-node>
            @* Expand/collapse toggle *@
            @if (HasExpandableChildren)
            {
                <button type="button"
                        class="bb:inline-flex bb:h-5 bb:w-5 bb:items-center bb:justify-center bb:rounded-sm bb:hover:bg-accent/80 bb:shrink-0"
                        data-tree-toggle
                        tabindex="-1"
                        aria-hidden="true">
                    <svg class="@ChevronCssClass"
                         xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>
            }
            else
            {
                <span class="bb:inline-flex bb:h-5 bb:w-5 bb:shrink-0"></span>
            }

            @* Checkbox (display-only; toggling handled by tree-keyboard.js) *@
            @if (ShowCheckbox)
            {
                <span data-tree-checkbox class="bb:inline-flex bb:shrink-0 bb:cursor-pointer">
                    <BbCheckbox Checked="@IsChecked"
                                Indeterminate="@IsIndeterminate"
                                Disabled="@Disabled"
                                Class="bb:h-4 bb:w-4 bb:pointer-events-none" />
                </span>
            }

            @* Icon *@
            @if (TreeContext?.State.ShowIcons == true && !string.IsNullOrEmpty(Icon))
            {
                <LucideIcon Name="@Icon" Size="16" Class="bb:shrink-0 bb:text-muted-foreground" />
            }

            @* Label *@
            @if (LabelTemplate != null)
            {
                @LabelTemplate
            }
            else if (!string.IsNullOrEmpty(Label))
            {
                <span class="bb:truncate">@Label</span>
            }

            @* Badge *@
            @if (!string.IsNullOrEmpty(Badge))
            {
                <BbBadge Variant="BadgeVariant.Secondary" Class="bb:ml-auto bb:text-xs bb:px-1.5 bb:py-0 bb:h-5">@Badge</BbBadge>
            }

            @* Actions (visible on hover) *@
            @if (ActionsTemplate != null)
            {
                <span class="bb:ml-auto bb:opacity-0 bb:group-hover/treeitem:opacity-100 bb:transition-opacity bb:shrink-0 bb:flex bb:items-center bb:gap-0.5">
                    @ActionsTemplate
                </span>
            }
        </div>
    </NodeContent>
    <ChildContent>
        @ChildContent
    </ChildContent>
</BlazorBlueprint.Primitives.TreeView.BbTreeItem>
