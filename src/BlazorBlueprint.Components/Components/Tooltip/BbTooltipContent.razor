@namespace BlazorBlueprint.Components

@* Styled TooltipContent - wrapper with shadcn Tailwind classes *@
<BlazorBlueprint.Primitives.Tooltip.BbTooltipContent class="@CssClass"
                                                  Side="@Side"
                                                  Align="@Align"
                                                  Offset="@Offset"
                                                  @attributes="AdditionalAttributes">
    @ChildContent
    @if (ShowArrow)
    {
        <div class="@ArrowClass"></div>
    }
</BlazorBlueprint.Primitives.Tooltip.BbTooltipContent>

@code {
    [CascadingParameter]
    private BlazorBlueprint.Primitives.Tooltip.TooltipContext? Context { get; set; }

    /// <summary>
    /// The content to render inside the tooltip.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the content container.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Preferred side for positioning.
    /// If not set, uses the Placement from the parent Tooltip context.
    /// </summary>
    [Parameter]
    public PopoverSide? Side { get; set; }

    /// <summary>
    /// Alignment relative to trigger.
    /// If not set, uses the Placement from the parent Tooltip context.
    /// </summary>
    [Parameter]
    public PopoverAlign? Align { get; set; }

    /// <summary>
    /// Offset distance from the trigger in pixels.
    /// Default is 8.
    /// </summary>
    [Parameter]
    public int Offset { get; set; } = 8;

    /// <summary>
    /// Whether to show a directional arrow pointing toward the trigger element.
    /// </summary>
    [Parameter]
    public bool ShowArrow { get; set; }

    /// <summary>
    /// Gets the effective side for CSS class computation.
    /// Uses Side parameter if set, otherwise derives from context's Placement.
    /// </summary>
    private PopoverSide EffectiveSide
    {
        get
        {
            if (Side.HasValue)
            {
                return Side.Value;
            }

            var placement = Context?.Placement ?? "top";
            var basePlacement = placement.Split('-')[0];

            return basePlacement switch
            {
                "top" => PopoverSide.Top,
                "bottom" => PopoverSide.Bottom,
                "left" => PopoverSide.Left,
                "right" => PopoverSide.Right,
                _ => PopoverSide.Top
            };
        }
    }

    private string CssClass => ClassNames.cn(
        "bb:z-50 bb:rounded-md bb:border bb:bg-popover bb:px-3 bb:py-1.5",
        ShowArrow ? "bb:relative" : "bb:overflow-hidden",
        "bb:text-sm bb:text-popover-foreground bb:shadow-md",
        "bb:animate-in bb:fade-in-0 bb:zoom-in-95 bb:max-w-md",
        EffectiveSide switch
        {
            PopoverSide.Top => "bb:slide-in-from-bottom-2",
            PopoverSide.Bottom => "bb:slide-in-from-top-2",
            PopoverSide.Left => "bb:slide-in-from-right-2",
            PopoverSide.Right => "bb:slide-in-from-left-2",
            _ => "bb:slide-in-from-bottom-2"
        },
        Class
    );

    private string ArrowClass => ClassNames.cn(
        "bb:absolute bb:h-2 bb:w-2 bb:rotate-45 bb:bg-popover",
        EffectiveSide switch
        {
            PopoverSide.Top => "bb:bottom-0 bb:left-1/2 bb:-translate-x-1/2 bb:translate-y-1/2 bb:border-b bb:border-r bb:border-border",
            PopoverSide.Bottom => "bb:top-0 bb:left-1/2 bb:-translate-x-1/2 bb:-translate-y-1/2 bb:border-t bb:border-l bb:border-border",
            PopoverSide.Left => "bb:right-0 bb:top-1/2 bb:translate-x-1/2 bb:-translate-y-1/2 bb:border-t bb:border-r bb:border-border",
            PopoverSide.Right => "bb:left-0 bb:top-1/2 bb:-translate-x-1/2 bb:-translate-y-1/2 bb:border-b bb:border-l bb:border-border",
            _ => "bb:bottom-0 bb:left-1/2 bb:-translate-x-1/2 bb:translate-y-1/2 bb:border-b bb:border-r bb:border-border"
        }
    );
}
