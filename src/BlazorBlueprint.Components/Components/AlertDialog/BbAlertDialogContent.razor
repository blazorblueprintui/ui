@namespace BlazorBlueprint.Components

@*
    Alert Dialog Content - the modal content panel.
    Wraps the AlertDialog primitive which enforces no dismiss via click-outside or Escape.
*@

<BlazorBlueprint.Primitives.AlertDialog.BbAlertDialogPortal>
    <BlazorBlueprint.Primitives.AlertDialog.BbAlertDialogOverlay
        class="bb:fixed bb:inset-0 bb:z-50 bb:bg-black/80 bb:data-[state=open]:animate-in bb:data-[state=closed]:animate-out bb:data-[state=closed]:fade-out-0 bb:data-[state=open]:fade-in-0" />

    <BlazorBlueprint.Primitives.AlertDialog.BbAlertDialogContent
        class="@GetClassNames()"
        @attributes="AdditionalAttributes">
        @ChildContent
    </BlazorBlueprint.Primitives.AlertDialog.BbAlertDialogContent>
</BlazorBlueprint.Primitives.AlertDialog.BbAlertDialogPortal>

@code {
    /// <summary>
    /// The content to render inside the alert dialog.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the dialog content.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Additional attributes to apply to the dialog content.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the computed CSS classes for the alert dialog content.
    /// </summary>
    private string GetClassNames() => ClassNames.cn(
        "bb:fixed bb:left-[50%] bb:top-[50%] bb:z-50 bb:grid bb:w-full bb:max-w-lg bb:translate-x-[-50%] bb:translate-y-[-50%]",
        "bb:gap-4 bb:border bb:bg-background bb:p-6 bb:shadow-lg bb:duration-200",
        "bb:data-[state=open]:animate-in bb:data-[state=closed]:animate-out",
        "bb:data-[state=closed]:fade-out-0 bb:data-[state=open]:fade-in-0",
        "bb:data-[state=closed]:zoom-out-95 bb:data-[state=open]:zoom-in-95",
        "bb:sm:rounded-lg",
        Class
    );
}
