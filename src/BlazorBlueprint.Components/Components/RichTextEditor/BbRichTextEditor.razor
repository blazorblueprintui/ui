@namespace BlazorBlueprint.Components
@using Microsoft.JSInterop
@using BlazorBlueprint.Icons.Lucide.Components
@inject IJSRuntime JS
@inject IBbLocalizer Localizer
@implements IAsyncDisposable

<div class="@ContainerCssClass" data-slot="rich-text-editor" id="@Id" @attributes="AdditionalAttributes">
    @if (Toolbar != ToolbarPreset.None && ToolbarContent == null)
    {
        <div class="@ToolbarCssClass" data-slot="toolbar">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-0.5">
                @if (Toolbar >= ToolbarPreset.Standard)
                {
                    <BbButton Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.IconSmall"
                            OnClick="@(async _ => await UndoAsync())"
                            Disabled="@(Disabled || !_canUndo)"
                            Class="bb:h-8 bb:w-8"
                            AriaLabel="@Localizer["RichTextEditor.Undo"]"
                            title="@Localizer["RichTextEditor.Undo"]">
                        <LucideIcon Name="undo-2" Size="16" />
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.IconSmall"
                            OnClick="@(async _ => await RedoAsync())"
                            Disabled="@(Disabled || !_canRedo)"
                            Class="bb:h-8 bb:w-8"
                            AriaLabel="@Localizer["RichTextEditor.Redo"]"
                            title="@Localizer["RichTextEditor.Redo"]">
                        <LucideIcon Name="redo-2" Size="16" />
                    </BbButton>
                    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="bb:h-6 bb:mx-1" />

                    <BbNativeSelect TValue="string"
                                 Value="@_headerLevel"
                                 ValueChanged="@HandleHeaderChangeAsync"
                                 Disabled="@Disabled"
                                 Size="NativeSelectSize.Small"
                                 Class="bb:w-auto bb:min-w-[100px]">
                        <option value="">@Localizer["RichTextEditor.Normal"]</option>
                        <option value="1">@Localizer["RichTextEditor.Heading1"]</option>
                        <option value="2">@Localizer["RichTextEditor.Heading2"]</option>
                        <option value="3">@Localizer["RichTextEditor.Heading3"]</option>
                    </BbNativeSelect>
                    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="bb:h-6 bb:mx-1" />
                }

                <BbToggle Pressed="@_isBold"
                        PressedChanged="@(async _ => await ToggleFormatAsync("bold"))"
                        Size="ToggleSize.Small"
                        Disabled="@Disabled"
                        Class="bb:h-8 bb:w-8 bb:p-0"
                        title="@Localizer["RichTextEditor.Bold"]">
                    <LucideIcon Name="bold" Size="16" />
                </BbToggle>
                <BbToggle Pressed="@_isItalic"
                        PressedChanged="@(async _ => await ToggleFormatAsync("italic"))"
                        Size="ToggleSize.Small"
                        Disabled="@Disabled"
                        Class="bb:h-8 bb:w-8 bb:p-0"
                        title="@Localizer["RichTextEditor.Italic"]">
                    <LucideIcon Name="italic" Size="16" />
                </BbToggle>
                <BbToggle Pressed="@_isUnderline"
                        PressedChanged="@(async _ => await ToggleFormatAsync("underline"))"
                        Size="ToggleSize.Small"
                        Disabled="@Disabled"
                        Class="bb:h-8 bb:w-8 bb:p-0"
                        title="@Localizer["RichTextEditor.Underline"]">
                    <LucideIcon Name="underline" Size="16" />
                </BbToggle>

                @if (Toolbar >= ToolbarPreset.Standard)
                {
                    <BbToggle Pressed="@_isStrike"
                            PressedChanged="@(async _ => await ToggleFormatAsync("strike"))"
                            Size="ToggleSize.Small"
                            Disabled="@Disabled"
                            Class="bb:h-8 bb:w-8 bb:p-0"
                            title="@Localizer["RichTextEditor.Strikethrough"]">
                        <LucideIcon Name="strikethrough" Size="16" />
                    </BbToggle>
                }

                @if (Toolbar == ToolbarPreset.Full)
                {
                    <BbToggle Pressed="@_isCode"
                            PressedChanged="@(async _ => await ToggleFormatAsync("code"))"
                            Size="ToggleSize.Small"
                            Disabled="@Disabled"
                            Class="bb:h-8 bb:w-8 bb:p-0"
                            title="@Localizer["RichTextEditor.InlineCode"]">
                        <LucideIcon Name="square-code" Size="16" />
                    </BbToggle>

                    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="bb:h-6 bb:mx-1" />
                    <BbDropdownMenu>
                        <BbDropdownMenuTrigger AsChild="true">
                            <BbButton Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.IconSmall"
                                    Disabled="@Disabled"
                                    Class="bb:h-8 bb:w-8"
                                    AriaLabel="@Localizer["RichTextEditor.Align"]"
                                    title="@Localizer["RichTextEditor.Align"]">
                                <LucideIcon Name="@AlignIcon" Size="16" />
                            </BbButton>
                        </BbDropdownMenuTrigger>
                        <BbDropdownMenuContent>
                            @AlignItem("align-left", "RichTextEditor.AlignLeft", null)
                            @AlignItem("align-center", "RichTextEditor.AlignCenter", "center")
                            @AlignItem("align-right", "RichTextEditor.AlignRight", "right")
                            @AlignItem("align-justify", "RichTextEditor.AlignJustify", "justify")
                        </BbDropdownMenuContent>
                    </BbDropdownMenu>
                }

                <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="bb:h-6 bb:mx-1" />

                <BbToggle Pressed="@_isBulletList"
                        PressedChanged="@(async _ => await ToggleFormatAsync("list", "bullet"))"
                        Size="ToggleSize.Small"
                        Disabled="@Disabled"
                        Class="bb:h-8 bb:w-8 bb:p-0"
                        title="@Localizer["RichTextEditor.BulletList"]">
                    <LucideIcon Name="list" Size="16" />
                </BbToggle>
                <BbToggle Pressed="@_isOrderedList"
                        PressedChanged="@(async _ => await ToggleFormatAsync("list", "ordered"))"
                        Size="ToggleSize.Small"
                        Disabled="@Disabled"
                        Class="bb:h-8 bb:w-8 bb:p-0"
                        title="@Localizer["RichTextEditor.NumberedList"]">
                    <LucideIcon Name="list-ordered" Size="16" />
                </BbToggle>

                @if (Toolbar >= ToolbarPreset.Standard)
                {
                    <BbToggle Pressed="@_isCheckList"
                            PressedChanged="@(async _ => await ToggleFormatAsync("list", "check"))"
                            Size="ToggleSize.Small"
                            Disabled="@Disabled"
                            Class="bb:h-8 bb:w-8 bb:p-0"
                            title="@Localizer["RichTextEditor.CheckList"]">
                        <LucideIcon Name="list-todo" Size="16" />
                    </BbToggle>
                }

                @if (Toolbar == ToolbarPreset.Full)
                {
                    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="bb:h-6 bb:mx-1" />
                    <BbPopover Open="@_textColorOpen" OpenChanged="HandleTextColorOpenChanged">
                        <BbPopoverTrigger AsChild="true">
                            <BbButton Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.IconSmall"
                                    Disabled="@Disabled"
                                    Class="bb:h-8 bb:w-8"
                                    AriaLabel="@Localizer["RichTextEditor.TextColor"]"
                                    title="@Localizer["RichTextEditor.TextColor"]">
                                <LucideIcon Name="baseline" Size="16" />
                            </BbButton>
                        </BbPopoverTrigger>
                        <BbPopoverContent Align="PopoverAlign.Start" Class="bb:w-auto bb:p-2">
                            @ColorPalette("color", TextColors)
                        </BbPopoverContent>
                    </BbPopover>
                    <BbPopover Open="@_highlightOpen" OpenChanged="HandleHighlightOpenChanged">
                        <BbPopoverTrigger AsChild="true">
                            <BbButton Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.IconSmall"
                                    Disabled="@Disabled"
                                    Class="bb:h-8 bb:w-8"
                                    AriaLabel="@Localizer["RichTextEditor.Highlight"]"
                                    title="@Localizer["RichTextEditor.Highlight"]">
                                <LucideIcon Name="highlighter" Size="16" />
                            </BbButton>
                        </BbPopoverTrigger>
                        <BbPopoverContent Align="PopoverAlign.Start" Class="bb:w-auto bb:p-2">
                            @ColorPalette("background", HighlightColors)
                        </BbPopoverContent>
                    </BbPopover>
                }

                @if (Toolbar >= ToolbarPreset.Standard)
                {
                    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="bb:h-6 bb:mx-1" />
                    <BbButton Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.IconSmall"
                            OnClick="@(async _ => await InsertLinkAsync())"
                            Disabled="@Disabled"
                            Class="bb:h-8 bb:w-8"
                            AriaLabel="@Localizer["RichTextEditor.InsertLink"]"
                            title="@Localizer["RichTextEditor.InsertLink"]">
                        <LucideIcon Name="link" Size="16" />
                    </BbButton>
                }

                @if (Toolbar == ToolbarPreset.Full)
                {
                    <BbButton Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.IconSmall"
                            OnClick="@(async _ => await PickImageAsync())"
                            Disabled="@Disabled"
                            Class="bb:h-8 bb:w-8"
                            AriaLabel="@Localizer["RichTextEditor.InsertImage"]"
                            title="@Localizer["RichTextEditor.InsertImage"]">
                        <LucideIcon Name="image" Size="16" />
                    </BbButton>

                    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="bb:h-6 bb:mx-1" />
                    <BbToggle Pressed="@_isBlockquote"
                            PressedChanged="@(async _ => await ToggleFormatAsync("blockquote"))"
                            Size="ToggleSize.Small"
                            Disabled="@Disabled"
                            Class="bb:h-8 bb:w-8 bb:p-0"
                            title="@Localizer["RichTextEditor.Blockquote"]">
                        <LucideIcon Name="quote" Size="16" />
                    </BbToggle>
                    <BbToggle Pressed="@_isCodeBlock"
                            PressedChanged="@(async _ => await ToggleFormatAsync("code-block"))"
                            Size="ToggleSize.Small"
                            Disabled="@Disabled"
                            Class="bb:h-8 bb:w-8 bb:p-0"
                            title="@Localizer["RichTextEditor.CodeBlock"]">
                        <LucideIcon Name="code" Size="16" />
                    </BbToggle>

                    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="bb:h-6 bb:mx-1" />
                    <BbPopover @bind-Open="_tableMenuOpen" OnOpenChange="HandleTableMenuOpenChange">
                        <BbPopoverTrigger AsChild="true">
                            <BbButton Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.IconSmall"
                                    Disabled="@Disabled"
                                    Class="bb:h-8 bb:w-8"
                                    AriaLabel="@Localizer["RichTextEditor.Table"]"
                                    title="@Localizer["RichTextEditor.Table"]">
                                <LucideIcon Name="table" Size="16" />
                            </BbButton>
                        </BbPopoverTrigger>
                        <BbPopoverContent Align="PopoverAlign.Start" Class="bb:w-auto bb:p-1">
                            @if (_isInTable)
                            {
                                <div class="bb:flex bb:flex-col" data-slot="table-actions">
                                    @TableAction("between-horizontal-start", "RichTextEditor.InsertRowAbove", "insertRowAbove")
                                    @TableAction("between-horizontal-end", "RichTextEditor.InsertRowBelow", "insertRowBelow")
                                    @TableAction("between-vertical-start", "RichTextEditor.InsertColumnLeft", "insertColumnLeft")
                                    @TableAction("between-vertical-end", "RichTextEditor.InsertColumnRight", "insertColumnRight")
                                    <BbSeparator Class="bb:my-1" />
                                    @TableAction("rows-3", "RichTextEditor.DeleteRow", "deleteRow")
                                    @TableAction("columns-3", "RichTextEditor.DeleteColumn", "deleteColumn")
                                    @TableAction("trash-2", "RichTextEditor.DeleteTable", "deleteTable")
                                </div>
                            }
                            else
                            {
                                <div class="bb:flex bb:flex-col bb:gap-2 bb:p-1" data-slot="table-picker">
                                    <div class="bb:grid bb:grid-cols-6 bb:gap-1" role="grid" aria-label="@Localizer["RichTextEditor.InsertTable"]">
                                        @for (var r = 1; r <= TablePickerSize; r++)
                                        {
                                            for (var c = 1; c <= TablePickerSize; c++)
                                            {
                                                var rows = r;
                                                var columns = c;
                                                <button type="button"
                                                        class="@TablePickerCellClass(rows, columns)"
                                                        aria-label="@Localizer["RichTextEditor.TableSize", rows, columns]"
                                                        @onmouseover="@(() => SetTablePickerHover(rows, columns))"
                                                        @onfocus="@(() => SetTablePickerHover(rows, columns))"
                                                        @onclick="@(() => InsertTableFromPickerAsync(rows, columns))"></button>
                                            }
                                        }
                                    </div>
                                    <p class="bb:text-center bb:text-xs bb:text-muted-foreground">@TablePickerLabel</p>
                                </div>
                            }
                        </BbPopoverContent>
                    </BbPopover>
                }
            </div>
        </div>
    }

    @if (ToolbarContent != null)
    {
        <div class="@ToolbarCssClass" data-slot="custom-toolbar">
            @ToolbarContent
        </div>
    }

    <div @ref="_editorRef"
         class="@EditorCssClass"
         style="@EditorStyle"
         aria-label="@AriaLabel"
         aria-describedby="@AriaDescribedBy"
         aria-invalid="@(AriaInvalid?.ToString()?.ToLower())"
         data-slot="editor">
    </div>

    @* Link Dialog *@
    <BbDialog @bind-Open="_linkDialogOpen">
        <BbDialogContent Class="bb:sm:max-w-md">
            <BbDialogHeader>
                <BbDialogTitle>@(_hasExistingLink ? Localizer["RichTextEditor.EditLink"] : Localizer["RichTextEditor.InsertLinkTitle"])</BbDialogTitle>
                <BbDialogDescription>
                    @(_hasExistingLink ? Localizer["RichTextEditor.EditLinkDescription"] : Localizer["RichTextEditor.InsertLinkDescription"])
                </BbDialogDescription>
            </BbDialogHeader>
            <div class="bb:grid bb:gap-4 bb:py-4">
                <div class="bb:grid bb:gap-2">
                    <BbLabel For="link-url">URL</BbLabel>
                    <BbInput Id="link-url"
                           Type="InputType.Url"
                           Placeholder="https://example.com"
                           @bind-Value="_linkUrl"
                           @bind-Value:after="ValidateLinkUrl" />
                    @if (!string.IsNullOrEmpty(_linkUrlError))
                    {
                        <p class="bb:text-sm bb:text-destructive">@_linkUrlError</p>
                    }
                </div>
            </div>
            <BbDialogFooter Class="bb:flex-col bb:sm:flex-row bb:gap-2">
                @if (_hasExistingLink)
                {
                    <BbButton Variant="ButtonVariant.Destructive"
                            OnClick="RemoveLinkAsync"
                            Class="bb:sm:mr-auto">
                        @Localizer["RichTextEditor.RemoveLink"]
                    </BbButton>
                }
                <BbButton Variant="ButtonVariant.Outline" OnClick="CloseLinkDialog">
                    @Localizer["RichTextEditor.Cancel"]
                </BbButton>
                <BbButton OnClick="ApplyLinkAsync" Disabled="@(!IsValidUrl(_linkUrl))">
                    @(_hasExistingLink ? Localizer["RichTextEditor.Update"] : Localizer["RichTextEditor.Insert"])
                </BbButton>
            </BbDialogFooter>
        </BbDialogContent>
    </BbDialog>
</div>

@code {
    private RenderFragment AlignItem(string icon, string labelKey, string? value) => __builder =>
    {
        <BbDropdownMenuItem OnClick="@(async _ => await SetAlignAsync(value))">
            <Icon><LucideIcon Name="@icon" Size="16" /></Icon>
            <ChildContent>@Localizer[labelKey]</ChildContent>
        </BbDropdownMenuItem>
    };

    private RenderFragment ColorPalette(string format, IReadOnlyList<string> palette) => __builder =>
    {
        <div class="bb:flex bb:flex-col bb:gap-2" data-slot="color-palette">
            <div class="bb:grid bb:grid-cols-7 bb:gap-1" role="group">
                @foreach (var color in palette)
                {
                    var value = color;
                    <button type="button"
                            class="bb:h-6 bb:w-6 bb:rounded-sm bb:border bb:border-input bb:transition-transform bb:hover:scale-110 bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring"
                            style="background-color: @value"
                            aria-label="@value"
                            title="@value"
                            @onclick="@(() => SetColorAsync(format, value))"></button>
                }
            </div>
            <BbButton Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Small"
                    Class="bb:h-7 bb:justify-start bb:px-2 bb:font-normal"
                    OnClick="@(async _ => await SetColorAsync(format, null))">
                @Localizer["RichTextEditor.RemoveColor"]
            </BbButton>
        </div>
    };

    private RenderFragment TableAction(string icon, string labelKey, string action) => __builder =>
    {
        <BbButton Variant="ButtonVariant.Ghost"
                Size="ButtonSize.Small"
                Class="bb:h-8 bb:justify-start bb:gap-2 bb:px-2 bb:font-normal"
                OnClick="@(async _ => await RunTableActionAsync(action))">
            <LucideIcon Name="@icon" Size="16" />
            @Localizer[labelKey]
        </BbButton>
    };
}
