@namespace BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components
@using BlazorBlueprint.Primitives.DashboardGrid
@inject IBbLocalizer Localizer

@if (_removed) { return; }

<BlazorBlueprint.Primitives.DashboardGrid.BbDashboardWidget
    Id="@Id"
    Column="@Column"
    Row="@Row"
    ColumnSpan="@ColumnSpan"
    RowSpan="@RowSpan"
    MinColumnSpan="@MinColumnSpan"
    MinRowSpan="@MinRowSpan"
    MaxColumnSpan="@MaxColumnSpan"
    MaxRowSpan="@MaxRowSpan"
    Draggable="@Draggable"
    Resizable="@Resizable"
    Static="@Static"
    class="@CssClass"
    @attributes="AdditionalAttributes">

    @if (Header != null)
    {
        @Header
    }
    else if (Title != null)
    {
        <BbDashboardWidgetHeader>
            <span class="bb:text-sm bb:font-semibold">@Title</span>
        </BbDashboardWidgetHeader>
    }

    @if (_isEditable && OnRemove.HasDelegate)
    {
        <button type="button"
                class="bb:absolute bb:top-2 bb:right-2 bb:z-20 bb:p-1 bb:rounded-md bb:opacity-0 bb:group-hover:opacity-100 bb:transition-opacity bb:text-muted-foreground bb:hover:text-destructive bb:hover:bg-destructive/10"
                aria-label="@Localizer["DashboardGrid.RemoveWidget"]"
                @onclick="HandleRemove"
                @onclick:stopPropagation="true">
            <LucideIcon Name="trash" Class="bb:h-4 bb:w-4" />
        </button>
    }

    <BbDashboardWidgetContent>
        @if (Loading)
        {
            @if (LoadingContent != null)
            {
                @LoadingContent
            }
            else
            {
                <div class="bb:flex bb:flex-col bb:gap-3 bb:w-full bb:h-full bb:animate-pulse">
                    <div class="bb:h-4 bb:bg-muted bb:rounded bb:w-3/4"></div>
                    <div class="bb:h-4 bb:bg-muted bb:rounded bb:w-1/2"></div>
                    <div class="bb:flex-1 bb:bg-muted bb:rounded"></div>
                </div>
            }
        }
        else
        {
            @ChildContent
        }
    </BbDashboardWidgetContent>

    @if (Footer != null)
    {
        <div class="bb:border-t bb:px-4 bb:py-2">
            @Footer
        </div>
    }

    @if (_showResizeHandle)
    {
        @* Corner handles *@
        <div class="bb:absolute bb:top-0 bb:left-0 bb:w-4 bb:h-4 bb:cursor-nw-resize bb:z-10"
             data-dashboard-resize-handle="nw"
             data-widget-id="@Id"></div>
        <div class="bb:absolute bb:top-0 bb:right-0 bb:w-4 bb:h-4 bb:cursor-ne-resize bb:z-10"
             data-dashboard-resize-handle="ne"
             data-widget-id="@Id"></div>
        <div class="bb:absolute bb:bottom-0 bb:left-0 bb:w-4 bb:h-4 bb:cursor-sw-resize bb:z-10"
             data-dashboard-resize-handle="sw"
             data-widget-id="@Id"></div>
        <div class="bb:absolute bb:bottom-0 bb:right-0 bb:w-4 bb:h-4 bb:cursor-se-resize bb:z-10 bb:opacity-0 bb:group-hover:opacity-100 bb:focus:opacity-100 bb:transition-opacity"
             data-dashboard-resize-handle="se"
             data-widget-id="@Id"
             role="separator"
             tabindex="0"
             aria-label="@Localizer["DashboardGrid.ResizeWidget"]">
            <svg class="bb:w-4 bb:h-4 bb:text-muted-foreground" viewBox="0 0 16 16" fill="currentColor">
                <circle cx="11" cy="11" r="1.5" />
                <circle cx="7" cy="11" r="1.5" />
                <circle cx="11" cy="7" r="1.5" />
            </svg>
        </div>
        @* Edge handles *@
        <div class="bb:absolute bb:top-0 bb:left-4 bb:right-4 bb:h-2 bb:cursor-n-resize"
             data-dashboard-resize-handle="n"
             data-widget-id="@Id"></div>
        <div class="bb:absolute bb:bottom-0 bb:left-4 bb:right-4 bb:h-2 bb:cursor-s-resize"
             data-dashboard-resize-handle="s"
             data-widget-id="@Id"></div>
        <div class="bb:absolute bb:top-4 bb:right-0 bb:bottom-4 bb:w-2 bb:cursor-e-resize"
             data-dashboard-resize-handle="e"
             data-widget-id="@Id"></div>
        <div class="bb:absolute bb:top-4 bb:left-0 bb:bottom-4 bb:w-2 bb:cursor-w-resize"
             data-dashboard-resize-handle="w"
             data-widget-id="@Id"></div>
    }
</BlazorBlueprint.Primitives.DashboardGrid.BbDashboardWidget>

@code {
    [CascadingParameter] public DashboardGridContext? Context { get; set; }

    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter] public int Column { get; set; } = 1;
    [Parameter] public int Row { get; set; } = 1;
    [Parameter] public int ColumnSpan { get; set; } = 1;
    [Parameter] public int RowSpan { get; set; } = 1;
    [Parameter] public int MinColumnSpan { get; set; } = 4;
    [Parameter] public int MinRowSpan { get; set; } = 4;
    [Parameter] public int MaxColumnSpan { get; set; }
    [Parameter] public int MaxRowSpan { get; set; }
    [Parameter] public bool Draggable { get; set; } = true;
    [Parameter] public bool Resizable { get; set; } = true;
    [Parameter] public bool Static { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public RenderFragment? LoadingContent { get; set; }
    [Parameter] public EventCallback<string> OnRemove { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _removed;
    private DashboardGridContext? _subscribedContext;

    protected override void OnInitialized()
    {
        TrackContext();
    }

    protected override void OnParametersSet()
    {
        if (Context != _subscribedContext)
        {
            TrackContext();

            if (_removed && Context?.GetWidgetPosition(Id) == null)
            {
                _removed = false;
            }
        }
    }

    private void TrackContext()
    {
        _subscribedContext = Context;
    }

    private bool _isEditable =>
        !Static && (Context?.Editable ?? false);

    private bool _showResizeHandle =>
        Resizable && !Static && (Context?.AllowResize ?? false) && (Context?.Editable ?? false);

    private bool _isDraggable =>
        Draggable && !Static && (Context?.AllowDrag ?? false) && (Context?.Editable ?? false);

    private string CssClass => ClassNames.cn(
        "bb:rounded-lg bb:border bb:bg-card bb:text-card-foreground bb:shadow-sm bb:relative bb:overflow-hidden bb:group bb:flex bb:flex-col bb:h-full bb:outline-none",
        _isDraggable ? "bb:cursor-move" : "",
        Static ? "bb:opacity-75" : "",
        Class
    );

    private async Task HandleRemove()
    {
        _removed = true;
        await OnRemove.InvokeAsync(Id);
    }
}
