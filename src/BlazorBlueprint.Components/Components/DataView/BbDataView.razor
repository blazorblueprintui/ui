@namespace BlazorBlueprint.Components
@typeparam TItem where TItem : class
@using BlazorBlueprint.Icons.Lucide.Components
@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Primitives.Table

<CascadingValue Value="this" IsFixed="true">
    <div class="@ContainerCssClass" @attributes="AdditionalAttributes">

            @* ── Toolbar ─────────────────────────────────────────────────── *@
            @if (ShowToolbar)
            {
                <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:py-4">

                    @* Global search *@
                    <BbInput @bind-Value="@_searchValue"
                             @bind-Value:after="HandleSearchChanged"
                             Placeholder="@Localizer["DataView.SearchPlaceholder"]"
                             Class="bb:h-8 bb:w-[150px] bb:lg:w-[250px]" />

                    @* Sort controls – only shown when at least one field is sortable *@
                    @if (_fields.Any(f => f.Sortable))
                    {
                        <BbDropdownMenu>
                            <BbDropdownMenuTrigger>
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="bb:h-8 bb:gap-1">
                                    @if (_sortingState.Direction == SortDirection.Ascending)
                                    {
                                        <LucideIcon Name="arrow-up" Class="bb:w-4 bb:h-4" />
                                    }
                                    else if (_sortingState.Direction == SortDirection.Descending)
                                    {
                                        <LucideIcon Name="arrow-down" Class="bb:w-4 bb:h-4" />
                                    }
                                    else
                                    {
                                        <LucideIcon Name="arrow-up-down" Class="bb:w-4 bb:h-4 bb:opacity-50" />
                                    }
                                    @GetSortFieldLabel()
                                    <LucideIcon Name="chevron-down" Class="bb:w-3 bb:h-3 bb:opacity-50" />
                                </BbButton>
                            </BbDropdownMenuTrigger>
                            <BbDropdownMenuContent>
                                @foreach (var field in _fields.Where(f => f.Sortable))
                                {
                                    var fieldId = field.Id;
                                    var isSorted = _sortingState.SortedColumn == fieldId;
                                    <BbDropdownMenuItem OnClick="@(async () => await HandleSortFieldChanged(fieldId))">
                                        <div class="bb:flex bb:items-center bb:gap-2">
                                            @if (isSorted && _sortingState.Direction == SortDirection.Ascending)
                                            {
                                                <LucideIcon Name="arrow-up" Class="bb:w-4 bb:h-4" />
                                            }
                                            else if (isSorted && _sortingState.Direction == SortDirection.Descending)
                                            {
                                                <LucideIcon Name="arrow-down" Class="bb:w-4 bb:h-4" />
                                            }
                                            else
                                            {
                                                <LucideIcon Name="arrow-up-down" Class="bb:w-4 bb:h-4 bb:opacity-50" />
                                            }
                                            @field.Header
                                        </div>
                                    </BbDropdownMenuItem>
                                }
                            </BbDropdownMenuContent>
                        </BbDropdownMenu>
                    }

                    @* Right side: ToolbarActions + layout toggle (both pushed to the right with ml-auto) *@
                    @if (ToolbarActions != null || CanToggleLayout)
                    {
                        <div class="bb:ml-auto bb:flex bb:items-center bb:gap-2">
                            @if (ToolbarActions != null)
                            {
                                @ToolbarActions
                            }
                            @if (CanToggleLayout)
                            {
                                <div class="bb:flex bb:items-center bb:gap-1 bb:rounded-md bb:border bb:p-1">
                                    <BbButton Variant="ButtonVariant.Ghost"
                                              Size="ButtonSize.Icon"
                                              OnClick="@(() => SetLayout(DataViewLayout.List))"
                                              Class="@ClassNames.cn("bb:h-7 bb:w-7", _effectiveLayout == DataViewLayout.List ? "bb:bg-accent bb:text-accent-foreground" : "")"
                                              title="@Localizer["DataView.ListView"]">
                                        <LucideIcon Name="list" Class="bb:w-4 bb:h-4" />
                                    </BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost"
                                              Size="ButtonSize.Icon"
                                              OnClick="@(() => SetLayout(DataViewLayout.Grid))"
                                              Class="@ClassNames.cn("bb:h-7 bb:w-7", _effectiveLayout == DataViewLayout.Grid ? "bb:bg-accent bb:text-accent-foreground" : "")"
                                              title="@Localizer["DataView.GridView"]">
                                        <LucideIcon Name="layout-grid" Class="bb:w-4 bb:h-4" />
                                    </BbButton>
                                </div>
                            }
                        </div>
                    }

                </div>
            }

            @* ── Content ─────────────────────────────────────────────────── *@
            @if (IsLoading || _isProviderLoading)
            {
                @if (LoadingTemplate != null)
                {
                    @LoadingTemplate
                }
                else
                {
                    <div class="bb:flex bb:items-center bb:justify-center bb:p-8 bb:text-muted-foreground">
                        <div class="bb:text-sm">@Localizer["DataView.Loading"]</div>
                    </div>
                }
            }
            else if (_filteredSortedData.Count == 0)
            {
                @if (EmptyTemplate != null)
                {
                    @EmptyTemplate
                }
                else
                {
                    <BbEmpty Title="@Localizer["DataView.NoResultsFound"]" Size="EmptySize.Small" />
                }
            }
            else if (EnableInfiniteScroll && !ShowLoadMoreButton)
            {
                @*
                    Scroll-based infinite scroll.
                    The items grid/list lives inside a fixed-height scrollable container.
                    The browser watches the scroll container (elementUtils.observeNearBottom)
                    and calls back once when it nears the bottom. It measures the container as
                    a whole, so it works for both flex lists and multi-column CSS grids
                    (regardless of items-per-row count) — and it never sends a scroll event to
                    the server.
                    The sentinel <div> is placed OUTSIDE the grid container so it is always
                    a full-width block element below all rows, never occupying an empty grid cell.
                *@
                <div class="bb:overflow-y-auto"
                     style="@(ScrollHeight != null ? $"height: {ScrollHeight}" : "")"
                     @ref="_scrollContainerRef"
                     role="region"
                     aria-live="polite">
                    <div class="@ItemContainerCssClass" style="@ItemContainerStyle">
                        @foreach (var item in _visibleData)
                        {
                            @if (EffectiveActiveTemplate != null)
                            {
                                @EffectiveActiveTemplate(item)
                            }
                        }
                    </div>
                    @* Sentinel is outside the grid so it spans the full scroll-container
                       width regardless of the column count. *@
                    @if (CanLoadMore)
                    {
                        <div class="bb:flex bb:items-center bb:justify-center bb:py-2 bb:text-xs bb:text-muted-foreground">
                            @Localizer["DataView.LoadingMore"]
                        </div>
                    }
                </div>
            }
            else
            {
                @* Regular pagination or ShowLoadMoreButton mode. *@
                <div class="@ItemContainerCssClass" style="@ItemContainerStyle" role="region" aria-live="polite">
                    @foreach (var item in _visibleData)
                    {
                        @if (EffectiveActiveTemplate != null)
                        {
                            @EffectiveActiveTemplate(item)
                        }
                    }
                </div>

                @*
                    "Load more" button is placed OUTSIDE (after) the grid/flex container.
                    This guarantees it always renders as a full-width block element on its
                    own row, even when the grid has 2, 3, or 4 columns and the last row is
                    only partially filled.
                *@
                @if (EnableInfiniteScroll && CanLoadMore && ShowLoadMoreButton)
                {
                    <div class="bb:flex bb:justify-center bb:py-4">
                        <BbButton Variant="ButtonVariant.Outline" OnClick="LoadMore">
                            @Localizer["DataView.LoadMore"]
                        </BbButton>
                    </div>
                }
            }

            @* ── Pagination – hidden in infinite scroll mode ─────────────── *@
            @if (ShowPagination && !EnableInfiniteScroll && !IsLoading && !_isProviderLoading && _filteredSortedData.Count > 0)
            {
                <BbPagination State="@_paginationState"
                              PageSizes="@PageSizes"
                              OnPageChanged="@HandlePageChanged"
                              OnPageSizeChanged="@HandlePageSizeChanged"
                              Class="bb:flex bb:items-center bb:justify-between bb:px-2 bb:py-4">
                    <BbPaginationInfo />
                    <BbPaginationContent Class="bb:flex bb:items-center bb:gap-6 bb:lg:gap-8">
                        <BbPaginationPageSizeSelector Label="Items per page" />
                        <div class="bb:flex bb:items-center bb:gap-2">
                            <BbPaginationPageDisplay />
                            <div class="bb:flex bb:items-center bb:gap-1">
                                <BbPaginationItem><BbPaginationFirst /></BbPaginationItem>
                                <BbPaginationItem><BbPaginationPrevious ShowText="false" /></BbPaginationItem>
                                <BbPaginationItem><BbPaginationNext ShowText="false" /></BbPaginationItem>
                                <BbPaginationItem><BbPaginationLast /></BbPaginationItem>
                            </div>
                        </div>
                    </BbPaginationContent>
                </BbPagination>
            }

        </div>

        @* Capture slot-component registrations (renders nothing visible). *@
        @Fields

</CascadingValue>
