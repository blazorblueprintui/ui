@namespace BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components
@inject ThemeService ThemeService
@inject IBbLocalizer Localizer
@implements IDisposable

<BbPopover @bind-Open="isOpen" @attributes="AdditionalAttributes">
    <BbPopoverTrigger AsChild="true">
        <BbButton Variant="@Variant" Size="ButtonSize.Icon" Class="@TriggerClass"
                  aria-label="@Localizer["Theme.Switcher.Label"]">
            <LucideIcon Name="paintbrush" Class="bb:h-4 bb:w-4" />
        </BbButton>
    </BbPopoverTrigger>
    <BbPopoverContent Class="@ClassNames.cn("bb:w-[340px] bb:max-h-[calc(100dvh-2rem)] bb:overflow-y-auto bb:p-0", PopoverContentClass)"
                      Align="@Align"
                      Strategy="@Strategy">

        @* ── Header ── *@
        <div class="bb:p-4 bb:pb-1">
            <p class="bb:text-sm bb:font-semibold bb:leading-none">@Localizer["Theme.Switcher.Title"]</p>
            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">@Localizer["Theme.Switcher.Description"]</p>
        </div>

        <BbSeparator Class="bb:my-2" />

        @if (ColorLayout == ThemeSwitcherColorLayout.Combined)
        {
            @* ── Color (combined grid, single indicator) ── *@
            <div class="bb:px-4 bb:py-2 bb:space-y-2">
                <p class="bb:text-xs bb:font-medium bb:text-muted-foreground">@Localizer["Theme.Color"]</p>
                <div class="bb:grid bb:grid-cols-3 bb:gap-1.5">
                    @foreach (var color in baseColors)
                    {
                        @ColorChip(color.Label, color.Swatch,
                            ThemeService.PrimaryColor == PrimaryColor.Default && ThemeService.BaseColor == color.Value,
                            () => OnCombinedBaseSelectedAsync(color.Value))
                    }
                    @foreach (var color in primaryColors)
                    {
                        @ColorChip(color.Label, color.Swatch,
                            ThemeService.PrimaryColor == color.Value,
                            () => ThemeService.SetPrimaryColorAsync(color.Value))
                    }
                </div>
            </div>
        }
        else
        {
            @* ── Base color ── *@
            <div class="bb:px-4 bb:py-2 bb:space-y-2">
                <p class="bb:text-xs bb:font-medium bb:text-muted-foreground">@Localizer["Theme.BaseColor"]</p>
                <div class="bb:grid bb:grid-cols-3 bb:gap-1.5">
                    @foreach (var color in baseColors)
                    {
                        @ColorChip(color.Label, color.Swatch,
                            ThemeService.BaseColor == color.Value,
                            () => ThemeService.SetBaseColorAsync(color.Value))
                    }
                </div>
            </div>

            <BbSeparator Class="bb:my-2" />

            @* ── Primary color ── *@
            <div class="bb:px-4 bb:py-2 bb:space-y-2">
                <p class="bb:text-xs bb:font-medium bb:text-muted-foreground">@Localizer["Theme.PrimaryColor"]</p>
                <div class="bb:grid bb:grid-cols-3 bb:gap-1.5">
                    @ColorChip(Localizer["Theme.Default"], CurrentBaseSwatch,
                        ThemeService.PrimaryColor == PrimaryColor.Default,
                        () => ThemeService.SetPrimaryColorAsync(PrimaryColor.Default))
                    @foreach (var color in primaryColors)
                    {
                        @ColorChip(color.Label, color.Swatch,
                            ThemeService.PrimaryColor == color.Value,
                            () => ThemeService.SetPrimaryColorAsync(color.Value))
                    }
                </div>
            </div>
        }

        <BbSeparator Class="bb:my-2" />

        @* ── Radius ── *@
        <div class="bb:px-4 bb:py-2 bb:space-y-2">
            <p class="bb:text-xs bb:font-medium bb:text-muted-foreground">@Localizer["Theme.Radius"]</p>
            <div class="bb:flex bb:gap-1.5">
                @foreach (var r in radiusOptions)
                {
                    var isSelected = Math.Abs(ThemeService.Radius - r) < 0.001;
                    <button type="button"
                            class="@ClassNames.cn(
                                "bb:flex-1 bb:rounded-md bb:border bb:px-2 bb:py-1.5 bb:text-xs bb:text-center bb:transition-colors bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring",
                                isSelected ? "bb:border-foreground bb:bg-accent" : "bb:border-input bb:hover:bg-accent/50")"
                            @onclick="() => OnRadiusSelected(r)"
                            aria-pressed="@isSelected.ToString().ToLowerInvariant()">
                        @r.ToString("0.0##", System.Globalization.CultureInfo.InvariantCulture)
                    </button>
                }
            </div>
        </div>

        <BbSeparator Class="bb:my-2" />

        @* ── Mode ── *@
        <div class="bb:px-4 bb:pt-2 bb:pb-4 bb:space-y-2">
            <p class="bb:text-xs bb:font-medium bb:text-muted-foreground">@Localizer["Theme.Mode"]</p>
            <div class="bb:grid bb:grid-cols-2 bb:gap-1.5">
                <button type="button"
                        class="@ClassNames.cn(
                            "bb:inline-flex bb:items-center bb:justify-center bb:gap-1.5 bb:rounded-md bb:border bb:px-3 bb:py-1.5 bb:text-xs bb:font-medium bb:transition-colors bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring",
                            !ThemeService.IsDarkMode ? "bb:border-foreground bb:bg-accent" : "bb:border-input bb:hover:bg-accent/50")"
                        @onclick="() => OnModeSelected(false)"
                        aria-pressed="@((!ThemeService.IsDarkMode).ToString().ToLowerInvariant())">
                    <LucideIcon Name="sun" Class="bb:h-3.5 bb:w-3.5" />
                    @Localizer["Theme.Light"]
                </button>
                <button type="button"
                        class="@ClassNames.cn(
                            "bb:inline-flex bb:items-center bb:justify-center bb:gap-1.5 bb:rounded-md bb:border bb:px-3 bb:py-1.5 bb:text-xs bb:font-medium bb:transition-colors bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring",
                            ThemeService.IsDarkMode ? "bb:border-foreground bb:bg-accent" : "bb:border-input bb:hover:bg-accent/50")"
                        @onclick="() => OnModeSelected(true)"
                        aria-pressed="@ThemeService.IsDarkMode.ToString().ToLowerInvariant()">
                    <LucideIcon Name="moon" Class="bb:h-3.5 bb:w-3.5" />
                    @Localizer["Theme.Dark"]
                </button>
            </div>
        </div>

        @if (ShowDesignOptions)
        {
            <BbSeparator Class="bb:my-2" />
            <div class="bb:grid bb:grid-cols-2 bb:gap-2 bb:px-4 bb:pb-4">
                <label class="bb:space-y-1 bb:text-xs">
                    @Localizer["Theme.Density"]
                    <BbNativeSelect TValue="ThemeDensity" Value="@ThemeService.Preset.Design.Density"
                                    ValueChanged="@(value => ThemeService.SetDesignAsync(ThemeService.Preset.Design with { Density = value }))">
                        @foreach (var option in Enum.GetValues<ThemeDensity>())
                        {
                            <option value="@option">@option</option>
                        }
                    </BbNativeSelect>
                </label>
                <label class="bb:space-y-1 bb:text-xs">
                    @Localizer["Theme.Font"]
                    <BbNativeSelect TValue="ThemeFont" Value="@ThemeService.Preset.Design.Font"
                                    ValueChanged="@(value => ThemeService.SetDesignAsync(ThemeService.Preset.Design with { Font = value }))">
                        @foreach (var option in Enum.GetValues<ThemeFont>())
                        {
                            <option value="@option">@option</option>
                        }
                    </BbNativeSelect>
                </label>
                <label class="bb:space-y-1 bb:text-xs">
                    @Localizer["Theme.Surface"]
                    <BbNativeSelect TValue="ThemeSurface" Value="@ThemeService.Preset.Design.Surface"
                                    ValueChanged="@(value => ThemeService.SetDesignAsync(ThemeService.Preset.Design with { Surface = value }))">
                        @foreach (var option in Enum.GetValues<ThemeSurface>())
                        {
                            <option value="@option">@option</option>
                        }
                    </BbNativeSelect>
                </label>
                <label class="bb:space-y-1 bb:text-xs">
                    @Localizer["Theme.MenuColor"]
                    <BbNativeSelect TValue="ThemeMenuColor" Value="@ThemeService.Preset.Design.MenuColor"
                                    ValueChanged="@(value => ThemeService.SetDesignAsync(ThemeService.Preset.Design with { MenuColor = value }))">
                        @foreach (var option in Enum.GetValues<ThemeMenuColor>())
                        {
                            <option value="@option">@option</option>
                        }
                    </BbNativeSelect>
                </label>
                <label class="bb:space-y-1 bb:text-xs">
                    @Localizer["Theme.MenuAccent"]
                    <BbNativeSelect TValue="ThemeMenuAccent" Value="@ThemeService.Preset.Design.MenuAccent"
                                    ValueChanged="@(value => ThemeService.SetDesignAsync(ThemeService.Preset.Design with { MenuAccent = value }))">
                        @foreach (var option in Enum.GetValues<ThemeMenuAccent>())
                        {
                            <option value="@option">@option</option>
                        }
                    </BbNativeSelect>
                </label>
            </div>
        }
    </BbPopoverContent>
</BbPopover>

@code {
    /// <summary>Shows density, font, surface and menu appearance selectors.</summary>
    [Parameter] public bool ShowDesignOptions { get; set; }

    private bool isOpen;

    /// <summary>
    /// The visual variant of the trigger button. Defaults to <see cref="ButtonVariant.Outline"/>.
    /// </summary>
    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Outline;

    /// <summary>
    /// Additional CSS classes for the trigger button.
    /// </summary>
    [Parameter]
    public string? TriggerClass { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Additional CSS classes for the popover content panel.
    /// </summary>
    [Parameter]
    public string? PopoverContentClass { get; set; }

    /// <summary>
    /// Horizontal alignment of the popover relative to the trigger.
    /// Defaults to <see cref="PopoverAlign.End"/>.
    /// </summary>
    [Parameter]
    public PopoverAlign Align { get; set; } = PopoverAlign.End;

    /// <summary>
    /// Positioning strategy for the popover. Defaults to <see cref="PositioningStrategy.Absolute"/>.
    /// </summary>
    [Parameter]
    public PositioningStrategy Strategy { get; set; } = PositioningStrategy.Absolute;

    /// <summary>
    /// Layout of the color selection area. Defaults to <see cref="ThemeSwitcherColorLayout.Split"/>,
    /// which shows separate base color and primary color sections with independent selection
    /// indicators. Use <see cref="ThemeSwitcherColorLayout.Combined"/> for the legacy single-grid
    /// layout where selecting a base color resets the primary color to <see cref="PrimaryColor.Default"/>.
    /// </summary>
    [Parameter]
    public ThemeSwitcherColorLayout ColorLayout { get; set; } = ThemeSwitcherColorLayout.Split;

    /// <inheritdoc />
    protected override void OnInitialized() =>
        ThemeService.OnThemeChanged += HandleThemeChanged;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !ThemeService.IsInitialized)
        {
            await ThemeService.InitializeAsync();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Renders a single color chip button with an optional selected indicator.
    /// </summary>
    private RenderFragment ColorChip(string label, string swatch, bool isSelected, Func<Task> onClick) => __builder =>
    {
        <button type="button"
                class="@ClassNames.cn(
                    "bb:inline-flex bb:items-center bb:gap-1.5 bb:rounded-md bb:border bb:px-2 bb:py-1.5 bb:text-xs bb:transition-colors",
                    isSelected ? "bb:border-foreground bb:bg-accent" : "bb:border-input bb:hover:bg-accent/50")"
                @onclick="onClick"
                aria-pressed="@isSelected.ToString().ToLowerInvariant()">
            @if (isSelected)
            {
                <span class="bb:flex bb:h-4 bb:w-4 bb:shrink-0 bb:items-center bb:justify-center bb:rounded-full bb:border-2 bb:border-foreground"
                      style="background-color: @swatch;">
                    <LucideIcon Name="check" Class="bb:h-2.5 bb:w-2.5 bb:text-white" />
                </span>
            }
            else
            {
                <span class="bb:h-4 bb:w-4 bb:shrink-0 bb:rounded-full" style="background-color: @swatch;"></span>
            }
            @label
        </button>
    };

    /// <summary>
    /// Combined layout only: when a base color is picked, set the base AND reset primary
    /// to Default so the base's own accent is used.
    /// </summary>
    private async Task OnCombinedBaseSelectedAsync(BaseColor value)
    {
        await ThemeService.SetPrimaryColorAsync(PrimaryColor.Default);
        await ThemeService.SetBaseColorAsync(value);
    }

    private async Task OnRadiusSelected(double value) =>
        await ThemeService.SetRadiusAsync(value);

    private async Task OnModeSelected(bool dark) =>
        await ThemeService.SetDarkModeAsync(dark);

    private void HandleThemeChanged() =>
        InvokeAsync(StateHasChanged);

    /// <inheritdoc />
    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
        GC.SuppressFinalize(this);
    }

    // ── Data ──────────────────────────────────────────────────────────────

    private static readonly double[] radiusOptions = [0, 0.3, 0.5, 0.75, 1.0];

    private static readonly ColorInfo<BaseColor>[] baseColors =
    [
        new("Zinc", "oklch(0.552 0.016 285.94)", BaseColor.Zinc),
        new("Slate", "oklch(0.554 0.046 257.42)", BaseColor.Slate),
        new("Stone", "oklch(0.553 0.013 58.07)", BaseColor.Stone),
        new("Gray", "oklch(0.551 0.027 264.36)", BaseColor.Gray),
        new("Neutral", "oklch(0.556 0 0)", BaseColor.Neutral),
    ];

    private static readonly ColorInfo<PrimaryColor>[] primaryColors =
    [
        new("Red", "oklch(0.577 0.245 27.33)", PrimaryColor.Red),
        new("Rose", "oklch(0.585 0.22 3.96)", PrimaryColor.Rose),
        new("Orange", "oklch(0.705 0.213 47.60)", PrimaryColor.Orange),
        new("Amber", "oklch(0.769 0.188 70.08)", PrimaryColor.Amber),
        new("Yellow", "oklch(0.852 0.199 91.94)", PrimaryColor.Yellow),
        new("Lime", "oklch(0.768 0.233 130.85)", PrimaryColor.Lime),
        new("Green", "oklch(0.596 0.145 163.23)", PrimaryColor.Green),
        new("Emerald", "oklch(0.596 0.145 163.23)", PrimaryColor.Emerald),
        new("Teal", "oklch(0.627 0.134 184.13)", PrimaryColor.Teal),
        new("Cyan", "oklch(0.655 0.151 207.08)", PrimaryColor.Cyan),
        new("Sky", "oklch(0.6 0.118 184.71)", PrimaryColor.Sky),
        new("Blue", "oklch(0.546 0.245 262.88)", PrimaryColor.Blue),
        new("Indigo", "oklch(0.488 0.243 264.38)", PrimaryColor.Indigo),
        new("Violet", "oklch(0.541 0.281 293.01)", PrimaryColor.Violet),
        new("Purple", "oklch(0.553 0.261 301.92)", PrimaryColor.Purple),
        new("Fuchsia", "oklch(0.591 0.293 322.90)", PrimaryColor.Fuchsia),
        new("Pink", "oklch(0.592 0.249 0.58)", PrimaryColor.Pink),
    ];

    /// <summary>
    /// Swatch of the currently active base color — used for the "Default" primary chip,
    /// since the Default primary inherits its accent from the base palette.
    /// </summary>
    private string CurrentBaseSwatch
    {
        get
        {
            foreach (var color in baseColors)
            {
                if (color.Value == ThemeService.BaseColor)
                {
                    return color.Swatch;
                }
            }

            return baseColors[0].Swatch;
        }
    }

    private sealed class ColorInfo<TColor>(string label, string swatch, TColor value) where TColor : struct, Enum
    {
        public string Label { get; } = label;
        public string Swatch { get; } = swatch;
        public TColor Value { get; } = value;
    }
}
