@namespace BlazorBlueprint.Components

<BbSelectionIndicator Selector="[data-sidebar=menu-button][data-active=true]" HoverSelector="@(FollowHover ? "[data-sidebar=menu-button]:not([aria-disabled=true])" : null)" Duration="Duration"
                      Class="@ClassNames.cn("bb:bg-sidebar-accent", Class)" />
@code {
    /// <summary>Also follows pointer hover and keyboard focus.</summary>
    [Parameter] public bool FollowHover { get; set; }
    /// <summary>Animation duration in milliseconds.</summary>
    [Parameter] public int Duration { get; set; } = 200;
    /// <summary>Additional indicator classes. Place before a menu inside a positioned wrapper.</summary>
    [Parameter] public string? Class { get; set; }
}
