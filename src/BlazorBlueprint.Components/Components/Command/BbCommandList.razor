@namespace BlazorBlueprint.Components
@inject IBbLocalizer Localizer
@inject IJSRuntime JSRuntime
@using Microsoft.JSInterop
@implements IAsyncDisposable

<div id="@Context?.ListId"
     @ref="_scrollRef"
     class="@CssClass"
     role="listbox"
     aria-label="@Localizer["Command.CommandList"]"
     @attributes="AdditionalAttributes">
    @ChildContent
    @if (IsLoading)
    {
        <div class="bb:flex bb:items-center bb:justify-center bb:py-2">
            <BbSpinner Size="SpinnerSize.Small" />
        </div>
    }
    else if (!string.IsNullOrEmpty(EndOfListMessage))
    {
        <div class="bb:py-2 bb:text-center bb:text-xs bb:text-muted-foreground">
            @EndOfListMessage
        </div>
    }
</div>

@code {
    private ElementReference _scrollRef;
    private DotNetObjectReference<BbCommandList>? _selfRef;
    private int _nearBottomObserver;
    private int _hoverObserver;

    [CascadingParameter]
    public CommandContext? Context { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the list container.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the content to be rendered inside the list.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the user scrolls near the bottom of the list.
    /// Use this to load additional items for infinite scroll scenarios.
    /// </summary>
    [Parameter]
    public EventCallback OnLoadMore { get; set; }

    /// <summary>
    /// Gets or sets whether additional items are currently being loaded.
    /// When true, a loading spinner is shown at the bottom of the list and
    /// <see cref="OnLoadMore"/> is suppressed until loading completes.
    /// </summary>
    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Gets or sets a message displayed at the bottom of the list when all items have been loaded.
    /// Only shown when <see cref="IsLoading"/> is false. Set to <c>null</c> or empty to hide.
    /// </summary>
    [Parameter]
    public string? EndOfListMessage { get; set; }

    /// <summary>
    /// Gets the computed CSS classes for the list container.
    /// </summary>
    private string CssClass => ClassNames.cn(
        "bb:max-h-[300px] bb:overflow-y-auto bb:overflow-x-hidden",
        Class
    );

    // No @onscroll. It bound every scroll event to the server — around sixty circuit messages a
    // second while the wheel turned — and each one then awaited isNearBottom before deciding
    // anything, so every scroll event was also a round trip. The browser now watches the element
    // itself and calls back exactly once when the scroll position enters the near-bottom zone.
    // Attached without awaiting: it lands one round trip later either way, and nothing here
    // waits on it.
    //
    // The same listener does hover. Every item used to bind @onmouseenter and @onmousemove to the
    // server — a circuit message per pixel of pointer travel, and a re-render of every item per
    // item crossed. One delegated listener on the list tells a real hover from the list scrolling
    // under a stationary pointer, and calls back once per item the pointer actually moves onto.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _ = AttachObserversAsync();
        }
    }

    private async Task AttachObserversAsync()
    {
        try
        {
            var module = await PrimitiveModules.GetAsync(JSRuntime);
            _selfRef ??= DotNetObjectReference.Create(this);

            _hoverObserver = await module.InvokeAsync<int>(
                "elementUtils.observeHover", _scrollRef, _selfRef, nameof(JsOnHover), "[role=\"option\"]");

            if (OnLoadMore.HasDelegate)
            {
                _nearBottomObserver = await module.InvokeAsync<int>(
                    "elementUtils.observeNearBottom", _scrollRef, _selfRef, nameof(JsOnNearBottom), 80.0);
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            // Circuit gone, prerendering, or the list already torn down. Both are courtesies.
        }
    }

    /// <summary>
    /// Called from JavaScript when the pointer moves onto a different item.
    /// </summary>
    [JSInvokable]
    public void JsOnHover(string itemId) => Context?.HoverItemById(itemId);

    /// <summary>
    /// Called from JavaScript when the list scrolls near its bottom.
    /// </summary>
    [JSInvokable]
    public async Task JsOnNearBottom()
    {
        if (!OnLoadMore.HasDelegate || IsLoading)
        {
            return;
        }

        await OnLoadMore.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if ((_nearBottomObserver != 0 || _hoverObserver != 0) && PrimitiveModules.TryGetLoaded(JSRuntime, out var module))
        {
            var nearBottom = _nearBottomObserver;
            var hover = _hoverObserver;
            _nearBottomObserver = 0;
            _hoverObserver = 0;

            try
            {
                if (hover != 0)
                {
                    await module.InvokeVoidAsync("elementUtils.unobserveHover", hover);
                }

                if (nearBottom != 0)
                {
                    await module.InvokeVoidAsync("elementUtils.unobserveNearBottom", nearBottom);
                }
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // Circuit gone — the listeners went with the document.
            }
        }

        _selfRef?.Dispose();
        _selfRef = null;
    }
}
