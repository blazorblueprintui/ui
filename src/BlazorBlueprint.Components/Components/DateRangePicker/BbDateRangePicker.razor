@namespace BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components

<BbPopover @bind-Open="_isOpen" @attributes="AdditionalAttributes">
    <BbPopoverTrigger AsChild="true">
        <BbButton Variant="ButtonVariant.Outline"
                Class="@ButtonCssClass"
                Disabled="@Disabled">
            <LucideIcon Name="calendar" Class="bb:mr-2 bb:h-4 bb:w-4" />
            @if (Value != null)
            {
                <span>@FormatRange(Value)</span>
            }
            else
            {
                <span class="bb:text-muted-foreground">@EffectivePlaceholder</span>
            }
        </BbButton>
    </BbPopoverTrigger>
    <BbPopoverContent Class="bb:w-[calc(100vw-6rem)] bb:p-0" Align="@PopoverAlign.Start" data-drp>
        <div class="bb:flex bb:flex-col">
            @if (ShowPresets)
            {
                <div class="bb:flex bb:flex-col bb:border-b" data-drp-body>
                    <div class="bb:p-3 bb:border-b" data-drp-presets>
                        @* Mobile: native select *@
                        <div data-drp-presets-select>
                            <BbNativeSelect TValue="int"
                                            Value="_selectedPresetIndex"
                                            ValueChanged="OnPresetSelectChanged"
                                            Placeholder="@Localizer["DateRangePicker.QuickSelect"]"
                                            Size="NativeSelectSize.Small">
                                @for (var i = 0; i < EffectivePresets.Count; i++)
                                {
                                    <option value="@i">@ResolveLabel(EffectivePresets[i])</option>
                                }
                            </BbNativeSelect>
                        </div>
                        @* Desktop: button sidebar *@
                        <div class="bb:hidden" data-drp-presets-inner>
                            <span class="bb:hidden bb:text-xs bb:font-medium bb:text-muted-foreground bb:mb-1" data-drp-presets-label>@Localizer["DateRangePicker.QuickSelect"]</span>
                            @foreach (var quickPick in EffectivePresets)
                            {
                                var captured = quickPick;
                                <BbButton Variant="ButtonVariant.Ghost"
                                          Size="ButtonSize.Small"
                                          Class="@GetPresetButtonClass(captured)"
                                          data-drp-preset-btn
                                          OnClick="@(() => ApplyPreset(captured))">
                                    @ResolveLabel(captured)
                                </BbButton>
                            }
                        </div>
                    </div>
                    <div class="bb:flex-1">
                        @* Inline Calendars *@
                        <div class="@(ShowTwoMonths ? "bb:flex" : "")">
                            @* First Calendar *@
                            <div class="bb:flex-1 bb:px-5 bb:py-3" data-drp-calendar>
                                <div class="bb:flex bb:items-center bb:justify-between bb:mb-3">
                                    <button type="button"
                                            class="bb:inline-flex bb:items-center bb:justify-center bb:h-7 bb:w-7 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:hover:bg-accent bb:hover:text-accent-foreground bb:opacity-50 bb:hover:opacity-100"
                                            @onclick="PreviousMonth">
                                        <LucideIcon Name="chevron-left" Class="bb:h-4 bb:w-4" />
                                    </button>
                                    <span class="bb:text-sm bb:font-medium">@GetMonthName(_displayMonth1.Month) @_displayMonth1.Year</span>
                                    @if (!ShowTwoMonths)
                                    {
                                        <button type="button"
                                                class="bb:inline-flex bb:items-center bb:justify-center bb:h-7 bb:w-7 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:hover:bg-accent bb:hover:text-accent-foreground bb:opacity-50 bb:hover:opacity-100"
                                                @onclick="NextMonth">
                                            <LucideIcon Name="chevron-right" Class="bb:h-4 bb:w-4" />
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="bb:inline-flex bb:items-center bb:justify-center bb:h-7 bb:w-7 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:hover:bg-accent bb:hover:text-accent-foreground bb:opacity-50 bb:hover:opacity-100"
                                                data-drp-mobile-nav
                                                @onclick="NextMonth">
                                            <LucideIcon Name="chevron-right" Class="bb:h-4 bb:w-4" />
                                        </button>
                                        <div class="bb:hidden bb:w-7" data-drp-desktop-spacer></div>
                                    }
                                </div>
                                @RenderMonthGridInline(_displayMonth1)
                            </div>

                            @if (ShowTwoMonths)
                            {
                                @* Second Calendar *@
                                <div class="bb:hidden bb:flex-1 bb:border-l" data-drp-calendar-2>
                                    <div class="bb:flex bb:items-center bb:justify-between bb:mb-3">
                                        <div class="bb:w-7"></div>
                                        <span class="bb:text-sm bb:font-medium">@GetMonthName(_displayMonth2.Month) @_displayMonth2.Year</span>
                                        <button type="button"
                                                class="bb:inline-flex bb:items-center bb:justify-center bb:h-7 bb:w-7 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:hover:bg-accent bb:hover:text-accent-foreground bb:opacity-50 bb:hover:opacity-100"
                                                @onclick="NextMonth">
                                            <LucideIcon Name="chevron-right" Class="bb:h-4 bb:w-4" />
                                        </button>
                                    </div>
                                    @RenderMonthGridInline(_displayMonth2)
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* Calendars without presets *@
                <div class="@(ShowTwoMonths ? "bb:flex" : "")">
                    @* First Calendar *@
                    <div class="bb:flex-1 bb:px-5 bb:py-3" data-drp-calendar>
                        <div class="bb:flex bb:items-center bb:justify-between bb:mb-3">
                            <button type="button"
                                    class="bb:inline-flex bb:items-center bb:justify-center bb:h-7 bb:w-7 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:hover:bg-accent bb:hover:text-accent-foreground bb:opacity-50 bb:hover:opacity-100"
                                    @onclick="PreviousMonth">
                                <LucideIcon Name="chevron-left" Class="bb:h-4 bb:w-4" />
                            </button>
                            <span class="bb:text-sm bb:font-medium">@GetMonthName(_displayMonth1.Month) @_displayMonth1.Year</span>
                            @if (!ShowTwoMonths)
                            {
                                <button type="button"
                                        class="bb:inline-flex bb:items-center bb:justify-center bb:h-7 bb:w-7 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:hover:bg-accent bb:hover:text-accent-foreground bb:opacity-50 bb:hover:opacity-100"
                                        @onclick="NextMonth">
                                    <LucideIcon Name="chevron-right" Class="bb:h-4 bb:w-4" />
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="bb:inline-flex bb:items-center bb:justify-center bb:h-7 bb:w-7 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:hover:bg-accent bb:hover:text-accent-foreground bb:opacity-50 bb:hover:opacity-100"
                                        data-drp-mobile-nav
                                        @onclick="NextMonth">
                                    <LucideIcon Name="chevron-right" Class="bb:h-4 bb:w-4" />
                                </button>
                                <div class="bb:hidden bb:w-7" data-drp-desktop-spacer></div>
                            }
                        </div>
                        @RenderMonthGridInline(_displayMonth1)
                    </div>

                    @if (ShowTwoMonths)
                    {
                        @* Second Calendar *@
                        <div class="bb:hidden bb:flex-1 bb:border-l" data-drp-calendar-2>
                            <div class="bb:flex bb:items-center bb:justify-between bb:mb-3">
                                <div class="bb:w-7"></div>
                                <span class="bb:text-sm bb:font-medium">@GetMonthName(_displayMonth2.Month) @_displayMonth2.Year</span>
                                <button type="button"
                                        class="bb:inline-flex bb:items-center bb:justify-center bb:h-7 bb:w-7 bb:rounded-md bb:border bb:border-input bb:bg-transparent bb:hover:bg-accent bb:hover:text-accent-foreground bb:opacity-50 bb:hover:opacity-100"
                                        @onclick="NextMonth">
                                    <LucideIcon Name="chevron-right" Class="bb:h-4 bb:w-4" />
                                </button>
                            </div>
                            @RenderMonthGridInline(_displayMonth2)
                        </div>
                    }
                </div>
            }

            <div class="bb:flex bb:items-center bb:justify-between bb:p-3 bb:border-t">
                <div class="bb:text-sm bb:text-muted-foreground">
                    @if (_selectionStart.HasValue && !_selectionEnd.HasValue)
                    {
                        <span>@Localizer["DateRangePicker.SelectEndDate"]</span>
                    }
                    else if (_selectionStart.HasValue && _selectionEnd.HasValue)
                    {
                        var days = CountSelectedDays(_selectionStart.Value, _selectionEnd.Value);
                        <span>@Localizer["DateRangePicker.DaysSelected", days]</span>
                    }
                </div>
                @if (ShowButtons)
                {
                    <div class="bb:flex bb:gap-2">
                        <button type="button"
                                class="bb:inline-flex bb:items-center bb:justify-center bb:whitespace-nowrap bb:rounded-md bb:text-sm bb:font-medium bb:ring-offset-background bb:transition-colors bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring bb:focus-visible:ring-offset-2 bb:disabled:pointer-events-none bb:disabled:opacity-50 bb:border bb:border-input bb:bg-background bb:hover:bg-accent bb:hover:text-accent-foreground bb:h-8 bb:px-3"
                                disabled="@(Value == null && !_selectionStart.HasValue)"
                                @onclick="Clear">
                            @Localizer["DateRangePicker.Clear"]
                        </button>
                        <button type="button"
                                class="bb:inline-flex bb:items-center bb:justify-center bb:whitespace-nowrap bb:rounded-md bb:text-sm bb:font-medium bb:ring-offset-background bb:transition-colors bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring bb:focus-visible:ring-offset-2 bb:disabled:pointer-events-none bb:disabled:opacity-50 bb:bg-primary bb:text-primary-foreground bb:hover:bg-primary/90 bb:h-8 bb:px-3"
                                disabled="@(!CanApply)"
                                @onclick="Apply">
                            @Localizer["DateRangePicker.Apply"]
                        </button>
                    </div>
                }
            </div>
        </div>
    </BbPopoverContent>
</BbPopover>

@code {
    private RenderFragment RenderMonthGridInline(DateTime monthDate) => __builder =>
    {
        var weeks = monthDate == _displayMonth1 ? GetWeeksInMonth1() : GetWeeksInMonth2();
        <table class="bb:w-full bb:border-collapse">
            <thead>
                <tr class="bb:flex">
                    @foreach (var dayName in DayNames)
                    {
                        <th class="bb:text-muted-foreground bb:w-9 bb:flex-1 bb:font-normal bb:text-[0.8rem]" data-drp-cell>@dayName</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var week in weeks)
                {
                    <tr class="bb:flex bb:w-full bb:mt-2">
                        @foreach (var day in week)
                        {
                            @if (day.HasValue)
                            {
                                var dateValue = day.Value;
                                var isDisabled = IsDateDisabled(dateValue) || dateValue.Month != monthDate.Month;
                                var isInRange = !isDisabled && IsInRange(dateValue);
                                var isRangeStart = !isDisabled && IsRangeStart(dateValue);
                                var isRangeEnd = !isDisabled && IsRangeEnd(dateValue);
                                var isToday = dateValue.Date == DateTime.Today;

                                <td class="@GetCellClass(day, isInRange, isRangeStart, isRangeEnd)" data-drp-cell>
                                    <button type="button"
                                            class="@GetDayClass(dateValue, isDisabled, isInRange, isRangeStart, isRangeEnd, isToday)"
                                            data-drp-day-btn
                                            disabled="@isDisabled"
                                            @onclick="@(() => HandleDateClick(dateValue))">
                                        @if (DayTemplate != null)
                                        {
                                            @DayTemplate(new CalendarDayContext
                                            {
                                                Date = dateValue,
                                                IsSelected = isRangeStart || isRangeEnd,
                                                IsDisabled = isDisabled,
                                                IsOutsideMonth = false,
                                                IsToday = isToday,
                                                IsInRange = isInRange
                                            })
                                        }
                                        else
                                        {
                                            @dateValue.Day
                                        }
                                    </button>
                                </td>
                            }
                            else
                            {
                                <td class="bb:h-9 bb:w-9 bb:flex-1 bb:text-center bb:text-sm bb:p-0" data-drp-cell></td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    };

    private async Task HandleDateClick(DateTime date)
    {
        await SelectDate(date);
    }
}
