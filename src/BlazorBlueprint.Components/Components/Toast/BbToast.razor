@namespace BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components

@*
    Individual Toast component - displays a single toast notification.
*@

<div class="@CssClass" role="alert"
     data-state="open"
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave"
     @attributes="AdditionalAttributes">

    @if (ShouldShowIcon)
    {
        <div class="bb:shrink-0">
            <LucideIcon Name="@IconName" Class="@IconCssClass" />
        </div>
    }

    <div class="@ContentCssClass">
        @if (!string.IsNullOrEmpty(Data.Title))
        {
            <div class="@TitleCssClass">@Data.Title</div>
        }
        @if (!string.IsNullOrEmpty(Data.Description))
        {
            <div class="@DescriptionCssClass">@Data.Description</div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Data.ActionText) && Data.OnAction != null)
    {
        <button type="button"
                class="@ActionCssClass"
                @onclick="HandleAction">
            @Data.ActionText
        </button>
    }

    @if (Data.ShowClose)
    {
        <button type="button"
                class="@CloseCssClass"
                @onclick="HandleClose">
            <LucideIcon Name="x" Class="bb:h-4 bb:w-4" />
            <span class="bb:sr-only">Close</span>
        </button>
    }

    @if (ShouldShowCountdown)
    {
        <div class="bb:absolute bb:bottom-0 bb:left-0 bb:right-0 bb:h-0.5 bb:bg-current/20">
            <div class="bb:h-full bb:bg-current/40"
                 style="animation: bb-alert-countdown @(Data.Duration)ms linear forwards; animation-play-state: @(isPaused ? "paused" : "running");"></div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// The toast data to display.
    /// </summary>
    [Parameter, EditorRequired]
    public ToastData Data { get; set; } = default!;

    /// <summary>
    /// Callback when the toast should be dismissed.
    /// </summary>
    [Parameter]
    public EventCallback OnDismiss { get; set; }

    /// <summary>
    /// Callback when auto-dismiss should pause (mouse enter).
    /// </summary>
    [Parameter]
    public EventCallback OnPause { get; set; }

    /// <summary>
    /// Callback when auto-dismiss should resume (mouse leave).
    /// </summary>
    [Parameter]
    public EventCallback OnResume { get; set; }

    /// <summary>
    /// Whether to show a visual countdown progress bar at the bottom of the toast.
    /// </summary>
    [Parameter]
    public bool ShowCountdown { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the toast.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool isPaused;

    private async Task HandleClose()
    {
        await OnDismiss.InvokeAsync();
    }

    private async Task HandleAction()
    {
        Data.OnAction?.Invoke();
        await OnDismiss.InvokeAsync();
    }

    private async Task HandleMouseEnter()
    {
        isPaused = true;
        if (OnPause.HasDelegate)
        {
            await OnPause.InvokeAsync();
        }
    }

    private async Task HandleMouseLeave()
    {
        isPaused = false;
        if (OnResume.HasDelegate)
        {
            await OnResume.InvokeAsync();
        }
    }

    private bool ShouldShowIcon => Data.ShowIcon && Data.Variant != ToastVariant.Default;

    private string IconName => Data.Variant switch
    {
        ToastVariant.Success => "circle-check",
        ToastVariant.Info => "info",
        ToastVariant.Warning => "triangle-alert",
        ToastVariant.Destructive => "circle-x",
        _ => ""
    };

    private bool IsCompact => Data.Size == ToastSize.Compact;

    /// <summary>
    /// Gets the computed CSS classes for the toast.
    /// </summary>
    private bool ShouldShowCountdown => ShowCountdown && Data.Duration > 0;

    private string CssClass => ClassNames.cn(
        "bb:group bb:pointer-events-auto bb:relative bb:flex bb:w-full bb:items-center bb:justify-between bb:space-x-4 bb:overflow-hidden bb:rounded-md bb:border bb:shadow-lg bb:transition-all",
        "bb:data-[state=open]:animate-in bb:data-[state=closed]:animate-out bb:data-[state=closed]:fade-out-80",
        "bb:data-[state=closed]:slide-out-to-right-full bb:data-[state=open]:slide-in-from-top-full",
        "bb:data-[state=open]:sm:slide-in-from-bottom-full",
        IsCompact
            ? Data.ShowClose ? "bb:p-3 bb:pr-6" : "bb:p-3"
            : Data.ShowClose ? "bb:p-6 bb:pr-8" : "bb:p-6",
        Data.Variant switch
        {
            ToastVariant.Default => "bb:border bb:bg-background bb:text-foreground",
            ToastVariant.Success => "bb:border-alert-success/30 bb:bg-alert-success-bg bb:text-alert-success-foreground",
            ToastVariant.Info => "bb:border-alert-info/30 bb:bg-alert-info-bg bb:text-alert-info-foreground",
            ToastVariant.Warning => "bb:border-alert-warning/30 bb:bg-alert-warning-bg bb:text-alert-warning-foreground",
            ToastVariant.Destructive => "destructive bb:group bb:border-destructive bb:bg-destructive bb:text-destructive-foreground",
            _ => "bb:border bb:bg-background bb:text-foreground"
        },
        Class
    );

    private string IconCssClass => ClassNames.cn(
        IsCompact ? "bb:h-4 bb:w-4" : "bb:h-5 bb:w-5",
        Data.Variant switch
        {
            ToastVariant.Success => "bb:text-alert-success",
            ToastVariant.Info => "bb:text-alert-info",
            ToastVariant.Warning => "bb:text-alert-warning",
            ToastVariant.Destructive => "bb:text-destructive-foreground",
            _ => ""
        }
    );

    private string ContentCssClass => ClassNames.cn(
        "bb:grid bb:flex-1",
        IsCompact ? "bb:gap-0.5" : "bb:gap-1"
    );

    private string TitleCssClass => IsCompact ? "bb:text-xs bb:font-semibold" : "bb:text-sm bb:font-semibold";

    private string DescriptionCssClass => ClassNames.cn(
        IsCompact ? "bb:text-xs" : "bb:text-sm",
        "bb:opacity-90"
    );

    private string ActionCssClass => ClassNames.cn(
        "bb:inline-flex bb:shrink-0 bb:items-center bb:justify-center bb:rounded-md bb:border bb:bg-transparent bb:font-medium bb:ring-offset-background bb:transition-colors bb:hover:bg-secondary bb:focus:outline-none bb:focus:ring-2 bb:focus:ring-ring bb:focus:ring-offset-2 bb:disabled:pointer-events-none bb:disabled:opacity-50",
        IsCompact ? "bb:h-7 bb:px-2 bb:text-xs" : "bb:h-8 bb:px-3 bb:text-sm"
    );

    /// <summary>
    /// Gets the computed CSS classes for the close button.
    /// </summary>
    private string CloseCssClass => ClassNames.cn(
        "bb:absolute bb:rounded-md bb:p-1 bb:opacity-0 bb:transition-opacity",
        "bb:hover:text-foreground bb:focus:opacity-100 bb:focus:outline-none bb:focus:ring-2 bb:group-hover:opacity-100",
        IsCompact ? "bb:right-1 bb:top-1" : "bb:right-2 bb:top-2",
        Data.Variant == ToastVariant.Destructive
            ? "bb:text-red-300 bb:hover:text-red-50 bb:focus:ring-red-400 bb:focus:ring-offset-red-600"
            : "bb:text-foreground/50 bb:hover:text-foreground bb:focus:ring-ring"
    );
}
