@namespace BlazorBlueprint.Components

<BlazorBlueprint.Primitives.Menubar.BbMenubarCheckboxItem
    Checked="@Checked"
    CheckedChanged="@CheckedChanged"
    Disabled="@Disabled"
    class="@CssClass"
    @attributes="AdditionalAttributes">
    <span class="bb:absolute bb:left-2 bb:flex bb:h-3.5 bb:w-3.5 bb:items-center bb:justify-center">
        @if (Checked)
        {
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="16"
                 height="16"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="bb:h-4 bb:w-4">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        }
    </span>
    @ChildContent
</BlazorBlueprint.Primitives.Menubar.BbMenubarCheckboxItem>

@code {
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Checked { get; set; }

    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    private string CssClass => ClassNames.cn(
        "bb:relative bb:flex bb:cursor-default bb:select-none bb:items-center bb:rounded-sm bb:py-1.5 bb:pl-8 bb:pr-2 bb:text-sm bb:outline-none",
        "bb:focus:bg-accent bb:focus:text-accent-foreground",
        "bb:hover:bg-accent bb:hover:text-accent-foreground",
        Disabled ? "bb:pointer-events-none bb:opacity-50" : null,
        Class
    );
}
