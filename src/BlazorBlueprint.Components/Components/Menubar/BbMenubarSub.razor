@namespace BlazorBlueprint.Components

<BlazorBlueprint.Primitives.Menu.BbMenuSub Disabled="@Disabled">
    @ChildContent
</BlazorBlueprint.Primitives.Menu.BbMenuSub>

@code {
    /// <summary>The submenu trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Disables opening the submenu.</summary>
    [Parameter] public bool Disabled { get; set; }
}
