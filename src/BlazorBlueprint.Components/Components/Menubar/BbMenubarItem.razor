@namespace BlazorBlueprint.Components
@using BlazorBlueprint.Primitives.Services
@inject IKeyboardShortcutService KeyboardShortcuts
@implements IDisposable
@implements IAsyncDisposable

<BlazorBlueprint.Primitives.Menubar.BbMenubarItem
    Disabled="@Disabled"
    OnClick="@HandleClick"
    class="@CssClass"
    @attributes="AdditionalAttributes">
    @ChildContent
</BlazorBlueprint.Primitives.Menubar.BbMenubarItem>

@code {
    [CascadingParameter]
    public BbMenubarMenu? Menu { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Inset { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>
    /// Keyboard shortcut to auto-register (e.g., "Ctrl+N", "Ctrl+Shift+T").
    /// When set, automatically registers the shortcut via IKeyboardShortcutService
    /// and invokes OnClick when pressed.
    /// </summary>
    [Parameter]
    public string? Shortcut { get; set; }

    private IDisposable? shortcutRegistration;
    private string? registeredShortcut;
    private bool registeringShortcut;
    private bool disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed || registeringShortcut)
        {
            return;
        }

        registeringShortcut = true;
        try
        {
            // Parameter updates can arrive while registration is awaiting JS interop.
            while (!disposed && registeredShortcut != Shortcut)
            {
                var shortcut = Shortcut;
                shortcutRegistration?.Dispose();
                shortcutRegistration = null;

                if (!string.IsNullOrEmpty(shortcut))
                {
                    var registration = await KeyboardShortcuts.RegisterAsync(shortcut, async () =>
                    {
                        if (!disposed && !Disabled)
                        {
                            await OnClick.InvokeAsync();
                        }
                    });

                    if (disposed)
                    {
                        registration.Dispose();
                    }
                    else
                    {
                        shortcutRegistration = registration;
                    }
                }

                registeredShortcut = shortcut;
            }
        }
        finally
        {
            registeringShortcut = false;
        }
    }

    private async Task HandleClick() =>
        await OnClick.InvokeAsync();

    public void Dispose()
    {
        disposed = true;
        shortcutRegistration?.Dispose();
        shortcutRegistration = null;
    }

    public ValueTask DisposeAsync()
    {
        Dispose();
        return ValueTask.CompletedTask;
    }

    private string CssClass => ClassNames.cn(
        "bb:relative bb:flex bb:cursor-default bb:select-none bb:items-center bb:rounded-sm bb:px-2 bb:py-1.5 bb:text-sm bb:outline-none",
        "bb:focus:bg-(--bb-menu-accent) bb:focus:text-(--bb-menu-accent-foreground)",
        "bb:hover:bg-(--bb-menu-accent) bb:hover:text-(--bb-menu-accent-foreground)",
        Disabled ? "bb:pointer-events-none bb:opacity-50" : null,
        Inset ? "bb:ps-8" : null,
        Class
    );
}
