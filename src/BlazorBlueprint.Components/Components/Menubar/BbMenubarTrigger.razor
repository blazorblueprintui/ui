@namespace BlazorBlueprint.Components

<BlazorBlueprint.Primitives.Menubar.BbMenubarTrigger class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</BlazorBlueprint.Primitives.Menubar.BbMenubarTrigger>

@code {
    [CascadingParameter]
    public BbMenubar? Context { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string CssClass => ClassNames.cn(
        "bb:relative bb:z-50 bb:flex bb:cursor-default bb:select-none bb:items-center bb:rounded-sm bb:px-3 bb:py-1.5 bb:text-sm bb:font-medium bb:outline-none",
        "bb:focus:bg-accent bb:focus:text-accent-foreground",
        "bb:data-[state=open]:bg-accent bb:data-[state=open]:text-accent-foreground",
        Context?.TriggerClass,
        Class
    );
}
