@namespace BlazorBlueprint.Components

<BlazorBlueprint.Primitives.Menubar.BbMenubarContent Loop="@Loop" class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</BlazorBlueprint.Primitives.Menubar.BbMenubarContent>

@code {
    [CascadingParameter]
    public BbMenubarMenu? Menu { get; set; }

    [CascadingParameter]
    public BbMenubar? Context { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public MenubarContentAlign Align { get; set; } = MenubarContentAlign.Start;

    [Parameter]
    public bool Loop { get; set; } = true;

    private string AlignClass => Align switch
    {
        MenubarContentAlign.Start => "bb:left-0",
        MenubarContentAlign.Center => "bb:left-1/2 bb:-translate-x-1/2",
        MenubarContentAlign.End => "bb:right-0",
        _ => "bb:left-0"
    };

    private string CssClass => ClassNames.cn(
        "bb:absolute bb:top-full bb:mt-1 bb:z-50 bb:min-w-[12rem] bb:overflow-hidden bb:rounded-md bb:border bb:bg-popover bb:p-1 bb:text-popover-foreground bb:shadow-md bb:outline-none",
        "bb:data-[state=open]:animate-in bb:data-[state=closed]:animate-out",
        "bb:data-[state=closed]:fade-out-0 bb:data-[state=open]:fade-in-0",
        "bb:data-[state=closed]:zoom-out-95 bb:data-[state=open]:zoom-in-95",
        AlignClass,
        Class
    );
}
