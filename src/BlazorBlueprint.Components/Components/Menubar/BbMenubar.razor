@namespace BlazorBlueprint.Components

<BlazorBlueprint.Primitives.Menubar.BbMenubar @ref="primitiveRef" class="@CssClass" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</BlazorBlueprint.Primitives.Menubar.BbMenubar>

@code {
    private BlazorBlueprint.Primitives.Menubar.BbMenubar? primitiveRef;

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to all <see cref="BbMenubarTrigger"/> components within this menubar.
    /// </summary>
    [Parameter]
    public string? TriggerClass { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    internal BlazorBlueprint.Primitives.Menubar.MenubarContext? PrimitiveContext =>
        primitiveRef?.Context;

    private string CssClass => ClassNames.cn(
        "bb:relative bb:z-50 bb:flex bb:h-10 bb:items-center bb:space-x-1 bb:rounded-md bb:border bb:bg-background bb:p-1",
        Class
    );
}
