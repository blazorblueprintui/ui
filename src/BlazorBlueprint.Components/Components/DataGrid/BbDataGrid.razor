@namespace BlazorBlueprint.Components
@typeparam TData where TData : class
@attribute [CascadingTypeParameter(nameof(TData))]
@using BlazorBlueprint.Icons.Lucide.Components
@using BlazorBlueprint.Primitives.DataGrid
@using Microsoft.AspNetCore.Components.Forms
@inject IBbLocalizer Localizer

<CascadingValue Value="this" IsFixed="true">
    <div class="@ClassNames.cn("bb:w-full", Class)" @attributes="AdditionalAttributes">
        @if (ShowSearch || ShowExport || Toolbar != null)
        {
            <div class="bb:flex bb:items-center bb:justify-between bb:gap-2 bb:py-4">
                @if (ShowSearch)
                {
                    <BbInput Value="@(_searchInputValue ?? SearchText)"
                             ValueChanged="@HandleSearchInput"
                             Placeholder="@(SearchPlaceholder ?? Localizer["DataGrid.SearchPlaceholder"])"
                             Class="bb:max-w-sm" />
                }
                @if (ShowExport)
                {
                    @if (!ShowSearch)
                    {
                        @* Keeps the export button on the right when there is no search input on
                           the left for justify-between to push against. *@
                        <div></div>
                    }
                    <div class="bb:flex bb:items-center bb:gap-2">
                        @Toolbar
                        <BbButton Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Small"
                                  OnClick="@(async () => await ExportToCsvAsync())"
                                  AriaLabel="@Localizer["DataGrid.ExportAriaLabel"]">
                            <LucideIcon Name="download" Class="bb:w-4 bb:h-4 bb:mr-2" />
                            @Localizer["DataGrid.Export"]
                        </BbButton>
                    </div>
                }
                else
                {
                    @* Left exactly as it was, so a grid that only supplies a Toolbar keeps its
                       existing layout. *@
                    @Toolbar
                }
            </div>
        }
        @if (EditMode == DataGridEditMode.Batch)
        {
            <div class="bb:flex bb:items-center bb:gap-2 bb:py-2" role="group" aria-label="@Localizer["DataGrid.BatchEditing"]">
                <BbButton Size="ButtonSize.Small" Disabled="@(savingEdits || PendingChanges.Count == 0)"
                          OnClick="@(async () => await CommitBatchAsync())">@Localizer["DataGrid.SaveChanges"]</BbButton>
                <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" Disabled="@(savingEdits || PendingChanges.Count == 0)"
                          OnClick="CancelBatchAsync">@Localizer["DataGrid.DiscardChanges"]</BbButton>
                <span role="status">@Localizer["DataGrid.PendingRows", PendingChanges.Count]</span>
            </div>
        }
        @if (editError != null)
        {
            <p role="alert" class="bb:text-destructive bb:text-sm bb:py-2">@editError</p>
        }
        @if (ShowGroupingBreadcrumb && _gridState.Grouping.HasGroups)
        {
            @* Past two levels a per-column menu stops being a usable way to see or change the
               grouping, so the active levels are shown in order with their own controls. *@
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-1 bb:pb-3 bb:text-sm" role="group"
                 aria-label="@Localizer["DataGrid.GroupingBreadcrumbLabel"]">
                <span class="bb:text-muted-foreground bb:mr-1">@Localizer["DataGrid.GroupingBreadcrumbLabel"]</span>
                @for (var levelIndex = 0; levelIndex < _gridState.Grouping.ActiveGroups.Count; levelIndex++)
                {
                    var level = _gridState.Grouping.ActiveGroups[levelIndex];
                    var levelTitle = GetGroupLevelTitle(level.ColumnId);
                    var index = levelIndex;

                    <span class="bb:inline-flex bb:items-center bb:gap-1 bb:rounded-md bb:border bb:bg-muted/50 bb:px-2 bb:py-1">
                        @if (index > 0)
                        {
                            <button type="button"
                                    class="bb:inline-flex bb:items-center bb:justify-center bb:rounded bb:w-5 bb:h-5 bb:hover:bg-muted bb:transition-colors"
                                    aria-label="@Localizer["DataGrid.MoveGroupLevelOut", levelTitle]"
                                    @onclick="@(() => MoveGroupByColumnAsync(level.ColumnId, index - 1))">
                                <LucideIcon Name="chevron-left" Class="bb:w-3.5 bb:h-3.5" />
                            </button>
                        }
                        <span>@levelTitle</span>
                        <button type="button"
                                class="bb:inline-flex bb:items-center bb:justify-center bb:rounded bb:w-5 bb:h-5 bb:hover:bg-muted bb:transition-colors"
                                aria-label="@Localizer["DataGrid.RemoveGroupLevel", levelTitle]"
                                @onclick="@(() => RemoveGroupByColumnAsync(level.ColumnId))">
                            <LucideIcon Name="x" Class="bb:w-3.5 bb:h-3.5" />
                        </button>
                    </span>
                    @if (index < _gridState.Grouping.ActiveGroups.Count - 1)
                    {
                        <span class="bb:text-muted-foreground" aria-hidden="true">&#8250;</span>
                    }
                }
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                          Class="bb:ml-1 bb:h-7"
                          OnClick="ClearGroupingAsync">
                    @Localizer["DataGrid.ClearGrouping"]
                </BbButton>
            </div>
        }
        <div @ref="containerRef"
             class="@ClassNames.cn("bb:relative bb:w-full", Virtualize ? "" : "bb:overflow-auto", TableContainerClass)"
             style="@(IsVirtualizedProvider ? $"height: {VirtualScrollHeight}; overflow-y: auto;" : null)">
            @if (IsLoading)
            {
                @if (LoadingTemplate != null)
                {
                    @LoadingTemplate
                }
                else
                {
                    <div class="bb:flex bb:items-center bb:justify-center bb:p-8 bb:text-muted-foreground">
                        <div class="bb:text-sm">@Localizer["DataGrid.Loading"]</div>
                    </div>
                }
            }
            else if (!IsVirtualizedProvider && (_groupedRenderItems == null || !_groupedRenderItems.Any()) && !_processedData.Any() && !_gridState.Filtering.HasFilters)
            {
                @if (EmptyTemplate != null)
                {
                    @EmptyTemplate
                }
                else
                {
                    <BbEmpty Title="@Localizer["DataGrid.NoResultsFound"]" Size="EmptySize.Small" />
                }
            }
            else
            {
                RefreshVisibleColumnsCache();
                <BlazorBlueprint.Primitives.DataGrid.BbDataGrid TData="TData"
                    Items="@_processedData"
                    @bind-State="@_gridState"
                    SelectionMode="@GetPrimitiveSelectionMode()"
                    SelectionBehavior="@SelectionBehavior"
                    IsRowEditing="@(EditMode != DataGridEditMode.None ? _isRowEditing : null)"
                    OnCommitEdit="@(EditMode != DataGridEditMode.None ? _commitEditFromRow : null)"
                    OnCancelEdit="@(EditMode != DataGridEditMode.None ? _cancelEditFromRow : null)"
                    ManualPagination="true"
                    EnableKeyboardNavigation="@EnableKeyboardNavigation"
                    OnSortChange="HandleSortChange"
                    OnSelectionChange="HandleSelectionChange"
                    OnRowClick="HandleRowClick"
                    OnToggleExpand="@(DetailTemplate != null || HasDetailRows ? EventCallback.Factory.Create<TData>(this, HandleRowExpandToggle) : default)"
                    OnRowContextMenu="@(RowContextMenu != null ? (EventCallback<(TData, double, double)>)EventCallback.Factory.Create<(TData, double, double)>(this, HandleRowContextMenu) : default)"
                    Class="@ClassNames.cn("bb:w-full bb:caption-bottom bb:text-sm", HasTableFixed() ? "bb:table-fixed" : "")"
                    AriaLabel="@AriaLabel">
                    @if (HasTableFixed())
                    {
                        <colgroup>
                            @foreach (var col in _cachedVisibleColumns)
                            {
                                <col style="@GetColumnWidthStyle(col)" />
                            }
                        </colgroup>
                    }
                    <BlazorBlueprint.Primitives.DataGrid.BbDataGridHeader Class="@ClassNames.cn("bb:bg-background", StickyHeader ? "bb:sticky bb:top-0 bb:z-20" : "")">
                        <BlazorBlueprint.Primitives.DataGrid.BbDataGridRow TData="TData" Class="bb:group/row bb:bg-background">
                            @foreach (var column in _cachedVisibleColumns)
                            {
                                var sortDirection = _gridState.Sorting.GetDirection(column.ColumnId);
                                var sortPriority = _gridState.Sorting.GetPriority(column.ColumnId);
                                var isSelectColumn = column.ColumnId == "__select";
                                var isExpandColumn = column.ColumnId == "__expand";
                                var isHierarchyColumn = _hierarchyColumn != null && column.ColumnId == _hierarchyColumn.ColumnId;
                                var isLastLeft = column.ColumnId == _cachedLastLeftId;
                                var isFirstRight = column.ColumnId == _cachedFirstRightId;

                                <BlazorBlueprint.Primitives.DataGrid.BbDataGridHeaderCell TData="TData"
                                    @key="@column.ColumnId"
                                    ColumnId="@column.ColumnId"
                                    Sortable="@column.Sortable"
                                    Reorderable="@(Reorderable && column.Reorderable)"
                                    AriaLabel="@GetHeaderAriaLabel(column)"
                                    Class="@GetHeaderCellClass(column, isSelectColumn, isExpandColumn, isLastLeft, isFirstRight)"
                                    style="@GetColumnStyle(column, _cachedVisibleColumns)"
                                    data-pinned="@(column.Pinned != ColumnPinning.None ? "true" : null)">
                                    @if (isExpandColumn)
                                    {
                                        @* Empty spacer — no header control for expand column *@
                                    }
                                    else if (isSelectColumn)
                                    {
                                        <div @onclick:stopPropagation="true">
                                            @if (ShouldShowSelectAllPrompt())
                                            {
                                                <BbDropdownMenu @bind-Open="_selectAllDropdownOpen">
                                                    <BbDropdownMenuTrigger AsChild="false" Class="bb:inline-flex bb:items-center bb:justify-center bb:p-0 bb:bg-transparent bb:border-0 bb:hover:bg-transparent bb:focus:outline-none">
                                                        <BbCheckbox Checked="@IsAllSelected()"
                                                                  Indeterminate="@IsSomeSelected()"
                                                                  AriaLabel="@Localizer["DataGrid.SelectRowsAriaLabel"]"
                                                                  Class="bb:pointer-events-none" />
                                                    </BbDropdownMenuTrigger>
                                                    <BbDropdownMenuContent Side="PopoverSide.Bottom" Align="PopoverAlign.Start">
                                                        <BbDropdownMenuItem OnClick="@HandleSelectOnlyCurrentPage">
                                                            @Localizer["DataGrid.SelectAllOnPage", _processedData.Count()]
                                                        </BbDropdownMenuItem>
                                                        <BbDropdownMenuItem OnClick="@HandleSelectAllItems">
                                                            @Localizer["DataGrid.SelectAllItems", _gridState.Pagination.TotalItems]
                                                        </BbDropdownMenuItem>
                                                        @if (_gridState.Selection.HasSelection)
                                                        {
                                                            <BbDropdownMenuSeparator />
                                                            <BbDropdownMenuItem OnClick="@HandleClearSelection">
                                                                @Localizer["DataGrid.ClearSelection"]
                                                            </BbDropdownMenuItem>
                                                        }
                                                    </BbDropdownMenuContent>
                                                </BbDropdownMenu>
                                            }
                                            else
                                            {
                                                <BbCheckbox Checked="@IsAllSelected()"
                                                          CheckedChanged="@HandleSelectAllChanged"
                                                          Indeterminate="@IsSomeSelected()"
                                                          AriaLabel="@Localizer["DataGrid.SelectAllRows"]" />
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        @if (Reorderable && column.Reorderable)
                                        {
                                            <LucideIcon Name="grip-vertical" Class="bb:absolute bb:left-1 bb:top-1/2 bb:-translate-y-1/2 bb:w-3 bb:h-3 bb:text-muted-foreground/40 bb:opacity-0 bb:group-hover/header:opacity-100 bb:transition-opacity bb:pointer-events-none" />
                                        }
                                        <div class="bb:flex bb:items-center bb:gap-2">
                                            @if (ShowExpandAll && isHierarchyColumn)
                                            {
                                                <button type="button"
                                                        class="bb:inline-flex bb:items-center bb:justify-center bb:rounded-md bb:w-6 bb:h-6 bb:hover:bg-muted bb:transition-colors bb:shrink-0"
                                                        aria-label="@(IsAllExpanded ? Localizer["DataGrid.CollapseAll"] : Localizer["DataGrid.ExpandAll"])"
                                                        @onclick="@ToggleExpandAllAsync"
                                                        @onclick:stopPropagation="true">
                                                    <LucideIcon Name="@(IsAllExpanded ? "chevrons-down-up" : "chevrons-up-down")"
                                                               Class="bb:w-4 bb:h-4 bb:text-muted-foreground" />
                                                </button>
                                            }
                                            @if (column.HeaderTemplate != null)
                                            {
                                                @column.HeaderTemplate(new BlazorBlueprint.Primitives.DataGrid.DataGridHeaderContext<TData>
                                                {
                                                    Column = column,
                                                    State = _gridState
                                                })
                                            }
                                            else
                                            {
                                                <span>@column.Title</span>
                                            }
                                            @if (column.Pinned != ColumnPinning.None)
                                            {
                                                <BbTooltip>
                                                    <BbTooltipTrigger AsChild="false" Focusable="false" Class="bb:inline-flex bb:items-center">
                                                        <LucideIcon Name="pin" Class="bb:w-3.5 bb:h-3.5 bb:text-muted-foreground" />
                                                    </BbTooltipTrigger>
                                                    <BbTooltipContent Side="PopoverSide.Bottom">
                                                        @Localizer["DataGrid.PinnedColumnTooltip"]
                                                    </BbTooltipContent>
                                                </BbTooltip>
                                            }
                                            @if (column.Sortable && sortDirection != SortDirection.None)
                                            {
                                                @if (sortDirection == SortDirection.Ascending)
                                                {
                                                    <LucideIcon Name="arrow-up" Class="bb:w-4 bb:h-4" />
                                                }
                                                else
                                                {
                                                    <LucideIcon Name="arrow-down" Class="bb:w-4 bb:h-4" />
                                                }
                                                @if (_gridState.Sorting.Definitions.Count > 1)
                                                {
                                                    <span class="bb:text-xs bb:text-muted-foreground bb:tabular-nums">@sortPriority</span>
                                                }
                                            }
                                            else if (column.Sortable)
                                            {
                                                <LucideIcon Name="arrow-up-down" Class="bb:w-4 bb:h-4 bb:opacity-0 bb:group-hover/header:opacity-50 bb:transition-opacity" />
                                            }
                                            @if (column.Filterable)
                                            {
                                                var hasActiveFilter = _gridState.Filtering.HasFilter(column.ColumnId);
                                                var filterColumn = column;
                                                <div @onclick:stopPropagation="true" class="bb:inline-flex">
                                                    <BbPopover Open="@(GetFilterPopoverOpen(filterColumn.ColumnId))"
                                                               OpenChanged="@(open => SetFilterPopoverOpen(filterColumn.ColumnId, open))">
                                                        <BbPopoverTrigger AsChild="true">
                                                            <BbButton Variant="ButtonVariant.Ghost"
                                                                      Size="ButtonSize.Icon"
                                                                      Class="@ClassNames.cn("bb:w-7 bb:h-7 bb:transition-colors",
                                                                          hasActiveFilter ? "bb:text-primary" : "bb:text-muted-foreground bb:opacity-0 bb:group-hover/header:opacity-100")"
                                                                      AriaLabel="@($"Filter {filterColumn.Title}")">
                                                                <LucideIcon Name="filter" Class="bb:w-3.5 bb:h-3.5" />
                                                            </BbButton>
                                                        </BbPopoverTrigger>
                                                        <BbPopoverContent Side="PopoverSide.Bottom" Align="PopoverAlign.Start" Class="bb:w-72 bb:p-0">
                                                            @{
                                                                var filterField = GetFilterFieldForColumn(filterColumn);
                                                                if (filterField != null)
                                                                {
                                                                    var filterableCol = filterColumn as IFilterableColumn;
                                                                    <BbDataGridColumnFilter
                                                                        ColumnTitle="@filterColumn.Title"
                                                                        FieldType="@filterField.Type"
                                                                        FieldName="@filterField.Name"
                                                                        FilterOptions="@filterableCol?.GetFilterOptions()"
                                                                        CurrentFilter="@_gridState.Filtering.GetFilter(filterColumn.ColumnId)"
                                                                        OnApply="@(condition => HandleColumnFilterChanged(filterColumn.ColumnId, condition))"
                                                                        OnClear="@(() => HandleColumnFilterChanged(filterColumn.ColumnId, null))" />
                                                                }
                                                            }
                                                        </BbPopoverContent>
                                                    </BbPopover>
                                                </div>
                                            }
                                            @if (CanGroupColumn(column))
                                            {
                                                var menuColumn = column;
                                                var isGroupedByColumn = IsGroupedBy(menuColumn.ColumnId);
                                                <div @onclick:stopPropagation="true" class="bb:inline-flex">
                                                    <BbDropdownMenu Open="@(GetHeaderMenuOpen(menuColumn.ColumnId))"
                                                                    OpenChanged="@(open => SetHeaderMenuOpen(menuColumn.ColumnId, open))">
                                                        <BbDropdownMenuTrigger AsChild="true">
                                                            <BbButton Variant="ButtonVariant.Ghost"
                                                                      Size="ButtonSize.Icon"
                                                                      Class="@ClassNames.cn("bb:w-7 bb:h-7 bb:transition-colors",
                                                                          isGroupedByColumn ? "bb:text-primary" : "bb:text-muted-foreground bb:opacity-0 bb:group-hover/header:opacity-100")"
                                                                      AriaLabel="@Localizer["DataGrid.ColumnMenu", menuColumn.Title ?? string.Empty]">
                                                                <LucideIcon Name="ellipsis" Class="bb:w-3.5 bb:h-3.5" />
                                                            </BbButton>
                                                        </BbDropdownMenuTrigger>
                                                        <BbDropdownMenuContent Side="PopoverSide.Bottom" Align="PopoverAlign.End">
                                                            @if (isGroupedByColumn)
                                                            {
                                                                <BbDropdownMenuItem OnClick="@(() => HandleUngroupColumnAsync(menuColumn.ColumnId))">
                                                                    <LucideIcon Name="ungroup" Class="bb:w-4 bb:h-4 bb:mr-2" />
                                                                    @Localizer["DataGrid.UngroupColumn"]
                                                                </BbDropdownMenuItem>
                                                            }
                                                            else
                                                            {
                                                                <BbDropdownMenuItem OnClick="@(() => HandleGroupByColumnAsync(menuColumn.ColumnId))">
                                                                    <LucideIcon Name="group" Class="bb:w-4 bb:h-4 bb:mr-2" />
                                                                    @Localizer["DataGrid.GroupByColumn", menuColumn.Title ?? string.Empty]
                                                                </BbDropdownMenuItem>
                                                                @if (_gridState.Grouping.HasGroups)
                                                                {
                                                                    @* Only offered once something is already grouped, so a first-time
                                                                       user is not asked to choose between two actions that do the same
                                                                       thing. *@
                                                                    <BbDropdownMenuItem OnClick="@(() => HandleAddGroupColumnAsync(menuColumn.ColumnId))">
                                                                        <LucideIcon Name="list-tree" Class="bb:w-4 bb:h-4 bb:mr-2" />
                                                                        @Localizer["DataGrid.AddGroupByColumn", menuColumn.Title ?? string.Empty]
                                                                    </BbDropdownMenuItem>
                                                                }
                                                            }
                                                        </BbDropdownMenuContent>
                                                    </BbDropdownMenu>
                                                </div>
                                            }
                                        </div>
                                        @if (Resizable && column.Resizable)
                                        {
                                            <div class="bb:absolute bb:right-0 bb:top-0 bb:bottom-0 bb:w-2 bb:cursor-col-resize bb:hover:bg-primary/20 bb:active:bg-primary/40"
                                                 data-resize-handle="@column.ColumnId"></div>
                                        }
                                    }
                                </BlazorBlueprint.Primitives.DataGrid.BbDataGridHeaderCell>
                            }
                        </BlazorBlueprint.Primitives.DataGrid.BbDataGridRow>
                    </BlazorBlueprint.Primitives.DataGrid.BbDataGridHeader>
                    <BlazorBlueprint.Primitives.DataGrid.BbDataGridBody Class="bb:bg-background">
                        @if (ShowFilterBar && _gridState.Filtering.HasFilters)
                        {
                            <tr class="@ClassNames.cn("bb:border-b bb:bg-muted/30", FilterBarClass)">
                                <td colspan="@_cachedVisibleColumns.Count" class="bb:px-4 bb:py-1.5">
                                    <div class="bb:flex bb:items-center bb:gap-2 bb:text-xs bb:text-muted-foreground">
                                        <LucideIcon Name="filter" Class="bb:w-3.5 bb:h-3.5" />
                                        <span>@Localizer["DataGrid.ActiveFilters", _gridState.Filtering.ActiveFilterCount]</span>
                                        <button type="button"
                                                class="bb:inline-flex bb:items-center bb:gap-1 bb:rounded bb:px-1.5 bb:py-0.5 bb:text-xs bb:font-medium bb:hover:bg-muted bb:transition-colors"
                                                @onclick="ClearAllFiltersAsync"
                                                @onclick:stopPropagation="true">
                                            <LucideIcon Name="x" Class="bb:w-3 bb:h-3" />
                                            @Localizer["DataGrid.ClearAll"]
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!_processedData.Any() && _gridState.Filtering.HasFilters)
                        {
                            <tr>
                                <td colspan="@_cachedVisibleColumns.Count" class="bb:py-8 bb:text-center">
                                    <BbEmpty Title="@Localizer["DataGrid.NoResultsFound"]" Description="@Localizer["DataGrid.NoResultsFilterDescription"]" Size="EmptySize.Small" />
                                </td>
                            </tr>
                        }
                        else if (_groupedRenderItems != null)
                        {
                            if (Virtualize && ItemSize > 0 && _groupedRenderItemsList != null)
                            {
                                <Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize Items="@_groupedRenderItemsList" Context="renderItem" ItemSize="@ItemSize" OverscanCount="@OverscanCount">
                                    @RenderGroupedOrHierarchyItem(renderItem)
                                </Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize>
                            }
                            else
                            {
                                @foreach (var renderItem in _groupedRenderItems)
                                {
                                    @RenderGroupedOrHierarchyItem(renderItem)
                                }
                            }
                        }
                        else if (IsVirtualizedProvider)
                        {
                            <Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize @ref="_virtualizeRef"
                                ItemsProvider="@VirtualItemsProviderAsync" Context="item"
                                ItemSize="@ItemSize" OverscanCount="@OverscanCount">
                                @RenderDataRow(item)
                            </Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize>
                        }
                        else if (Virtualize && ItemSize > 0)
                        {
                            <Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize Items="@_processedDataList" Context="item" ItemSize="@ItemSize" OverscanCount="@OverscanCount">
                                @RenderDataRow(item)
                            </Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize>
                        }
                        else
                        {
                            @foreach (var item in _processedData)
                            {
                                @RenderDataRow(item)
                                @if (_gridState.Expanded.IsExpanded(item))
                                {
                                    @if (HasDetailRows)
                                    {
                                        @ExpandColumnDetailRows!(item)
                                    }
                                    @if (DetailTemplate != null)
                                    {
                                        <tr class="bb:border-b">
                                            <td colspan="@_cachedVisibleColumns.Count" class="bb:p-4">
                                                @DetailTemplate(item)
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    </BlazorBlueprint.Primitives.DataGrid.BbDataGridBody>
                </BlazorBlueprint.Primitives.DataGrid.BbDataGrid>
            }
        </div>

        @if (RowContextMenu != null)
        {
            <BbContextMenu @ref="rowContextMenu">
                <BbContextMenuContent>
                    @if (contextMenuItem != null)
                    {
                        @RowContextMenu(new DataGridRowMenuContext<TData>
                        {
                            Item = contextMenuItem,
                            SelectedItems = _gridState.Selection.SelectedItems,
                            VisibleColumns = GetVisibleDataColumns(),
                            CopyToClipboardAsync = CopyToClipboardAsync
                        })
                    }
                </BbContextMenuContent>
            </BbContextMenu>
        }

        @if (ShowPagination && !IsLoading && !IsVirtualizedProvider && _processedData.Any())
        {
            <BbPagination State="@_gridState.Pagination"
                        PageSizes="@PageSizes"
                        OnPageChanged="@HandlePageChanged"
                        OnPageSizeChanged="@HandlePageSizeChanged"
                        Class="bb:flex bb:items-center bb:justify-between bb:px-2 bb:py-4">
                <BbPaginationInfo>
                    @if (_gridState.Selection.HasSelection)
                    {
                        <span>@Localizer["DataGrid.RowsSelected", _gridState.Selection.SelectedCount, _gridState.Pagination.TotalItems]</span>
                    }
                </BbPaginationInfo>
                <BbPaginationContent Class="bb:flex bb:items-center bb:gap-6 bb:lg:gap-8">
                    <div class="bb:hidden bb:sm:flex"><BbPaginationPageSizeSelector /></div>
                    <div class="bb:flex bb:items-center bb:gap-2">
                        <div class="bb:hidden bb:lg:flex"><BbPaginationPageDisplay /></div>
                        <div class="bb:flex bb:items-center bb:gap-1">
                            <div class="bb:hidden bb:sm:flex"><BbPaginationItem><BbPaginationFirst /></BbPaginationItem></div>
                            <BbPaginationItem><BbPaginationPrevious ShowText="false" /></BbPaginationItem>
                            <BbPaginationItem><BbPaginationNext ShowText="false" /></BbPaginationItem>
                            <div class="bb:hidden bb:sm:flex"><BbPaginationItem><BbPaginationLast /></BbPaginationItem></div>
                        </div>
                    </div>
                </BbPaginationContent>
            </BbPagination>
        }
    </div>

    @* Capture column definitions from child components *@
    @Columns
</CascadingValue>

@code {
    private string FormatAggregateName(AggregateFunction function) => function switch
    {
        AggregateFunction.Count => Localizer["DataGrid.CountLabel"],
        AggregateFunction.Sum => Localizer["DataGrid.SumLabel"],
        AggregateFunction.Average => Localizer["DataGrid.AverageLabel"],
        AggregateFunction.Min => Localizer["DataGrid.MinLabel"],
        AggregateFunction.Max => Localizer["DataGrid.MaxLabel"],
        _ => ""
    };

    private static string FormatAggregateValue(object? value, string? format)
    {
        if (value == null)
        {
            return "-";
        }

        if (!string.IsNullOrEmpty(format) && value is IFormattable formattable)
        {
            return formattable.ToString(format, System.Globalization.CultureInfo.CurrentCulture);
        }

        if (value is double d)
        {
            // Use integer format when the value has no fractional part
            return d == Math.Truncate(d)
                ? d.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)
                : d.ToString("N2", System.Globalization.CultureInfo.CurrentCulture);
        }

        return value.ToString() ?? "-";
    }

    private RenderFragment<TData> RenderDataRow => item =>
        @<BlazorBlueprint.Primitives.DataGrid.BbDataGridRow TData="TData" Item="@item"
            Class="@ClassNames.cn("bb:group/row bb:bg-background", Striped ? StripeClass : null, RowClass?.Invoke(item), IsEditing(item) ? "bb:bg-muted/40" : null)">
            @{
                var rowIsEditing = IsEditing(item);
            }
            @if (rowIsEditing && !UsesEditBuffer && _editContext != null)
            {
                @* Cascaded rather than wrapped in an EditForm: a form element is not valid inside
                   a table row, but the validator only needs the context. *@
                <CascadingValue Value="_editContext" IsFixed="false">
                    <DataAnnotationsValidator />
                </CascadingValue>
            }
            @foreach (var column in _cachedVisibleColumns)
            {
                var isSelectColumn = column.ColumnId == "__select";
                var isExpandColumn = column.ColumnId == "__expand";
                var isEditColumn = column.ColumnId == "__edit";
                var isLastLeft = column.ColumnId == _cachedLastLeftId;
                var isFirstRight = column.ColumnId == _cachedFirstRightId;
                var pinnedStyle = GetPinnedStyle(column, _cachedVisibleColumns);

                <BlazorBlueprint.Primitives.DataGrid.BbDataGridCell
                    @key="@column.ColumnId"
                    Class="@GetCellClass(column, isSelectColumn, isExpandColumn, isLastLeft, isFirstRight, item)"
                    style="@pinnedStyle"
                    data-pinned="@(column.Pinned != ColumnPinning.None ? "true" : null)">
                    @if (isEditColumn)
                    {
                        <div @onclick:stopPropagation="true" class="bb:flex bb:items-center bb:gap-1">
                            @if (rowIsEditing)
                            {
                                <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small"
                                          OnClick="@(async () => await CommitEditAsync())"
                                          AriaLabel="@Localizer["DataGrid.SaveRow"]">
                                    @Localizer["DataGrid.SaveRow"]
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                          OnClick="CancelEditAsync"
                                          AriaLabel="@Localizer["DataGrid.CancelRowEdit"]">
                                    @Localizer["DataGrid.CancelRowEdit"]
                                </BbButton>
                            }
                            else
                            {
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                          OnClick="@(async () => await StartEditAsync(item))"
                                          AriaLabel="@Localizer["DataGrid.EditRow"]">
                                    <LucideIcon Name="pencil" Class="bb:w-4 bb:h-4" />
                                </BbButton>
                            }
                        </div>
                    }
                    else if (ShouldRenderEditor(column, item))
                    {
                        @RenderEditableCell(column, item)
                    }
                    else if (isExpandColumn)
                    {
                        @if (DetailTemplate != null || HasDetailRows)
                        {
                            var isExpanded = _gridState.Expanded.IsExpanded(item);
                            <button type="button"
                                    class="bb:inline-flex bb:items-center bb:justify-center bb:rounded-md bb:w-8 bb:h-8 bb:hover:bg-muted bb:transition-colors"
                                    aria-expanded="@isExpanded.ToString().ToLowerInvariant()"
                                    aria-label="@(isExpanded ? Localizer["DataGrid.CollapseRow"] : Localizer["DataGrid.ExpandRow"])"
                                    @onclick="@(() => HandleRowExpandToggle(item))"
                                    @onclick:stopPropagation="true">
                                <LucideIcon Name="@(isExpanded ? "chevron-down" : "chevron-right")" Class="bb:w-4 bb:h-4" />
                            </button>
                        }
                    }
                    else if (isSelectColumn)
                    {
                        <div @onclick:stopPropagation="true">
                            <BbCheckbox Checked="@_gridState.Selection.IsSelected(item)"
                                      CheckedChanged="@((bool isChecked) => HandleRowSelectionChanged(item, isChecked))"
                                      AriaLabel="@Localizer["DataGrid.SelectThisRow"]" />
                        </div>
                    }
                    else
                    {
                        @RenderCellValue(column, item)
                    }
                </BlazorBlueprint.Primitives.DataGrid.BbDataGridCell>
            }
        </BlazorBlueprint.Primitives.DataGrid.BbDataGridRow>;

    private RenderFragment<DataGridRenderItem<TData>> RenderGroupedOrHierarchyItem => renderItem =>
    {
        if (renderItem.IsGroupHeader)
        {
            var group = renderItem.GroupRow!;
            var groupKey = group.Key ?? "(empty)";
            var isCollapsed = _gridState.Grouping.IsCollapsed(group.Path);
            var groupIndent = group.Depth * GetGroupIndentSize();
            var effectiveTemplate = _groupColumnHeaderTemplate ?? GroupHeaderTemplate;
            var groupContext = new DataGridGroupContext<TData>
            {
                Group = group,
                IsCollapsed = isCollapsed,
                VisibleColumnCount = _cachedVisibleColumns.Count,
                ToggleCollapse = EventCallback.Factory.Create(this, () => HandleGroupToggle(group))
            };

            if (effectiveTemplate != null)
            {
                return @<tr role="row" class="bb:bg-muted/50 bb:border-b bb:font-medium">
                    <td role="gridcell" colspan="@_cachedVisibleColumns.Count" class="bb:px-4 bb:py-2"
                        style="@(groupIndent > 0 ? $"padding-left: {groupIndent + 16}px;" : null)">
                        @effectiveTemplate(groupContext)
                    </td>
                </tr>;
            }
            else
            {
                var groupLabelColSpan = GetGroupLabelColSpan(group);
                return @<tr role="row" class="bb:bg-muted/50 bb:border-b bb:font-medium">
                    <td role="gridcell" colspan="@groupLabelColSpan" class="bb:px-4 bb:py-2">
                        <div class="bb:flex bb:items-center bb:gap-2" style="@(groupIndent > 0 ? $"padding-left: {groupIndent}px;" : null)">
                            <button type="button"
                                    class="bb:inline-flex bb:items-center bb:justify-center bb:rounded-md bb:w-6 bb:h-6 bb:hover:bg-muted bb:transition-colors"
                                    aria-expanded="@(!isCollapsed)"
                                    aria-label="@(isCollapsed ? Localizer["DataGrid.ExpandGroup"] : Localizer["DataGrid.CollapseGroup"])"
                                    @onclick="groupContext.ToggleCollapse"
                                    @onclick:stopPropagation="true">
                                <LucideIcon Name="@(isCollapsed ? "chevron-right" : "chevron-down")" Class="bb:w-4 bb:h-4" />
                            </button>
                            <span>@group.ColumnTitle: @(groupKey.ToString())</span>
                            <span class="bb:text-muted-foreground bb:text-sm">@Localizer["DataGrid.GroupItemCount", group.ItemCount]</span>
                        </div>
                    </td>
                    @foreach (var col in GetGroupAggregateColumns(group))
                    {
                        <td role="gridcell" class="bb:px-4 bb:py-2 bb:text-muted-foreground bb:text-sm">
                            @if (group.Aggregates.TryGetValue(col.ColumnId, out var agg))
                            {
                                <span>@FormatAggregateName(agg.Function): @FormatAggregateValue(agg.Value, agg.Format)</span>
                            }
                        </td>
                    }
                </tr>;
            }
        }
        else if (renderItem.IsChildPagerRow)
        {
            var pagerDepth = renderItem.Depth;
            var pagerParentValue = renderItem.ParentValue!;
            var pagerPageIndex = renderItem.ChildPageIndex;
            var pagerTotalChildren = renderItem.TotalChildren;
            var pagerPageSize = ChildPageSize ?? 10;
            var pagerStart = pagerPageIndex * pagerPageSize + 1;
            var pagerEnd = Math.Min((pagerPageIndex + 1) * pagerPageSize, pagerTotalChildren);
            var pagerTotalPages = (int)Math.Ceiling((double)pagerTotalChildren / pagerPageSize);
            var pagerIndent = pagerDepth * GetHierarchyIndentSize();

            return @<tr role="row" class="bb:border-b bb:bg-muted/30">
                <td role="gridcell" colspan="@_cachedVisibleColumns.Count" class="bb:px-4 bb:py-1.5">
                    <div class="bb:flex bb:items-center bb:gap-2 bb:text-xs bb:text-muted-foreground" style="@($"padding-left: {pagerIndent}px")">
                        <span>@Localizer["DataGrid.ShowingRange", pagerStart, pagerEnd, pagerTotalChildren]</span>
                        <div class="bb:flex bb:items-center bb:gap-0.5">
                            <button type="button"
                                    class="bb:inline-flex bb:items-center bb:justify-center bb:rounded bb:w-6 bb:h-6 bb:hover:bg-muted bb:transition-colors bb:disabled:opacity-50"
                                    disabled="@(pagerPageIndex <= 0)"
                                    @onclick="@(() => HandleChildPageChange(pagerParentValue, pagerPageIndex - 1))"
                                    @onclick:stopPropagation="true"
                                    aria-label="@Localizer["DataGrid.PreviousPage"]">
                                <LucideIcon Name="chevron-left" Class="bb:w-3.5 bb:h-3.5" />
                            </button>
                            <span class="bb:tabular-nums bb:px-1">@(pagerPageIndex + 1) / @pagerTotalPages</span>
                            <button type="button"
                                    class="bb:inline-flex bb:items-center bb:justify-center bb:rounded bb:w-6 bb:h-6 bb:hover:bg-muted bb:transition-colors bb:disabled:opacity-50"
                                    disabled="@(pagerPageIndex >= pagerTotalPages - 1)"
                                    @onclick="@(() => HandleChildPageChange(pagerParentValue, pagerPageIndex + 1))"
                                    @onclick:stopPropagation="true"
                                    aria-label="@Localizer["DataGrid.NextPage"]">
                                <LucideIcon Name="chevron-right" Class="bb:w-3.5 bb:h-3.5" />
                            </button>
                        </div>
                    </div>
                </td>
            </tr>;
        }
        else if (renderItem.IsDataRow && IsInHierarchyMode)
        {
            return @<text>@RenderHierarchyRow(renderItem)</text>;
        }
        else
        {
            return @<text>
                @RenderDataRow(renderItem.Item!)
                @if (_gridState.Expanded.IsExpanded(renderItem.Item!))
                {
                    @if (HasDetailRows)
                    {
                        @ExpandColumnDetailRows!(renderItem.Item!)
                    }
                    @if (DetailTemplate != null)
                    {
                        <tr class="bb:border-b">
                            <td colspan="@_cachedVisibleColumns.Count" class="bb:p-4">
                                @DetailTemplate(renderItem.Item!)
                            </td>
                        </tr>
                    }
                }
            </text>;
        }
    };

    private RenderFragment<DataGridRenderItem<TData>> RenderHierarchyRow => renderItem =>
    {
        var item = renderItem.Item!;
        var rowClass = ClassNames.cn("bb:group/row bb:bg-background",
            Striped ? StripeClass : null,
            !renderItem.MatchesFilter ? "bb:opacity-50" : "",
            RowClass?.Invoke(item));

        return @<BlazorBlueprint.Primitives.DataGrid.BbDataGridRow @key="@ItemValueSelector!(item)" TData="TData" Item="@item"
            Class="@rowClass"
            aria-level="@(renderItem.Depth + 1)">
            @foreach (var column in _cachedVisibleColumns)
            {
                var isSelectColumn = column.ColumnId == "__select";
                var isExpandColumn = column.ColumnId == "__expand";
                var isHierarchyColumn = _hierarchyColumn != null && column.ColumnId == _hierarchyColumn.ColumnId;
                var isLastLeft = column.ColumnId == _cachedLastLeftId;
                var isFirstRight = column.ColumnId == _cachedFirstRightId;
                var pinnedStyle = GetPinnedStyle(column, _cachedVisibleColumns);

                <BlazorBlueprint.Primitives.DataGrid.BbDataGridCell
                    @key="@column.ColumnId"
                    Class="@GetCellClass(column, isSelectColumn, isExpandColumn, isLastLeft, isFirstRight, item)"
                    style="@pinnedStyle"
                    data-pinned="@(column.Pinned != ColumnPinning.None ? "true" : null)">
                    @if (isSelectColumn)
                    {
                        <div @onclick:stopPropagation="true">
                            <BbCheckbox Checked="@_gridState.Selection.IsSelected(item)"
                                      Indeterminate="@IsHierarchyItemIndeterminate(item)"
                                      CheckedChanged="@((bool isChecked) => HandleRowSelectionChanged(item, isChecked))"
                                      AriaLabel="@Localizer["DataGrid.SelectThisRow"]" />
                        </div>
                    }
                    else if (isHierarchyColumn)
                    {
                        var indent = renderItem.Depth * GetHierarchyIndentSize();
                        <div class="bb:flex bb:items-center" style="@($"padding-left: {indent}px")">
                            @if (renderItem.HasChildren)
                            {
                                <button type="button"
                                        class="bb:inline-flex bb:items-center bb:justify-center bb:rounded-md bb:w-6 bb:h-6 bb:mr-1 bb:hover:bg-muted bb:transition-colors bb:shrink-0"
                                        aria-expanded="@renderItem.IsExpanded.ToString().ToLowerInvariant()"
                                        aria-label="@(renderItem.IsExpanded ? Localizer["DataGrid.Collapse"] : Localizer["DataGrid.Expand"])"
                                        @onclick="@(() => HandleHierarchyNodeToggle(item))"
                                        @onclick:stopPropagation="true">
                                    <LucideIcon Name="@(renderItem.IsExpanded ? "chevron-down" : "chevron-right")"
                                               Class="bb:w-4 bb:h-4 bb:transition-transform" />
                                </button>
                            }
                            else
                            {
                                <span class="bb:inline-block bb:w-6 bb:mr-1 bb:shrink-0"></span>
                            }
                            @if (ShouldRenderEditor(column, item))
                            {
                                @RenderEditableCell(column, item)
                            }
                            else
                            {
                                @RenderCellValue(column, item)
                            }
                        </div>
                    }
                    else if (ShouldRenderEditor(column, item))
                    {
                        @RenderEditableCell(column, item)
                    }
                    else
                    {
                        @RenderCellValue(column, item)
                    }
                </BlazorBlueprint.Primitives.DataGrid.BbDataGridCell>
            }
        </BlazorBlueprint.Primitives.DataGrid.BbDataGridRow>;
    };

    private RenderFragment RenderEditableCell(IDataGridColumn<TData> column, TData item) => @<text>
        <CascadingValue Value="_editContext">
            <fieldset disabled="@savingEdits" data-bb-cell-editor @onclick:stopPropagation="true" class="bb:min-w-0 bb:space-y-1">
                @column.EditTemplate!(new DataGridCellContext<TData>
                {
                    Item = editModel ?? item,
                    Column = column,
                    Value = column.GetValue(editModel ?? item)
                })
                <ValidationSummary class="bb:text-destructive bb:text-xs" />
                @if (UsesEditBuffer)
                {
                    <div class="bb:flex bb:gap-1">
                        <BbButton Size="ButtonSize.Small" OnClick="@(async () => await CommitEditAsync())">@Localizer["DataGrid.SaveRow"]</BbButton>
                        <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" OnClick="CancelEditAsync">@Localizer["DataGrid.CancelRowEdit"]</BbButton>
                    </div>
                }
            </fieldset>
        </CascadingValue>
    </text>;

    private RenderFragment RenderCellValue(IDataGridColumn<TData> column, TData item) => @<text>
        @if (column.CellTemplate != null)
        {
            @column.CellTemplate(new DataGridCellContext<TData> { Item = DisplayItem(item), Column = column, Value = column.GetValue(DisplayItem(item)) })
        }
        else
        {
            @(column.GetValue(DisplayItem(item))?.ToString() ?? "")
        }
        @if (IsCellEditable(column))
        {
            <button type="button" id="@CellTriggerId(item, column.ColumnId)" disabled="@savingEdits" class="bb:ml-2 bb:inline-flex bb:rounded bb:p-1 bb:hover:bg-muted"
                    aria-label="@Localizer["DataGrid.EditCell", column.Title ?? column.ColumnId]" @onclick:stopPropagation="true"
                    @onclick="@(() => StartCellEditAsync(item, column.ColumnId))">
                <LucideIcon Name="pencil" Class="bb:w-3 bb:h-3" />
            </button>
        }
    </text>;

    private int GetHierarchyIndentSize()
    {
        // Check if the hierarchy column has a custom indent size
        // Default to 24px
        return 24;
    }

    /// <summary>
    /// How far each nested grouping level is indented, in pixels. Matches the hierarchy indent so
    /// a grid that uses both reads as one structure.
    /// </summary>
    private int GetGroupIndentSize() => GetHierarchyIndentSize();
}
