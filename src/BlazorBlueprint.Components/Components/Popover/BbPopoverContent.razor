@namespace BlazorBlueprint.Components

@* Styled PopoverContent with shadcn/ui classes *@

<BlazorBlueprint.Primitives.Popover.BbPopoverContent ForceMount="@ForceMount"
                                                   CloseOnEscape="@CloseOnEscape"
                                                   CloseOnClickOutside="@CloseOnClickOutside"
                                                   Side="@Side"
                                                   Align="@Align"
                                                   Offset="@Offset"
                                                   MatchTriggerWidth="@MatchTriggerWidth"
                                                   ScrollToSelected="@ScrollToSelected"
                                                   ScrollToSelectedSelector="@ScrollToSelectedSelector"
                                                   AutoFocusId="@AutoFocusId"
                                                   Strategy="@Strategy"
                                                   ZIndex="@ZIndex"
                                                   OnEscapeKeyDown="@OnEscapeKeyDown"
                                                   OnClickOutside="@OnClickOutside"
                                                   OnContentReady="@OnContentReady"
                                                   class="@CssClass"
                                                   @attributes="AdditionalAttributes">
    @ChildContent
</BlazorBlueprint.Primitives.Popover.BbPopoverContent>

@code {
    /// <summary>
    /// Whether to keep the content mounted in the DOM when closed.
    /// When true, enables CSS exit animations.
    /// Default is false.
    /// </summary>
    [Parameter]
    public bool ForceMount { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether to scroll the currently chosen item into view each time the popover opens, before
    /// it is revealed. For list content such as a combobox.
    /// </summary>
    [Parameter]
    public bool ScrollToSelected { get; set; }

    /// <summary>
    /// CSS selector identifying the chosen item for <see cref="ScrollToSelected"/>.
    /// </summary>
    [Parameter]
    public string ScrollToSelectedSelector { get; set; } = "[role=\"option\"][aria-selected=\"true\"]";

    /// <summary>
    /// The <c>id</c> of an element inside the popover to focus one frame after it is revealed,
    /// inside the call that positions it. Costs no round trip.
    /// </summary>
    [Parameter]
    public string? AutoFocusId { get; set; }

    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    [Parameter]
    public bool CloseOnClickOutside { get; set; } = true;

    [Parameter]
    public PopoverSide Side { get; set; } = PopoverSide.Bottom;

    [Parameter]
    public PopoverAlign Align { get; set; } = PopoverAlign.Center;

    [Parameter]
    public int Offset { get; set; } = 4;

    [Parameter]
    public bool MatchTriggerWidth { get; set; } = false;

    /// <summary>
    /// CSS positioning strategy.
    /// Default is <see cref="PositioningStrategy.Fixed"/> to correctly escape stacking contexts
    /// (e.g. inside Dialog, Sheet, Drawer).
    /// Use <see cref="PositioningStrategy.Absolute"/> only when the popover should scroll with a container.
    /// </summary>
    [Parameter]
    public PositioningStrategy Strategy { get; set; } = PositioningStrategy.Fixed;

    /// <summary>
    /// CSS z-index value for the popover content.
    /// Default is 9999 to render above overlays (Dialog, Sheet, Drawer).
    /// </summary>
    [Parameter]
    public int ZIndex { get; set; } = 9999;

    [Parameter]
    public EventCallback<KeyboardEventArgs> OnEscapeKeyDown { get; set; }

    [Parameter]
    public EventCallback OnClickOutside { get; set; }

    /// <summary>
    /// Event callback invoked when the popover content is fully ready (positioned and visible).
    /// Useful for focus management.
    /// </summary>
    [Parameter]
    public EventCallback OnContentReady { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // Use w-full when MatchTriggerWidth is true so content respects the FloatingPortal wrapper's width
    // Otherwise use default w-72 for standard popover width
    private string WidthClass => MatchTriggerWidth ? "bb:w-full" : "bb:w-72";

    private string CssClass => ClassNames.cn(
        "bb:z-50", WidthClass, "bb:rounded-md bb:border bb:bg-popover bb:p-4 bb:text-popover-foreground bb:shadow-md bb:outline-none",
        "bb:data-[state=open]:animate-in bb:data-[state=closed]:animate-out",
        "bb:data-[state=closed]:fade-out-0 bb:data-[state=open]:fade-in-0",
        "bb:data-[state=closed]:zoom-out-95 bb:data-[state=open]:zoom-in-95",
        "bb:data-[side=bottom]:slide-in-from-top-2 bb:data-[side=left]:slide-in-from-right-2",
        "bb:data-[side=right]:slide-in-from-left-2 bb:data-[side=top]:slide-in-from-bottom-2",
        Class
    );
}
