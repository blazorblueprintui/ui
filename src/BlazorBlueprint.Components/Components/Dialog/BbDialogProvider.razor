@namespace BlazorBlueprint.Components
@using BlazorBlueprint.Components.Components.Dialog.Internals
@implements IAsyncDisposable
@inject DialogService DialogService
@inject IFocusManager FocusManager
@inject IJSRuntime JSRuntime

@*
    Dialog Provider - renders programmatic confirm dialogs from DialogService.
    Place this component once at the root of your application (e.g., in MainLayout).
*@

@foreach (var dialog in rendered)
{
    var titleId = $"bb-dialog-{dialog.Id}-title";
    var descId = $"bb-dialog-{dialog.Id}-desc";
    var animation = GetAnimation(dialog);
    var isLeaving = leaving.Contains(dialog.Id);

    <div @key="dialog.Id">

        @* Overlay *@
        <div class="@(isLeaving ? "bb:animate-out bb:fade-out-0" : "bb:animate-in bb:fade-in-0") bb:fixed bb:inset-0 bb:z-50 bb:bg-black/80"
             style="@animation?.OverlayStyle"
             @onclick="() => TryBackdropClose(dialog)" />

        @* Content *@
        <div class="@GetDialogContainerClass(dialog, animation)"
             data-state="@(isLeaving ? "closed" : "open")"
             @ref="contentRefs[dialog.Id]"
             role="@(dialog is AlertDialogData or ConfirmDialogData ? "alertdialog" : "dialog")"
             aria-modal="true"
             aria-labelledby="@titleId"
             aria-describedby="@(dialog.Description != null ? descId : null)">
            @switch (dialog)
            {
                case ConfirmDialogData confirm:
                    <ConfirmDialog Dialog="confirm" TitleId="@titleId" DescriptionId="@descId" />
                    break;

                case AlertDialogData alert:
                    <AlertDialog Dialog="alert" TitleId="@titleId" DescriptionId="@descId" />
                    break;

                case PromptDialogData prompt:
                    <PromptDialog Dialog="prompt" TitleId="@titleId" DescriptionId="@descId" />
                    break;

                case ComponentDialogData component:
                    <ComponentDialog Dialog="component" TitleId="@titleId" DescriptionId="@descId" />
                    break;
            }
        </div>
    </div>
}

@code {
    private const string DialogContainerBaseClass =
        "bb:fixed bb:left-[50%] bb:top-[50%] bb:z-50 bb:grid bb:w-full " +
        "bb:translate-x-[-50%] bb:translate-y-[-50%] bb:gap-4 bb:border bb:bg-background bb:p-6 bb:shadow-lg bb:sm:rounded-lg bb:animate-in bb:fade-in-0";

    private readonly Dictionary<string, ElementReference> contentRefs = new();

    // The dialogs on screen, in stacking order: the service's open dialogs, plus any that have
    // closed but are still playing their exit animation.
    private readonly List<DialogData> rendered = new();
    private readonly HashSet<string> leaving = new();
    private readonly HashSet<string> entered = new();
    private MotionInterop? motion;
    private IAsyncDisposable? focusTrap;
    private string? focusTrapDialogId;
    private IJSObjectReference? portalModule;
    private IJSObjectReference? scrollLockCleanup;
    private IJSObjectReference? escapeModule;
    private DotNetObjectReference<BbDialogProvider>? dotNetRef;
    private readonly string instanceId = Guid.NewGuid().ToString("N");
    private bool isInitialized;
    private bool disposed;

    protected override void OnInitialized()
    {
        SyncRendered();
        DialogService.OnChange += HandleChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        PlayEnterAnimations();

        // Modal protection follows the dialogs on screen, so a dialog playing its exit keeps the
        // focus trap, scroll lock and Escape handling until it leaves.
        if (rendered.Count > 0 && !isInitialized)
        {
            isInitialized = true;

            // Focus trap on the topmost dialog
            await TrapFocusOnTopmostAsync();

            // Scroll lock
            try
            {
                portalModule = await PrimitiveModules.GetAsync(JSRuntime);
                scrollLockCleanup = await portalModule.InvokeAsync<IJSObjectReference>("portal.lockBodyScroll");
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
            {
            }

            // Escape key
            try
            {
                escapeModule = await PrimitiveModules.GetAsync(JSRuntime);
                dotNetRef = DotNetObjectReference.Create(this);
                await escapeModule.InvokeVoidAsync("escapeKeydown.initialize", dotNetRef, instanceId);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
            {
            }
        }
        else if (rendered.Count > 0 && isInitialized)
        {
            // Re-trap focus on the topmost dialog when the stack changes
            var topmostId = rendered[^1].Id;
            if (focusTrapDialogId != topmostId)
            {
                await TrapFocusOnTopmostAsync();
            }
        }
        else if (rendered.Count == 0 && isInitialized)
        {
            await CleanupJsAsync();
        }
    }

    private async Task TrapFocusOnTopmostAsync()
    {
        // Release previous focus trap
        if (focusTrap != null)
        {
            try
            {
                await focusTrap.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
            }
            focusTrap = null;
            focusTrapDialogId = null;
        }

        var topmostDialog = rendered[^1];
        if (contentRefs.TryGetValue(topmostDialog.Id, out var elementRef))
        {
            try
            {
                focusTrap = await FocusManager.TrapFocus(elementRef);
                focusTrapDialogId = topmostDialog.Id;
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
            {
            }
        }
    }

    [JSInvokable]
    public void JsOnEscapeKey()
    {
        if (disposed || rendered.Count == 0)
        {
            return;
        }

        // A topmost dialog that is already leaving has its result, so Escape does nothing until
        // it has gone; it must not reach the dialog underneath.
        var topmost = rendered[^1];
        InvokeAsync(() => TryBackdropClose(topmost));
    }

    private void HandleChange()
        => InvokeAsync(() =>
        {
            SyncRendered();
            StateHasChanged();
        });

    /// <summary>
    /// Brings <see cref="rendered"/> in line with the service. A closed dialog with an exit
    /// animation stays, in place, until the animation ends; any other closed dialog goes at once.
    /// </summary>
    private void SyncRendered()
    {
        var open = DialogService.Dialogs;

        foreach (var dialog in rendered.ToList())
        {
            if (open.Contains(dialog) || leaving.Contains(dialog.Id))
            {
                continue;
            }

            if (GetAnimation(dialog) is { HasExit: true } animation && contentRefs.TryGetValue(dialog.Id, out var element))
            {
                leaving.Add(dialog.Id);
                _ = PlayExitAsync(dialog, animation, element);
            }
            else
            {
                Forget(dialog);
            }
        }

        foreach (var dialog in open)
        {
            if (!rendered.Contains(dialog))
            {
                rendered.Add(dialog);
            }
        }
    }

    private async Task PlayExitAsync(DialogData dialog, DialogAnimation animation, ElementReference element)
    {
        try
        {
            await animation.PlayAsync(motion ??= new(JSRuntime), element, exiting: true);
        }
        finally
        {
            await InvokeAsync(() =>
            {
                Forget(dialog);
                if (!disposed)
                {
                    StateHasChanged();
                }
            });
        }
    }

    private void PlayEnterAnimations()
    {
        foreach (var dialog in rendered)
        {
            if (leaving.Contains(dialog.Id) || !entered.Add(dialog.Id))
            {
                continue;
            }

            if (GetAnimation(dialog) is { HasEnter: true } animation && contentRefs.TryGetValue(dialog.Id, out var element))
            {
                _ = animation.PlayAsync(motion ??= new(JSRuntime), element, exiting: false);
            }
        }
    }

    private void Forget(DialogData dialog)
    {
        rendered.Remove(dialog);
        leaving.Remove(dialog.Id);
        entered.Remove(dialog.Id);
        contentRefs.Remove(dialog.Id);
    }

    private static DialogAnimation? GetAnimation(DialogData dialog) =>
        dialog is ComponentDialogData { Options: var options }
            ? DialogAnimation.Create(options.EnterPreset, options.ExitPreset, options.EnterKeyframes, options.ExitKeyframes, options.AnimationDuration)
            : null;

    private void TryBackdropClose(DialogData dialog)
    {
        if (dialog is AlertDialogData)
        {
            return;
        }

        if (dialog is ComponentDialogData component &&
            component.Options.PreventClose)
        {
            return;
        }

        DialogService.Resolve(dialog.Id, DialogResult.Cancel());
    }

    private static string GetDialogContainerClass(DialogData dialog, DialogAnimation? animation)
    {
        var sizeClass = dialog is ComponentDialogData component
            ? component.Options.Size switch
            {
                DialogSize.Small => "bb:max-w-sm",
                DialogSize.Large => "bb:max-w-2xl",
                DialogSize.ExtraLarge => "bb:max-w-4xl",
                DialogSize.Full => "bb:max-w-[95vw]",
                _ => "bb:max-w-lg"
            }
            : "bb:max-w-lg";

        // A Motion enter takes over from the built-in zoom; the CSS fade only keeps the content
        // from showing before the Motion enter starts.
        var zoomClass = animation is { HasEnter: true } ? string.Empty : " bb:zoom-in-95";

        return $"{DialogContainerBaseClass}{zoomClass} {sizeClass}";
    }

    private async Task CleanupJsAsync()
    {
        if (focusTrap != null)
        {
            try
            {
                await focusTrap.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
            }
            focusTrap = null;
            focusTrapDialogId = null;
        }

        if (scrollLockCleanup != null)
        {
            try
            {
                await scrollLockCleanup.InvokeVoidAsync("apply");
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
            }
            scrollLockCleanup = null;
        }

        if (escapeModule != null)
        {
            try
            {
                await escapeModule.InvokeVoidAsync("escapeKeydown.dispose", instanceId);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
            }
            escapeModule = null;
        }


        dotNetRef?.Dispose();
        dotNetRef = null;
        contentRefs.Clear();
        isInitialized = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        DialogService.OnChange -= HandleChange;
        await CleanupJsAsync();
        if (motion is not null)
        {
            await motion.DisposeAsync();
        }

        DialogService.CancelAll();
    }
}
