@namespace BlazorBlueprint.Components

@* Styled ContextMenuCheckboxItem - wrapper with shadcn Tailwind classes *@
<BlazorBlueprint.Primitives.ContextMenu.BbContextMenuCheckboxItem class="@CssClass"
                                                           Checked="@Checked"
                                                           CheckedChanged="@HandleCheckedChanged"
                                                           Disabled="@Disabled"
                                                           CloseOnSelect="@CloseOnSelect"
                                                           @attributes="AdditionalAttributes">
    <span class="@IndicatorClass">
        @if (Checked)
        {
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="16"
                 height="16"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="bb:h-4 bb:w-4">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        }
    </span>
    @ChildContent
</BlazorBlueprint.Primitives.ContextMenu.BbContextMenuCheckboxItem>

@code {
    /// <summary>
    /// The content to display inside the menu item.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the menu item.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Whether the checkbox is checked.
    /// </summary>
    [Parameter]
    public bool Checked { get; set; }

    /// <summary>
    /// Event callback for when the checked state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>
    /// Whether the menu item is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// Whether to close the context menu when this item is toggled.
    /// Default is false.
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = false;

    private async Task HandleCheckedChanged(bool value)
    {
        Checked = value;
        await CheckedChanged.InvokeAsync(value);
    }

    private string CssClass => ClassNames.cn(
        "bb:relative bb:flex bb:cursor-default bb:select-none bb:items-center bb:rounded-sm bb:py-1.5 bb:pl-8 bb:pr-2",
        "bb:text-sm bb:outline-none bb:transition-colors",
        "bb:focus:bg-(--bb-menu-accent) bb:focus:text-(--bb-menu-accent-foreground)",
        "bb:data-[disabled=true]:pointer-events-none bb:data-[disabled=true]:opacity-50",
        !Disabled ? "bb:hover:bg-(--bb-menu-accent) bb:hover:text-(--bb-menu-accent-foreground)" : null,
        Class
    );

    private const string IndicatorClass = "bb:absolute bb:left-2 bb:flex bb:h-3.5 bb:w-3.5 bb:items-center bb:justify-center";
}
