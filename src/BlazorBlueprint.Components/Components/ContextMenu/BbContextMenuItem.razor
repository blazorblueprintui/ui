@namespace BlazorBlueprint.Components

<BlazorBlueprint.Primitives.ContextMenu.BbContextMenuItem
    OnClick="@OnClick"
    Disabled="@Disabled"
    class="@CssClass"
    @attributes="AdditionalAttributes">
    @if (Icon != null)
    {
        <span class="bb:mr-2 bb:h-4 bb:w-4 bb:shrink-0 bb:[&>svg]:h-4 bb:[&>svg]:w-4">@Icon</span>
    }
    @ChildContent
</BlazorBlueprint.Primitives.ContextMenu.BbContextMenuItem>

@code {
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Optional icon to display before the menu item content.
    /// </summary>
    [Parameter]
    public RenderFragment? Icon { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Inset { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string CssClass => ClassNames.cn(
        "bb:relative bb:flex bb:cursor-default bb:select-none bb:items-center bb:rounded-sm bb:px-2 bb:py-1.5 bb:text-sm bb:outline-none",
        "bb:hover:bg-accent bb:hover:text-accent-foreground bb:focus:bg-accent bb:focus:text-accent-foreground",
        Disabled ? "bb:pointer-events-none bb:opacity-50" : null,
        Inset ? "bb:pl-8" : null,
        Class
    );
}
