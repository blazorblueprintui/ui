@namespace BlazorBlueprint.Components
@typeparam TEvent
@using BlazorBlueprint.Icons.Lucide.Components
@inject IBbLocalizer Localizer

@*
    Event calendar - displays events in a month grid, week columns, or an agenda list.
*@

<div class="@CssClass" @attributes="AdditionalAttributes">
    @* Header: navigation, title, view switcher *@
    <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2 bb:pb-4">
        <div class="bb:flex bb:items-center bb:gap-1">
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Icon"
                      Class="bb:h-8 bb:w-8"
                      OnClick="@NavigatePreviousAsync"
                      AriaLabel="@Localizer["EventCalendar.PreviousPeriod"]">
                <LucideIcon Name="chevron-left" Class="bb:h-4 bb:w-4" />
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Small"
                      Class="bb:h-8"
                      OnClick="@NavigateTodayAsync">
                @Localizer["EventCalendar.Today"]
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Icon"
                      Class="bb:h-8 bb:w-8"
                      OnClick="@NavigateNextAsync"
                      AriaLabel="@Localizer["EventCalendar.NextPeriod"]">
                <LucideIcon Name="chevron-right" Class="bb:h-4 bb:w-4" />
            </BbButton>
        </div>
        <div class="bb:text-base bb:font-semibold" aria-live="polite">@HeaderTitle</div>
        <div class="bb:inline-flex bb:items-center bb:gap-0.5 bb:rounded-md bb:border bb:border-border bb:bg-card bb:p-0.5"
             role="group"
             aria-label="@Localizer["EventCalendar.ViewSwitcher"]">
            <button type="button"
                    class="@GetViewSwitchClasses(EventCalendarView.Month)"
                    aria-pressed="@(View == EventCalendarView.Month ? "true" : "false")"
                    @onclick="@(() => SetViewAsync(EventCalendarView.Month))">
                @Localizer["EventCalendar.Month"]
            </button>
            <button type="button"
                    class="@GetViewSwitchClasses(EventCalendarView.Week)"
                    aria-pressed="@(View == EventCalendarView.Week ? "true" : "false")"
                    @onclick="@(() => SetViewAsync(EventCalendarView.Week))">
                @Localizer["EventCalendar.Week"]
            </button>
            <button type="button"
                    class="@GetViewSwitchClasses(EventCalendarView.Agenda)"
                    aria-pressed="@(View == EventCalendarView.Agenda ? "true" : "false")"
                    @onclick="@(() => SetViewAsync(EventCalendarView.Agenda))">
                @Localizer["EventCalendar.Agenda"]
            </button>
        </div>
    </div>

    @if (View == EventCalendarView.Month)
    {
        @* Month view: six-week grid with event chips per day *@
        <div role="grid" aria-label="@HeaderTitle" class="bb:grid bb:gap-px bb:overflow-hidden bb:rounded-lg bb:border bb:border-border bb:bg-border">
            <div role="row" class="bb:grid bb:grid-cols-7 bb:gap-px">
                @foreach (var dayName in DayNames)
                {
                    <div role="columnheader" class="bb:bg-card bb:px-2 bb:py-1.5 bb:text-center bb:text-xs bb:font-medium bb:text-muted-foreground">
                        @dayName
                    </div>
                }
            </div>
            @foreach (var week in MonthWeeks)
            {
                <div role="row" class="bb:grid bb:grid-cols-7 bb:gap-px">
                    @foreach (var day in week)
                    {
                        var dayEvents = GetEventsForDay(day);
                        var hiddenCount = dayEvents.Count - MaxEventsPerDay;
                        <div role="gridcell" aria-label="@day.ToString("D", culture)" class="@GetMonthCellClasses(day)">
                            <button type="button"
                                    class="@GetDayNumberClasses(day)"
                                    aria-label="@day.ToString("D", culture)"
                                    @onclick="@(() => HandleDateClick(day))">
                                @day.Day
                            </button>
                            @if (dayEvents.Count > 0)
                            {
                                <div class="bb:mt-1 bb:space-y-0.5">
                                    @foreach (var item in dayEvents.Take(MaxEventsPerDay))
                                    {
                                        <button type="button"
                                                class="@GetEventChipClasses(item)"
                                                title="@EventTitle(item)"
                                                @onclick="@(() => HandleEventClick(item))">
                                            @if (EventTemplate is not null)
                                            {
                                                @EventTemplate(item)
                                            }
                                            else
                                            {
                                                <span class="bb:block bb:truncate">@EventTitle(item)</span>
                                            }
                                        </button>
                                    }
                                    @if (hiddenCount > 0)
                                    {
                                        <button type="button"
                                                class="bb:block bb:w-full bb:truncate bb:rounded bb:px-1.5 bb:py-0.5 bb:text-left bb:text-xs bb:text-muted-foreground bb:hover:bg-accent bb:hover:text-accent-foreground bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring"
                                                @onclick="@(() => ShowMoreAsync(day))">
                                            @Localizer["EventCalendar.MoreEvents", hiddenCount]
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (View == EventCalendarView.Week)
    {
        @* Week view: seven day columns with stacked events in start order *@
        <div role="grid" aria-label="@HeaderTitle" class="bb:grid bb:gap-px bb:overflow-hidden bb:rounded-lg bb:border bb:border-border bb:bg-border">
            <div role="row" class="bb:grid bb:grid-cols-7 bb:gap-px">
                @foreach (var day in WeekDays)
                {
                    <div role="columnheader" class="bb:bg-card bb:p-2 bb:text-center">
                        <button type="button"
                                class="bb:mx-auto bb:flex bb:flex-col bb:items-center bb:gap-0.5 bb:rounded-md bb:px-2 bb:py-0.5 bb:hover:bg-accent bb:hover:text-accent-foreground bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring"
                                aria-label="@day.ToString("D", culture)"
                                @onclick="@(() => HandleDateClick(day))">
                            <span class="bb:text-xs bb:font-medium bb:text-muted-foreground">@culture.DateTimeFormat.GetAbbreviatedDayName(day.DayOfWeek)</span>
                            <span class="@GetDayNumberClasses(day)">@day.Day</span>
                        </button>
                    </div>
                }
            </div>
            <div role="row" class="bb:grid bb:grid-cols-7 bb:gap-px">
                @foreach (var day in WeekDays)
                {
                    <div role="gridcell" aria-label="@day.ToString("D", culture)" class="bb:min-h-48 bb:space-y-1 bb:bg-card bb:p-1.5">
                        @foreach (var item in GetEventsForDay(day))
                        {
                            <button type="button"
                                    class="@GetEventChipClasses(item)"
                                    title="@EventTitle(item)"
                                    @onclick="@(() => HandleEventClick(item))">
                                @if (EventTemplate is not null)
                                {
                                    @EventTemplate(item)
                                }
                                else
                                {
                                    <span class="bb:block bb:text-[10px] bb:leading-tight bb:opacity-75">@GetEventTimeLabel(item)</span>
                                    <span class="bb:block bb:truncate">@EventTitle(item)</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        @* Agenda view: the current month's events grouped chronologically by day *@
        <div class="bb:divide-y bb:divide-border bb:overflow-hidden bb:rounded-lg bb:border bb:border-border bb:bg-card bb:text-card-foreground">
            @if (!AgendaDays.Any())
            {
                <p class="bb:p-6 bb:text-center bb:text-sm bb:text-muted-foreground">@Localizer["EventCalendar.NoEvents"]</p>
            }
            @foreach (var day in AgendaDays)
            {
                <div class="bb:p-4">
                    <h3 class="@(day == DateTime.Today ? "bb:text-sm bb:font-semibold bb:text-primary" : "bb:text-sm bb:font-semibold")">
                        @day.ToString("D", culture)
                    </h3>
                    <ul class="bb:mt-2 bb:space-y-1" role="list">
                        @foreach (var item in GetEventsForDay(day))
                        {
                            <li>
                                <button type="button"
                                        class="@ClassNames.cn("bb:flex bb:w-full bb:items-center bb:gap-3 bb:rounded-md bb:px-2 bb:py-1.5 bb:text-left bb:text-sm bb:hover:bg-accent bb:hover:text-accent-foreground bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring", EventClass?.Invoke(item))"
                                        @onclick="@(() => HandleEventClick(item))">
                                    <span class="bb:w-28 bb:shrink-0 bb:text-xs bb:text-muted-foreground">@GetEventTimeLabel(item)</span>
                                    @if (EventTemplate is not null)
                                    {
                                        @EventTemplate(item)
                                    }
                                    else
                                    {
                                        <span class="bb:truncate bb:font-medium">@EventTitle(item)</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
</div>
