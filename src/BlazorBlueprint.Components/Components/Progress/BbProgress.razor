@namespace BlazorBlueprint.Components

@*
    Progress component - displays a progress bar indicator.
    Wraps the Progress primitive for accessibility (role, aria-valuenow, etc).
*@

@if (ShowLabel)
{
    <div class="bb:flex bb:items-center bb:gap-3">
        <BlazorBlueprint.Primitives.Progress.BbProgress
            Value="@Value"
            Max="@Max"
            class="@ContainerCssClass"
            @attributes="AdditionalAttributes">
            <BlazorBlueprint.Primitives.Progress.BbProgressIndicator
                class="@IndicatorCssClass"
                style="@IndicatorStyle" />
        </BlazorBlueprint.Primitives.Progress.BbProgress>
        <span class="bb:text-sm bb:font-medium bb:text-muted-foreground bb:tabular-nums">@(string.Format(LabelFormat, (int)ProgressPercentage))</span>
    </div>
}
else
{
    <BlazorBlueprint.Primitives.Progress.BbProgress
        Value="@Value"
        Max="@Max"
        class="@ContainerCssClass"
        @attributes="AdditionalAttributes">
        <BlazorBlueprint.Primitives.Progress.BbProgressIndicator
            class="@IndicatorCssClass"
            style="@IndicatorStyle" />
    </BlazorBlueprint.Primitives.Progress.BbProgress>
}

@code {
    /// <summary>
    /// The current progress value.
    /// </summary>
    [Parameter]
    public double Value { get; set; } = 0;

    /// <summary>
    /// The maximum value for the progress bar.
    /// Default is 100.
    /// </summary>
    [Parameter]
    public double Max { get; set; } = 100;

    /// <summary>
    /// Additional CSS classes to apply to the progress container.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the progress indicator.
    /// </summary>
    [Parameter]
    public string? IndicatorClass { get; set; }

    /// <summary>
    /// Gets or sets whether to show a percentage label next to the progress bar.
    /// </summary>
    [Parameter]
    public bool ShowLabel { get; set; }

    /// <summary>
    /// Gets or sets a custom format string for the label. Default is "{0}%".
    /// The {0} placeholder is replaced with the integer percentage value.
    /// </summary>
    [Parameter]
    public string LabelFormat { get; set; } = "{0}%";

    /// <summary>
    /// Additional attributes to apply to the progress bar.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the progress percentage (0-100).
    /// </summary>
    private double ProgressPercentage => Max > 0 ? Math.Min(100, Math.Max(0, (Value / Max) * 100)) : 0;

    private string IndicatorStyle => $"transform: translateX(-{100 - ProgressPercentage}%)";

    /// <summary>
    /// Gets the computed CSS classes for the progress container.
    /// </summary>
    private string ContainerCssClass => ClassNames.cn(
        "bb:relative bb:h-4 bb:w-full bb:overflow-hidden bb:rounded-full bb:bg-secondary",
        Class
    );

    /// <summary>
    /// Gets the computed CSS classes for the progress indicator.
    /// </summary>
    private string IndicatorCssClass => ClassNames.cn(
        "bb:h-full bb:w-full bb:flex-1 bb:bg-primary bb:transition-all",
        IndicatorClass
    );
}
