<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- NuGet Package Configuration -->
    <PackageId>BlazorBlueprint.PdfViewer</PackageId>
    <AssemblyName>BlazorBlueprint.PdfViewer</AssemblyName>
    <RootNamespace>BlazorBlueprint.PdfViewer</RootNamespace>
    <Description>A PDF viewer for Blazor, built on PDF.js: paging, zoom, fit-to-width and download, from a URL or from bytes. An add-on to BlazorBlueprint.Components, in its own package because PDF.js is over 2 MB of script and WebAssembly.</Description>
    <PackageTags>blazor;pdf;pdf-viewer;pdfjs;document;viewer;ui;components</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://blazorblueprintui.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/blazorblueprintui/ui</RepositoryUrl>
    <Authors>Mathew Taylor</Authors>
    <Copyright>Copyright (c) 2025-present Mathew Taylor</Copyright>

    <!-- Its own tag prefix and version line, as the add-on packages have: it starts at 1.0.0. -->
    <MinVerTagPrefix>pdfviewer/v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>beta.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorBlueprint.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="MinVer" Version="5.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ProjectReference for local development, PackageReference for packing, as in Components: the
       release script sets the Components version below and passes -p:UsePackageReferences=true.
       NU5104 is suppressed for the same reason as there. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="..\BlazorBlueprint.Components\BlazorBlueprint.Components.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="BlazorBlueprint.Components" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- wwwroot ships as static web assets, not NuGet contentFiles; see Components. -->
  <ItemGroup>
    <Content Update="wwwroot\**" Pack="false" />
  </ItemGroup>

  <!-- The viewer's own stylesheet, loaded after blazorblueprint.css. Components' stylesheet only
       carries the utilities Components' own markup uses, so the viewer's cannot rely on it. -->
  <ItemGroup>
    <Content Remove="wwwroot\css\**" />
    <None Include="wwwroot\css\**" />
  </ItemGroup>

  <PropertyGroup>
    <TailwindInput>wwwroot/css/blazorblueprint-pdfviewer-input.css</TailwindInput>
    <TailwindOutput>wwwroot/blazorblueprint-pdfviewer.css</TailwindOutput>
  </PropertyGroup>

  <Import Project="..\..\tools\tailwind.targets" />
</Project>
